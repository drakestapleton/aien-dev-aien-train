const SBADB ulong 18
const SOD ulong 19
const SX0 ulong 20
const SX1 ulong 21
const SX2 ulong 22
const SX3 ulong 23
const SX4 ulong 24
const SX5 ulong 25
const SSNAP ulong 30
const SBUILD ulong 31
const SRQ ulong 32
const SMODE ulong 33
const ALL ulong 18446744073709551615
const DLT f64 0.001
const QTR f64 0.25
const BIGM f64 1000001.0
const OVER ulong 16777217
const BASEOFF ulong 8162304
text PY "/usr/bin/python3"
text SUMT "/usr/bin/sha256sum"
text BSHA "7c7b5b5260f2d9453b6076b64e7f23e88341d96498584f2dfaa229c31ad2e346"
text HEXD "0123456789abcdef"
