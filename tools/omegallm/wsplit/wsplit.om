global wsout uchar 524288
global wson ulong 1
global wsarena uchar 4194304
global wsaoff ulong 32768
global wsalen ulong 32768
global wsan ulong 2
note wsan[0] string count; wsan[1] arena byte count. String zero is empty.
global wsin uchar 524288
global wsinp ulong 2
note wsinp[0] cursor; wsinp[1] length.
global wstpls ulong 512
global wstn ulong 2
note task ids at 0..255; goal forms at 256..511.
