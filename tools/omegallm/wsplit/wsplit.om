fn wsreset to void
put wson 0 0
end
fn wsbyte c ulong to void
n = get wson 0
if ge n len wsout
exit 61
end
put wsout n uchar c
put wson 0 add n 1
end
fn wsapp s view uchar * to void
for i ulong len s
wsbyte ulong get s i
end
end
fn wsnum v ulong to void
b = new uchar 32 0
n = ulong 0
x = v
while true bound 32
put b n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
while gt n 0 bound 32
n = sub n 1
wsbyte ulong get b n
end
end
fn wsstore to ulong
id = add get wsan 0 1
n = get wson 0
o = get wsan 1
if or ge id len wsaoff gt add o n len wsarena
exit 61
end
put wsaoff id o
put wsalen id n
for i ulong n
put wsarena add o i get wsout i
end
put wsan 0 id
put wsan 1 add o n
ret id
end
fn wsstr s view uchar * to ulong
wsreset
wsapp s
ret wsstore
end
fn wsch id ulong i ulong to ulong
if ge i get wsalen id
exit 62
end
ret ulong get wsarena add get wsaoff id i
end
fn wsadds id ulong to void
for i ulong get wsalen id
wsbyte wsch id i
end
end
fn wseq id ulong s view uchar * to bool
if ne get wsalen id len s
ret false
end
for i ulong len s
if ne wsch id i ulong get s i
ret false
end
end
ret true
end
fn wscmp a ulong b ulong to long
n = get wsalen a
if lt get wsalen b n
n = get wsalen b
end
for i ulong n
x = wsch a i
y = wsch b i
if lt x y
ret -1
end
if gt x y
ret 1
end
end
ret sub long get wsalen a long get wsalen b
end
fn wsprefix id ulong pos ulong s view uchar * to bool
if gt add pos len s get wsalen id
ret false
end
for i ulong len s
if ne wsch id add pos i ulong get s i
ret false
end
end
ret true
end
fn wscontains id ulong s view uchar * to bool
for i ulong get wsalen id
if wsprefix id i s
ret true
end
end
ret false
end
fn wsdigit c ulong to bool
ret and ge c 48 le c 57
end

note CPython-compatible helpers copied from wprobe.om at 72d3377, symbols renamed.
