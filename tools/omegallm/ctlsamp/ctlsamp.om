oc uchar 125
oc uchar 10
end

note ---- arguments and main loop ----
fn argnum i long dflt long to long
if ge i argcnt
ret dflt
end
n = argread ulong i ab 0 len ab
if le n 0
ret long -1
end
v = long 0
for j ulong ulong n
c = get ab j
if not isdig c
ret long -1
end
v = add mul v 10 long sub c 48
end
ret v
end
fn argpath i long which ulong to void
n = ulong 0
if lt i argcnt
k = argread ulong i ab 0 len ab
if gt k 0
n = ulong k
end
end
if eq n 0
if eq which 0
for j ulong len dnv
put ab j get dnv j
end
n = len dnv
else
for j ulong len dups
put ab j get dups j
end
n = len dups
end
end
for j ulong n
if eq which 0
put gpth j get ab j
else
put upth j get ab j
end
end
if eq which 0
put gpl 0 n
else
put upl 0 n
end
end
fn openout i long flags int to long
n = argread ulong i ab 0 len ab
if le n 0
ret long -1
end
ret fopen ab 0 ulong n flags 420
end
fn sample seq ulong to void
t0 = monons
put rseq 0 seq
readstat
ns = realns
readload
readpsi 0 ppc
readpsi 1 ppm
readpsi 2 ppi
readtz
readmem
pkgpu
runcmd 0 0
rawlog tgpu get cl 0 1
pkups
runcmd 1 8192
rawlog tups get cl 1 2
splitups
row seq t0 ns
r = write int get ofd 0 ob 0 get op 0
savestat
end
fn main to int
na = argcnt
ival = argnum 2 5
cnt = argnum 3 360
note interval 5..86400 s (nvidia-smi read rate rule), count 0..999999 (the largest
note while bound this omc accepts; bound 1000000 is refused with error 8)
if or or lt na 2 or lt ival 5 gt ival 86400 or lt cnt 0 gt cnt 999999
k = write 2 usage 0 len usage
ret 2
end
fd = openout 1 525377
if lt fd 0
k = write 2 eopen 0 len eopen
ret 2
end
put ofd 0 fd
put rfd 0 -1
if gt na 6
rf = openout 6 525377
if lt rf 0
k = write 2 eopen 0 len eopen
ret 2
end
put rfd 0 rf
end
argpath 4 0
argpath 5 1
put rseq 0 0
readstat
savestat
iv = mul ival 1000000000
nx = add monons iv
seq = ulong 0
while lt seq ulong cnt bound 999999
left = sub nx monons
if gt left 0
r = sleepns left
end
nx = add nx iv
sample seq
seq = add seq 1
end
ret 0
end
