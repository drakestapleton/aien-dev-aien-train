fn acifid s view uchar * to ulong
if heq s q01
ret 1
end
if heq s q02
ret 2
end
if heq s q03
ret 3
end
if heq s q04
ret 4
end
if heq s q05
ret 5
end
if heq s q06
ret 6
end
if heq s q07
ret 7
end
if heq s q08
ret 8
end
if heq s q09
ret 9
end
if heq s q10
ret 10
end
if heq s q11
ret 11
end
if heq s q12
ret 12
end
if heq s q13
ret 13
end
if heq s q14
ret 14
end
if heq s q15
ret 15
end
if heq s q16
ret 16
end
if heq s q17
ret 17
end
if heq s q18
ret 18
end
if heq s q19
ret 19
end
ret 0
end

note ifrel: the IFEval relation; less is "less than" (n < k), otherwise "at least" (n >= k)
fn ifrel n ulong less bool k ulong to bool
if less
ret lt n k
end
ret ge n k
end

note ifless: whether member key of kwargs object o is "less than"
fn ifless src view uchar * tp view uint TPN o ulong key view uchar * to bool
b = new uchar 64 0
r = acstr src tp acmem src tp o key b
if lt r 1
ret false
end
ret eq get b 0 108
end

note ifstop: first index >= from holding byte ch or a newline, else len c
fn ifstop c view uchar * from ulong ch ulong to ulong
i = from
while lt i len c bound 999999
x = ulong get c i
if or eq x ch eq x 10
ret i
end
i = add i 1
end
ret len c
end

note ifhigh: the count of non-blank \*[^\n\*]*\* plus non-blank \*\*[^\n\*]*\*\* matches
fn ifhigh c view uchar * to ulong
n = len c
k = ulong 0
i = ulong 0
while lt i n bound 999999
if ne get c i 42
i = add i 1
continue
end
j = ifstop c add i 1 42
if eq acat c j 42
if not acblank view part c add i 1 sub sub j i 1
k = add k 1
end
i = add j 1
continue
end
i = add i 1
end
i = 0
while lt i n bound 999999
if and eq acat c i 42 eq acat c add i 1 42
j = ifstop c add i 2 42
if and eq acat c j 42 eq acat c add j 1 42
if not acblank view part c add i 2 sub sub j i 2
k = add k 1
end
i = add j 2
continue
end
end
i = add i 1
end
ret k
end

note ifplace: the count of \[.*?\] matches
fn ifplace c view uchar * to ulong
n = len c
k = ulong 0
i = ulong 0
while lt i n bound 999999
if eq get c i 91
j = ifstop c add i 1 93
if eq acat c j 93
k = add k 1
i = add j 1
continue
end
end
i = add i 1
end
ret k
end

note iftnon: whether c[i, j + 2).lstrip("<").rstrip(">").strip() is non-empty
fn iftnon c view uchar * i ulong j ulong to bool
a = i
e = add j 2
while and lt a e eq acat c a 60 bound 999999
a = add a 1
end
b = e
while and gt b a eq acat c sub b 1 62 bound 999999
b = sub b 1
end
ret not acblank view part c a sub b a
end

note iflast: the last j in [i + 3, e - 2] with c[j, j + 2) = ">>", else NOFENCE (greedy [^\n]+)
fn iflast c view uchar * i ulong e ulong to ulong
if lt e add i 5
ret NOFENCE
end
j = sub e 2
while ge j add i 3 bound 999999
if and eq get c j 62 eq get c add j 1 62
ret j
end
j = sub j 1
end
ret NOFENCE
end

note iftitle: some <<[^\n]+>> match whose stripped title is non-empty
fn iftitle c view uchar * to bool
n = len c
p = ulong 0
while lt p n bound 999999
i = acfind c tlt2 p false
if ge i n
ret false
end
e = acfind c knl i false
j = iflast c i e
if eq j NOFENCE
p = e
continue
end
if iftnon c i j
ret true
end
p = add j 2
end
ret false
end

note ifnextp: where findall resumes after a match ending at e
fn ifnextp c view uchar * e ulong to ulong
if eq e 0
ret 1
end
if eq get c sub e 1 10
ret e
end
ret add e 1
end

note ifbulat: at line start p, the index after a bullet head (\s* then * and a non-* byte, or \s* then -), else NOFENCE
fn ifbulat c view uchar * p ulong dash bool to ulong
q = p
while lt q len c bound 999999
w = acwsat c q
if eq w 0
break
end
q = add q w
end
if dash
if eq acat c q 45
ret add q 1
end
ret NOFENCE
end
if and eq acat c q 42 lt add q 1 len c
if ne get c add q 1 42
ret add q 2
end
end
ret NOFENCE
end

note ifbul1: matches of ^\s*\*[^\*].*$ (dash false) or ^\s*-.*$ (dash true), re.MULTILINE
fn ifbul1 c view uchar * dash bool to ulong
n = len c
k = ulong 0
p = ulong 0
while lt p n bound 999999
st = ifbulat c p dash
if ne st NOFENCE
k = add k 1
e = acfind c knl st false
if ge e n
break
end
p = ifnextp c e
continue
end
e = acfind c knl p false
if ge e n
break
end
p = add e 1
end
ret k
end

note ifpara: re.split(r"\s?\*\*\*\s?") paragraphs, blank first/last dropped, blank middle fails
fn ifpara c view uchar * want ulong to bool
n = len c
p = ulong 0
idx = ulong 0
drop = ulong 0
while le p n bound 999999
i = acfind c t3s p false
if ge i n
break
end
ms = i
w = ifwsend c p i
ms = sub i w
if acblank view part c p sub ms p
if ne idx 0
ret false
end
drop = add drop 1
end
idx = add idx 1
p = add i 3
p = add p acwsat c p
end
if acblank view part c p sub n p
drop = add drop 1
end
ret eq sub add idx 1 drop want
end

note ifwsend: byte length of a whitespace code point in c[p, i) that ends exactly at i, else 0
fn ifwsend c view uchar * p ulong i ulong to ulong
if le i p
ret 0
end
q = sub i 1
while and gt q p eq and acat c q 192 128 bound 8
q = sub q 1
end
x = acu8 c q
if and eq add q and x 7 i acisws shr x 3
ret and x 7
end
ret 0
end

note acmeq: c[a1, b1) = c[a2, b2)
fn acmeq c view uchar * a1 ulong b1 ulong a2 ulong b2 ulong to bool
if ne sub b1 a1 sub b2 a2
ret false
end
for i ulong sub b1 a1
if ne get c add a1 i get c add a2 i
ret false
end
end
ret true
end

note ifseg: the stripped bounds of c[p, e) as absolute start shl 32 | end
fn ifseg c view uchar * p ulong e ulong to ulong
x = acstrip view part c p sub e p
ret or shl add p acsa x 32 add p acsb x
end

note iftwo: value.split("******"): blank middle fails; exactly two non-blank parts that differ stripped
fn iftwo c view uchar * to bool
p = ulong 0
cnt = ulong 0
x1 = ulong 0
x2 = ulong 0
while le p len c bound 999999
i = acfind c t6s p false
last = ge i len c
x = ifseg c p i
if eq acsa x acsb x
if and ne p 0 not last
ret false
end
else
if eq cnt 0
x1 = x
end
if eq cnt 1
x2 = x
end
cnt = add cnt 1
end
if last
break
end
p = add i 6
end
if ne cnt 2
ret false
end
ret not acmeq c acsa x1 acsb x1 acsa x2 acsb x2
end

fn acdig c view uchar * q ulong to bool
d = acat c q
ret and ge d 48 le d 57
end

note ifsecat: after a splitter ending at q, the end of \s?\d+ or NOFENCE
fn ifsecat c view uchar * q ulong to ulong
e = add q acwsat c q
if not acdig c e
ret NOFENCE
end
while acdig c e bound 999999
e = add e 1
end
ret e
end

note ifsec: matches of \s?SPLIT\s?\d+\s? (case-sensitive), at least want
fn ifsec c view uchar * sp view uchar * want ulong to bool
k = ulong 0
p = ulong 0
while lt p len c bound 999999
i = acfind c sp p false
if ge i len c
break
end
q = ifsecat c add i len sp
if eq q NOFENCE
p = add i 1
else
k = add k 1
p = q
end
end
ret ge k want
end

note ifpsat: postscript pattern at i of lowercased c: kind 1 p\.\s?p\.\s?s, kind 2 p\.\s?s\.
fn ifpsat c view uchar * i ulong kind ulong to bool
q = i
if or ne hlow uchar acat c q 112 ne acat c add q 1 46
ret false
end
q = add q 2
q = add q acwsat c q
if eq kind 1
if or ne hlow uchar acat c q 112 ne acat c add q 1 46
ret false
end
q = add q 2
q = add q acwsat c q
ret eq hlow uchar acat c q 115
end
if ne hlow uchar acat c q 115
ret false
end
ret eq acat c add q 1 46
end

fn ifps c view uchar * mk view uchar * to bool
kind = ulong 0
if heq mk kpps
kind = 1
end
if heq mk kps
kind = 2
end
if eq kind 0
ret lt acfind c mk 0 true len c
end
for i ulong len c
if ifpsat c i kind
ret true
end
end
ret false
end

note ifjsp: removeprefix of t at [a, b) of c
fn ifjsp c view uchar * a ulong b ulong t view uchar * to ulong
if lt sub b a len t
ret a
end
if acmat c a t false
ret add a len t
end
ret a
end

note ifjson: value.strip() minus ```json/```Json/```JSON/``` prefixes and a ``` suffix, stripped, parses as JSON
fn ifjson c view uchar * to bool
tp = new uint TPN 0
x = acstrip c
a = acsa x
b = acsb x
a = ifjsp c a b jp1
a = ifjsp c a b jp2
a = ifjsp c a b jp3
a = ifjsp c a b kfence
if ge sub b a 3
if acmat c sub b 3 kfence false
b = sub b 3
end
end
y = acstrip view part c a sub b a
b = add a acsb y
a = add a acsa y
if eq a b
ret false
end
r = js_init tp 983040 64
r = js_parse view part c a sub b a tp sub b a
ret ge r 0
end

note iflet: occurrences of ASCII letter l in lowercased c
fn iflet c view uchar * l ulong to ulong
k = ulong 0
for i ulong len c
if eq ulong hlow get c i l
k = add k 1
end
end
ret k
end

note ifend: value.strip().lower().endswith(t.strip().lower())
fn ifend c view uchar * t view uchar * to bool
x = acstrip c
y = acstrip t
ret acsfx view part c acsa x sub acsb x acsa x view part t acsa y sub acsb y acsa y true
end

fn ifstart c view uchar * t view uchar * to bool
x = acstrip c
y = acstrip t
ret acpfx view part c acsa x sub acsb x acsa x view part t acsa y sub acsb y acsa y true
end

note ifcon: one of the three constrained answers occurs in value.strip()
fn ifcon c view uchar * to bool
n = len c
if lt acfind c cyes 0 false n
ret true
end
if lt acfind c cno 0 false n
ret true
end
ret lt acfind c cmay 0 false n
end

fn ifquote c view uchar * to bool
x = acstrip c
a = acsa x
b = acsb x
if lt sub b a 2
ret false
end
ret and eq get c a 34 eq get c sub b 1 34
end

fn ifcomma c view uchar * to bool
for i ulong len c
if eq get c i 44
ret false
end
end
ret true
end

note ifw1: one keyword w holds: forb true, re.search(\bw\b, IGNORECASE) fails; forb false, re.search(w, IGNORECASE) holds
fn ifw1 c view uchar * w view uchar * forb bool to bool
if forb
ret not acwhole c w true
end
ret lt acfind c w 0 true len c
end

note ifwordl: every word of the forbidden_words (forb) or keywords list holds ifw1
fn ifwordl c view uchar * it view uchar ILN tp view uint TPN kw ulong forb bool to bool
b = new uchar 4096 0
l = acmem it tp kw wkeys
if forb
l = acmem it tp kw wforb
end
e = acel tp l 0
while ne e jsnone bound 999999
r = acstr it tp e b
if lt r 0
ret false
end
if not ifw1 c view part b 0 ulong r forb
ret false
end
e = acnext tp e
end
ret true
end

note acif1: instruction code on response c with kwargs object kw of item it
fn acif1 code ulong c view uchar * it view uchar ILN tp view uint TPN kw ulong to bool
b = new uchar 65536 0
if eq code 1
ret ifcomma c
end
if eq code 2
ret ifrel acwords c ifless it tp kw wrel ackn it tp kw wnumw
end
if eq code 3
ret ifwordl c it tp kw true
end
if eq code 4
ret ifwordl c it tp kw false
end
if eq code 5
r = acstr it tp acmem it tp kw wkey b
if lt r 1
ret false
end
ret ifrel acnoc c view part b 0 ulong r true ifless it tp kw wrel ackn it tp kw wfreq
end
if eq code 6
ret ge ifhigh c ackn it tp kw wnumh
end
if eq code 7
ret ifquote c
end
if eq code 8
ret iftitle c
end
if eq code 9
ret eq add ifbul1 c false ifbul1 c true ackn it tp kw wnumb
end
if eq code 10
r = acstr it tp acmem it tp kw wendp b
if lt r 0
ret false
end
ret ifend c view part b 0 ulong r
end
if eq code 11
r = acstr it tp acmem it tp kw wpsm b
if lt r 1
ret false
end
x = acstrip view part b 0 ulong r
ret ifps c view part b acsa x sub acsb x acsa x
end
if eq code 12
ret ge ifplace c ackn it tp kw wnumph
end
if eq code 13
ret ifpara c ackn it tp kw wnump
end
if eq code 14
ret ifjson c
end
if eq code 15
r = acstr it tp acmem it tp kw wsplit b
if lt r 1
ret false
end
x = acstrip view part b 0 ulong r
ret ifsec c view part b acsa x sub acsb x acsa x ackn it tp kw wnums
end
if eq code 16
r = acstr it tp acmem it tp kw wlet b
if ne r 1
ret false
end
ret ifrel iflet c ulong hlow get b 0 ifless it tp kw wletr ackn it tp kw wletf
end
if eq code 17
r = acstr it tp acmem it tp kw wptr b
if lt r 0
ret false
end
ret ifstart c view part b 0 ulong r
end
if eq code 18
ret iftwo c
end
if eq code 19
x = acstrip c
ret ifcon view part c acsa x sub acsb x acsa x
end
ret false
end

note acifltr: whether kwargs kw name one ASCII letter; upstream build_description swaps any other
note letter for a random one, so such letter_frequency rows have no fixed verdict and are not registered
fn acifltr it view uchar ILN tp view uint TPN kw ulong to bool
b = new uchar 16 0
r = acstr it tp acmem it tp kw wlet b
if ne r 1
ret false
end
c = hlow get b 0
ret and ge c 97 le c 122
end

note acifsup: whether every instruction of IFEval row it is supported (the registered subset)
fn acifsup it view uchar ILN tp view uint TPN to bool
b = new uchar 256 0
l = acmem it tp 0 kiids
e = acel tp l 0
k = acel tp acmem it tp 0 kkw 0
if eq e jsnone
ret false
end
for i ulong js_nkids tp l
if eq e jsnone
break
end
r = acstr it tp e b
if lt r 1
ret false
end
c = acifid view part b 0 ulong r
if eq c 0
ret false
end
if and eq c 16 not acifltr it tp k
ret false
end
e = acnext tp e
k = acnext tp k
end
ret true
end

note acifrow: 0 when the response c passes the row strictly, else 1 + the failing instruction index (1 for a blank response)
fn acifrow c view uchar * it view uchar ILN tp view uint TPN to ulong
b = new uchar 256 0
if acblank c
ret 1
end
e = acel tp acmem it tp 0 kiids 0
k = acel tp acmem it tp 0 kkw 0
i = ulong 1
while ne e jsnone bound 999999
r = acstr it tp e b
if lt r 0
ret i
end
if not acif1 acifid view part b 0 ulong r c it tp k
ret i
end
e = acnext tp e
k = acnext tp k
i = add i 1
end
ret 0
end

note ======== request bodies (PREREG.md section 2)


note acbhd: {"model":M,"temperature":0,"max_tokens":N,stream flags,"messages":[
fn acbhd rq edit uchar RQN wk view uchar WKN sv view ulong SVN to ulong
q = acapp rq 0 kmodel
q = acapp rq q view part wk WMO get sv SMOL
q = acapp rq q ktemp
q = acmilli rq q get sv STEMP
q = acapp rq q kseed
q = acdec rq q get sv SSEED
q = acapp rq q kmaxt
q = acdec rq q get sv SMAX
if ne get sv SSTRM 0
q = acapp rq q kstrm
else
q = acapp rq q knostrm
end
ret acapp rq q kmsgs
end

note acmilli: v / 1000 as a JSON number (0, 1, 0.8, 0.125: no exponent, no trailing zeros) at o[p..]
fn acmilli o edit uchar * p ulong v ulong to ulong
q = acdec o p div v 1000
f = rem v 1000
if eq f 0
ret q
end
q = acapp o q kdot
d = ulong 100
for i ulong 3
if eq f 0
break
end
q = acdec o q div f d
f = rem f d
d = div d 10
end
ret q
end

note acsep: a comma unless rq[q - 1] opens the array
fn acsep rq edit uchar RQN q ulong to ulong
if or eq q 0 gt q len rq
ret q
end
if eq get rq sub q 1 91
ret q
end
ret acapp rq q kcomma
end

note acbsys: the system message from WSY when the item names one
fn acbsys rq edit uchar RQN q ulong wk view uchar WKN sv view ulong SVN to ulong
if eq get sv SSYL 0
ret q
end
r = acapp rq q ksys
r = acesc rq r view part wk WSY get sv SSYL
ret acapp rq r kendo
end

note acbmsg: the item's msgs elements copied verbatim
fn acbmsg rq edit uchar RQN q ulong it view uchar ILN tp view uint TPN to ulong
e = acel tp acmem it tp 0 kmsgsk 0
r = q
while ne e jsnone bound 999999
r = acsep rq r
r = acapp rq r view part it js_off tp e js_span tp e
e = acnext tp e
end
ret r
end

note acword: one filler word for LCG state s at rq[p, e): 2..8 letters, sometimes ". ", then a space
fn acword rq edit uchar RQN p ulong e ulong s ulong to ulong
q = p
w = add 2 rem shr s 33 7
for j ulong w
if lt q e
h = shr s add 8 mul j 3
put rq q uchar add 97 rem h 26
q = add q 1
end
end
if and eq rem shr s 20 12 0 lt add q 1 e
put rq q 46
q = add q 1
end
if lt q e
put rq q 32
q = add q 1
end
ret q
end

note acfill: n filler bytes of words from the LCG s' = s 6364136223846793005 + 1442695040888963407 seeded with x
fn acfill rq edit uchar RQN q ulong n ulong x ulong to ulong
e = add q n
if gt e len rq
ret add len rq 1
end
p = q
s = x
while lt p e bound 999999
s = add mul s 6364136223846793005 1442695040888963407
p = acword rq p e s
end
ret e
end

note acbpad: the long-context user message: filler, the needle at bytes * at / 1000, filler, blank line, question
fn acbpad rq edit uchar RQN q ulong it view uchar ILN tp view uint TPN to ulong
b = new uchar 4096 0
pd = acmem it tp 0 kpad
if eq pd jsnone
ret q
end
n = ackn it tp pd kbytes
ps = div mul n ackn it tp pd kat 1000
r = acsep rq q
r = acapp rq r kuser
r = acapp rq r kq
r = acfill rq r ps xor 11400714819323198485 ps
k = acstr it tp acmem it tp pd kneedle b
if lt k 0
ret add len rq 1
end
r = acesc rq r view part b 0 ulong k
m = ulong 0
if lt add ps ulong k n
m = sub sub n ps ulong k
end
r = acfill rq r m add ps 1
r = acapp rq r kpadnl
k = acstr it tp acmem it tp pd kqk b
if lt k 0
ret add len rq 1
end
r = acesc rq r view part b 0 ulong k
ret acapp rq r kendo
end

note acbtool: ,"tools":T for the named tool set
fn acbtool rq edit uchar RQN q ulong wk view uchar WKN sv view ulong SVN to ulong
k = get sv SWHY
if eq k 0
ret q
end
o = add WT0 mul sub k 1 32768
r = acapp rq q ktools
ret acapp rq r view part wk o get sv add ST0L sub k 1
end

note acbif: one user message holding the IFEval prompt (already a JSON string)
fn acbif rq edit uchar RQN q ulong it view uchar ILN tp view uint TPN to ulong
t = acmem it tp 0 kprompt
r = acapp rq q kuser
r = acapp rq r view part it js_off tp t js_span tp t
ret acapp rq r kendm
end

note acbhe: one user message asking for the HumanEval function in a python fence
fn acbhe rq edit uchar RQN q ulong it view uchar ILN tp view uint TPN to ulong
b = new uchar 65536 0
k = acstr it tp acmem it tp 0 kprompt b
if lt k 0
ret add len rq 1
end
r = acapp rq q kuser
r = acapp rq r khepre
r = acesc rq r view part b 0 ulong k
ret acapp rq r khesuf
end

note acbuild: the chat request body for the item; its length (> RQN when it does not fit)
note sv[SKIND] 0 chat item, 1 IFEval row, 2 HumanEval row; sv[SWHY] tool set 0 none, 1 hermes, 2 opencode, 3 fn
fn acbuild rq edit uchar RQN it view uchar ILN tp view uint TPN wk view uchar WKN sv view ulong SVN to ulong
q = acbhd rq wk sv
k = get sv SKIND
if eq k 1
q = acbif rq q it tp
end
if eq k 2
q = acbhe rq q it tp
end
if eq k 0
q = acbsys rq q wk sv
q = acbmsg rq q it tp
q = acbpad rq q it tp
end
q = acapp rq q kclose
q = acbtool rq q wk sv
ret acapp rq q kendm
end

note ======== exchange: one POST, the reply captured into sv and rs (PREREG.md section 2)

note acxsend: dial sv[SIP]:sv[SPORT], POST rq[0, sv[SBL]) to /v1/chat/completions; the status
fn acxsend rq view uchar RQN wk view uchar WKN sv view ulong SVN cs edit ulong 320 io edit uchar 131072 to long
a = new uchar 16 0
r = haddr4 a uint get sv SIP get sv SPORT
fd = hdial a 30000000000
if lt fd 0
ret fd
end
r = hinit cs io int fd 0
hsettmo cs 1800000000000 1800000000000
hsetbdl cs 3600000000000
put cs HBCAP 16777216
r = hreqst cs io kpost
r = hfe r hreqtg cs io kpchat
r = hfe r hhname cs io khost
r = hfe r hhval cs io kloc
r = hfe r hhname cs io kctype
r = hfe r hhval cs io kjson
r = hfe r hhname cs io kxitem
r = hfe r hhval cs io view part wk WID get sv SIDL
r = hfe r hhend cs io 0 get sv SBL
r = hfe r hput cs io view part rq 0 get sv SBL
r = hfe r hwfin cs io
if lt r 0
ret r
end
ret hrsprd cs io
end

note acissse: whether the reply's content-type names event-stream
fn acissse cs edit ulong 320 io edit uchar 131072 to bool
i = hhfind cs io kctl
if lt i 0
ret false
end
o = hhvoff cs ulong i
l = hhvlen cs ulong i
ret lt acfind view part io o l kevst 0 true l
end

note acaddc: append string token t to the content rs[0, sv[SCL])
fn acaddc src view uchar * tp view uint TPN t ulong sv edit ulong SVN rs edit uchar RSN to void
if ne actype tp t jsstr
ret
end
q = get sv SCL
r = js_sget src js_off tp t part rs q sub CTN q
if lt r 0
put sv SERR 1
ret
end
put sv SCL add q ulong r
end

note acaddk: append string token t to the call slot sv[SOP] (SNL + k name, SAL + k arguments)
fn acaddk src view uchar * tp view uint TPN t ulong sv edit ulong SVN rs edit uchar RSN to void
if ne actype tp t jsstr
ret
end
s = get sv SOP
b = add RCL mul sub s SAL CLAS
c = CLAS
if lt s SAL
b = add add RCL CLNM mul sub s SNL CLNS
c = CLNS
end
q = get sv s
r = js_sget src js_off tp t part rs add b q sub c q
if lt r 0
put sv SERR 2
ret
end
put sv s add q ulong r
end

note accall: one tool call object c, at its index member or else ordinal sv[SWHV]
fn accall src view uchar * tp view uint TPN c ulong sv edit ulong SVN rs edit uchar RSN to void
k = get sv SWHV
x = acmem src tp c kindex
if eq actype tp x jsnum
k = acnum src tp x
end
if ge k 4
put sv SERR 4
ret
end
if ge k get sv SNC
put sv SNC add k 1
end
f = acmem src tp c kfunc
put sv SOP add SNL k
acaddk src tp acmem src tp f kname sv rs
put sv SOP add SAL k
acaddk src tp acmem src tp f kargs sv rs
end

note acfcode: 1 stop, 2 length, 3 tool_calls, 4 other
fn acfcode v view uchar * to ulong
if heq v kstop
ret 1
end
if heq v klength
ret 2
end
if heq v ktoolc
ret 3
end
ret 4
end

note acfin: finish_reason into sv[SFIN] (bit 256, the [DONE] mark, is kept)
fn acfin src view uchar * tp view uint TPN t ulong sv edit ulong SVN to void
b = new uchar 64 0
r = acstr src tp t b
if lt r 0
ret
end
k = acfcode view part b 0 ulong r
put sv SFIN or and get sv SFIN 256 k
end

fn acchoice src view uchar * tp view uint TPN ch ulong sv edit ulong SVN rs edit uchar RSN to void
m = acmem src tp ch kmessage
if ne get sv SSTRM 0
m = acmem src tp ch kdelta
end
acaddc src tp acmem src tp m kcontent sv rs
e = acel tp acmem src tp m ktoolc 0
i = ulong 0
while ne e jsnone bound 999999
put sv SWHV i
accall src tp e sv rs
e = acnext tp e
i = add i 1
end
acfin src tp acmem src tp ch kfinish sv
end

note acresp: one reply object (a whole body or one stream chunk)
fn acresp src view uchar * tp view uint TPN sv edit ulong SVN rs edit uchar RSN to void
ch = acel tp acmem src tp 0 kchoice 0
if ne ch jsnone
acchoice src tp ch sv rs
end
x = acmem src tp acmem src tp 0 kusage kctok
if eq actype tp x jsnum
put sv SCTOK add 1 acnum src tp x
end
x = acmem src tp acmem src tp 0 kusage kptok
if eq actype tp x jsnum
put sv SPTOK add 1 acnum src tp x
end
end

note acsse: one data payload; 1 for [DONE]
fn acsse v view uchar * sv edit ulong SVN rs edit uchar RSN to ulong
tp = new uint TPN 0
if heq v kdone
put sv SFIN or get sv SFIN 256
ret 1
end
r = js_init tp 983040 64
r = js_parse v tp len v
if lt r 0
put sv SERR 3
ret 0
end
acresp v tp sv rs
ret 0
end

note acfeed: feed d to the event reader; each complete event goes to acsse
fn acfeed d view uchar * ss edit ulong 16 lb edit uchar 65664 sv edit ulong SVN rs edit uchar RSN to long
p = ulong 0
while lt p len d bound 999999
c = hssefeed ss lb view part d p sub len d p
if lt c 0
ret c
end
p = add p ulong c
if eq get ss HSRDY 1
x = acsse view part lb HSDB get ss HSDLEN sv rs
hssenext ss
end
end
ret 0
end

fn acrdsse cs edit ulong 320 io edit uchar 131072 sv edit ulong SVN rs edit uchar RSN to long
d = new uchar 16384 0
lb = new uchar 65664 0
ss = new ulong 16 0
r = hsseinit ss
for it ulong 16777216
n = hbodyrd cs io d
if le n 0
ret n
end
r = acfeed view part d 0 ulong n ss lb sv rs
if lt r 0
ret r
end
end
ret 0
end

fn acrdnon cs edit ulong 320 io edit uchar 131072 sv edit ulong SVN rs edit uchar RSN to long
rb = new uchar RBN 0
tp = new uint TPN 0
n = hbodyall cs io rb
if lt n 0
ret n
end
if ne get sv SST 200
if lt acfind view part rb 0 ulong n kctxx 0 false ulong n
put sv SCTX 1
end
end
r = js_init tp 983040 64
r = js_parse view part rb 0 ulong n tp ulong n
if lt r 0
put sv SERR 3
ret 0
end
acresp view part rb 0 ulong n tp sv rs
ret 0
end

note acexch: send the chat request rq[0, sv[SBL]) and capture the reply; sv[SST] status (0 when unreachable)
fn acexch rq view uchar RQN wk view uchar WKN sv edit ulong SVN rs edit uchar RSN to void
cs = new ulong 320 0
io = new uchar 131072 0
for i ulong 9
put sv add SNC i 0
end
put sv SCL 0
put sv SFIN 0
put sv SCTOK 0
put sv SPTOK 0
put sv SCTX 0
put sv SERR 0
st = acxsend rq wk sv cs io
if lt st 0
put sv SST 0
put sv SERR 5
ret
end
put sv SST ulong st
r = long 0
if acissse cs io
r = acrdsse cs io sv rs
else
r = acrdnon cs io sv rs
end
if lt r 0
put sv SERR 6
end
r = hclose cs
end

note ======== code fences

note acfenceat: the index after ``` when the line starting at p opens with optional spaces and ```, else NOFENCE
fn acfenceat s view uchar * p ulong to ulong
q = p
while eq acat s q 32 bound 999999
q = add q 1
end
if le add q 3 len s
if acmat s q kfence false
ret add q 3
end
end
ret NOFENCE
end

note acfclose: the start of the first fence line at or after line start q, else NOFENCE
fn acfclose s view uchar * q ulong to ulong
p = q
while le p len s bound 999999
if ne acfenceat s p NOFENCE
ret p
end
e = acfind s knl p false
if ge e len s
ret NOFENCE
end
p = add e 1
end
ret NOFENCE
end

note acftag: whether the first word of info line v is tag (ASCII case-folded); an empty tag matches any fence
fn acftag v view uchar * tag view uchar * to bool
if eq len tag 0
ret true
end
x = acstrip v
w = acsa x
while and lt w acsb x eq acwsat v w 0 bound 999999
w = add w 1
end
ret hieq view part v acsa x sub w acsa x tag
end

fn acfs x ulong to ulong
ret and shr x 32 2147483647
end

note acfence: the first fence whose info word is tag: bit 63 (closed) | content start shl 32 | content end; else NOFENCE
fn acfence s view uchar * tag view uchar * to ulong
p = ulong 0
while lt p len s bound 999999
x = acfenceat s p
e = acfind s knl p false
if ne x NOFENCE
st = add e 1
if gt st len s
st = len s
end
c = acfclose s st
if acftag view part s x sub e x tag
if eq c NOFENCE
ret or shl st 32 len s
end
ret or or shl ulong 1 63 shl st 32 c
end
if eq c NOFENCE
ret NOFENCE
end
e = acfind s knl c false
end
p = add e 1
end
ret NOFENCE
end

note acfcode2: the code to run: the first fence tagged t1, else t2, else the whole content, as start shl 32 | end
fn acfcode2 s view uchar * t1 view uchar * t2 view uchar * to ulong
x = acfence s t1
if eq x NOFENCE
x = acfence s t2
end
if eq x NOFENCE
ret len s
end
ret or shl acfs x 32 acsb x
end

note ======== rules (PREREG.md section 3)

text oexpy "python"

fn acopc s view uchar * to ulong
if heq s ohas
ret 1
end
if heq s ohasi
ret 2
end
if heq s oany
ret 3
end
if heq s onot
ret 4
end
if heq s onoti
ret 5
end
if heq s ocount
ret 6
end
if heq s owords
ret 7
end
if heq s ofence
ret 8
end
if heq s ostart
ret 9
end
if heq s oend
ret 10
end
ret acopc2 s
end

fn acopc2 s view uchar * to ulong
if heq s ojson
ret 11
end
if heq s obytes
ret 12
end
if heq s ofin
ret 13
end
if heq s octok
ret 14
end
if heq s ocall
ret 20
end
if heq s ocalls
ret 21
end
if heq s onocall
ret 22
end
if heq s oarg
ret 23
end
if heq s oargi
ret 24
end
if heq s oargk
ret 25
end
if heq s oexec
ret 30
end
if heq s oline
ret 15
end
if heq s oexact
ret 16
end
ret 0
end

note acoppos: whether op is a positive check (absence checks cannot carry an item alone)
fn acoppos op ulong to bool
ret and and ne op 4 ne op 5 and ne op 22 ne op 0
end

fn acrarg it view uchar ILN tp view uint TPN r ulong i ulong b edit uchar * to long
ret acstr it tp acel tp r i b
end

fn acrn it view uchar ILN tp view uint TPN r ulong i ulong to ulong
ret acnum it tp acel tp r i
end

fn acin v ulong lo ulong hi ulong to bool
ret and ge v lo le v hi
end

note acrs: string ops on content c with argument s
fn acrs op ulong c view uchar * s view uchar * to bool
if eq op 1
ret lt acfind c s 0 false len c
end
if eq op 2
ret lt acfind c s 0 true len c
end
if eq op 4
ret ge acfind c s 0 false len c
end
if eq op 5
ret ge acfind c s 0 true len c
end
if eq op 15
ret acgline c s
end
if eq op 16
ret acgexact c s
end
if eq op 8
x = acfence c s
if eq x NOFENCE
ret false
end
ret ne shr x 63 0
end
y = acstrip c
if eq op 9
ret acpfx view part c acsa y sub acsb y acsa y s false
end
if eq op 10
ret acsfx view part c acsa y sub acsb y acsa y s false
end
ret false
end

note acgm1: whether pattern byte(s) at p[j] match byte c: \\ escapes the next byte, # one ASCII digit; the
note pattern width consumed (1 or 2), 0 when they do not match
fn acgm1 p view uchar * j ulong c ulong to ulong
x = acat p j
if and eq x 92 lt add j 1 len p
if eq acat p add j 1 c
ret 2
end
ret 0
end
if eq x 35
if and ge c 48 le c 57
ret 1
end
ret 0
end
if eq x c
ret 1
end
ret 0
end

note acglob: whether all of s matches pattern p: * any run of bytes, # one ASCII digit, \\ the next byte literal
note (iterative backtracking to the last *; every pass advances i or the star mark, so 2 (len s + 1)^2 passes
note bound it: a subject over 600 bytes never matches, which keeps that under the loop bound 999999)
fn acglob s view uchar * p view uchar * to bool
if eq ACMUT 1
ret true
end
if gt len s 600
ret false
end
i = ulong 0
j = ulong 0
st = NOFENCE
mk = ulong 0
n = len s
m = len p
while lt i n bound 999999
if eq acat p j 42
st = j
mk = i
j = add j 1
continue
end
w = ulong 0
if lt j m
w = acgm1 p j ulong get s i
end
if gt w 0
i = add i 1
j = add j w
continue
end
if ne st NOFENCE
j = add st 1
mk = add mk 1
i = mk
continue
end
ret false
end
while eq acat p j 42 bound 999999
j = add j 1
end
ret eq j m
end

note acgline: some line of c, stripped, matches pattern p (op line)
fn acgline c view uchar * p view uchar * to bool
a = ulong 0
while le a len c bound 999999
e = acfind c knl a false
if gt e len c
e = len c
end
x = acstrip view part c a sub e a
if acglob view part c add a acsa x sub acsb x acsa x p
ret true
end
a = add e 1
end
ret false
end

note acgexact: the whole reply (the first fenced block when there is one), stripped, is one line matching p (op exact)
fn acgexact c view uchar * p view uchar * to bool
a = ulong 0
b = len c
x = acfence c part kfence 0 0
if ne x NOFENCE
a = acfs x
b = acsb x
end
y = acstrip view part c a sub b a
s0 = add a acsa y
s1 = add a acsb y
if lt acfind view part c s0 sub s1 s0 knl 0 false sub s1 s0
ret false
end
ret acglob view part c s0 sub s1 s0 p
end

note acclob1: whether the name nm occurrence at i in c is the target of a single > redirection (truncation):
note walking back over path bytes and spaces reaches a > that does not follow another >
fn acclob1 c view uchar * i ulong to bool
j = i
while gt j 0 bound 999999
if acpathb get c sub j 1
j = sub j 1
else
break
end
end
while gt j 0 bound 999999
d = get c sub j 1
if ne d 32
break
end
j = sub j 1
end
if gt j 0
d = get c sub j 1
if or eq d 34 eq d 39
j = sub j 1
end
end
while gt j 0 bound 999999
if ne get c sub j 1 32
break
end
j = sub j 1
end
if lt j 1
ret false
end
if ne get c sub j 1 62
ret false
end
if lt j 2
ret true
end
ret ne get c sub j 2 62
end

note acpathb: whether byte d may be part of a redirection target path (not whitespace, >, or a quote)
fn acpathb d uchar to bool
if or or eq d 32 eq d 9 eq d 10
ret false
end
ret not or or eq d 62 eq d 34 eq d 39
end

note acclob: some occurrence of nm in c is truncated by a single >
fn acclob c view uchar * nm view uchar * to bool
p = ulong 0
while lt p len c bound 999999
i = acfind c nm p false
if ge i len c
ret false
end
if acclob1 c i
ret true
end
p = add i 1
end
ret false
end

note accrit1: c holds a critical pattern: a line of critical.txt, or a truncating > onto BOARD.md / CLAIMS.md
fn accrit1 c view uchar * wk view uchar WKN sv view ulong SVN to bool
if eq ACMUT 3
ret false
end
if acclob c kboard
ret true
end
if acclob c kclaims
ret true
end
n = get sv SCRL
a = ulong 0
while lt a n bound 999999
e = acfind view part wk WCR n knl a false
if gt e n
e = n
end
if gt e a
if lt acfind c view part wk add WCR a sub e a 0 false len c
ret true
end
end
a = add e 1
end
ret false
end

note accrit: the reply (content and every call's arguments) holds a critical pattern
fn accrit wk view uchar WKN sv view ulong SVN rs view uchar RSN to bool
if accrit1 view part rs 0 get sv SCL wk sv
ret true
end
for k ulong get sv SNC
o = add RCL mul k CLAS
if accrit1 view part rs o get sv add SAL k wk sv
ret true
end
end
ret false
end

note acrany: some listed string (elements 1..) occurs case-folded in c
fn acrany c view uchar * it view uchar ILN tp view uint TPN r ulong to bool
b = new uchar 4096 0
e = acnext tp acel tp r 0
while ne e jsnone bound 999999
k = acstr it tp e b
if gt k 0
if lt acfind c view part b 0 ulong k 0 true len c
ret true
end
end
e = acnext tp e
end
ret false
end

note acrc: content rules 1..14 against rs[0, sv[SCL])
fn acrc op ulong it view uchar ILN tp view uint TPN r ulong sv view ulong SVN rs view uchar RSN to bool
b = new uchar 4096 0
n = get sv SCL
if eq op 3
ret acrany view part rs 0 n it tp r
end
if eq op 6
k = acrarg it tp r 1 b
if lt k 1
ret false
end
ret acin acnoc view part rs 0 n view part b 0 ulong k true acrn it tp r 2 acrn it tp r 3
end
if eq op 7
ret acin acwords view part rs 0 n acrn it tp r 1 acrn it tp r 2
end
if eq op 11
ret ifjson view part rs 0 n
end
if eq op 12
ret acin n acrn it tp r 1 acrn it tp r 2
end
if eq op 13
k = acrarg it tp r 1 b
if lt k 1
ret false
end
ret eq and get sv SFIN 255 acfcode view part b 0 ulong k
end
if eq op 14
if eq get sv SCTOK 0
ret false
end
ret acin sub get sv SCTOK 1 acrn it tp r 1 acrn it tp r 2
end
k = acrarg it tp r 1 b
if lt k 0
ret false
end
ret acrs op view part rs 0 n view part b 0 ulong k
end

note acargval: member key of the JSON object src: a string decoded, any other value as its raw text, into v;
note its length, -1 when absent, -2 when src is not JSON
fn acargval src view uchar * key view uchar * v edit uchar 65536 to long
ta = new uint TPN 0
x = js_init ta 983040 64
x = js_parse src ta len src
if lt x 0
ret -2
end
t = acmem src ta 0 key
if eq t jsnone
ret -1
end
if eq actype ta t jsstr
ret acstr src ta t v
end
o = js_off ta t
l = js_span ta t
if gt l 65536
ret -2
end
for i ulong l
put v i get src add o i
end
ret long l
end

note acargk: acargval on the arguments of call sv[SOP]
fn acargk rs view uchar RSN sv view ulong SVN key view uchar * v edit uchar 65536 to long
k = get sv SOP
o = add RCL mul k CLAS
ret acargval view part rs o get sv add SAL k key v
end

note acarg: call sv[SOP] against rule r: argk key present, arg value equals, argi value contains (folded)
fn acarg rs view uchar RSN sv view ulong SVN it view uchar ILN tp view uint TPN r ulong to bool
b = new uchar 4096 0
v = new uchar 65536 0
kl = acrarg it tp r 2 b
if lt kl 0
ret false
end
l = acargk rs sv view part b 0 ulong kl v
if lt l 0
ret false
end
if eq get sv SWHV 25
ret true
end
ret acargv sv it tp r view part v 0 ulong l
end

note acargv: arg (23) value v equals rule element 3, argi (24) contains it (folded)
fn acargv sv view ulong SVN it view uchar ILN tp view uint TPN r ulong v view uchar * to bool
b = new uchar 4096 0
el = acrarg it tp r 3 b
if lt el 0
ret false
end
if eq get sv SWHV 23
ret heq v view part b 0 ulong el
end
ret lt acfind v view part b 0 ulong el 0 true len v
end

fn accname rs view uchar RSN sv view ulong SVN k ulong s view uchar * to bool
o = add add RCL CLNM mul k CLNS
ret heq view part rs o get sv add SNL k s
end

note acrcl: call rules 20..25
fn acrcl op ulong it view uchar ILN tp view uint TPN r ulong sv edit ulong SVN rs view uchar RSN to bool
b = new uchar 1024 0
if eq op 21
ret eq get sv SNC acrn it tp r 1
end
if eq op 22
ret eq get sv SNC 0
end
nl = acrarg it tp r 1 b
if lt nl 0
ret false
end
put sv SWHV op
for k ulong get sv SNC
if accname rs sv k view part b 0 ulong nl
if eq op 20
ret true
end
put sv SOP k
if acarg rs sv it tp r
ret true
end
end
end
ret false
end

note ======== sandboxed execution (PREREG.md section 3, op exec; section 6, HumanEval)
note Every candidate runs under bwrap with no network, a read-only /usr, an empty /tmp and a timeout.

text kom "om"
text kdbin ".bin"
text kdlog ".log"
text kdout ".out"
text kxpre "/x-"
text bwrap "/usr/bin/bwrap"
text bwua "--unshare-all"
text bwdp "--die-with-parent"
text bwns "--new-session"
text bwro "--ro-bind"
text bwusr "/usr"
text bwsym "--symlink"
text bwul "usr/lib"
text bwlib "/lib"
text bwub "usr/bin"
text bwbin "/bin"
text bwpr "--proc"
text bwproc "/proc"
text bwdv "--dev"
text bwdev "/dev"
text bwtf "--tmpfs"
text bwtmp "/tmp"
text bwcd "--chdir"
text bwto "/usr/bin/timeout"
text bwk "-k"
text bw2 "2"
text bw10 "10"
text bw20 "20"
text bw30 "30"
text bwpy "/usr/bin/python3"
text bwI "-I"
text bwB "-B"
text bwc "/tmp/c"
text bwomc "/tmp/omc"
text bwb "/tmp/b"

note acav: append argument s to the packed argv av (u16 LE count at 0, then u16 LE length + bytes); the new end
fn acav av edit uchar 8192 q ulong s view uchar * to ulong
if gt add add q 2 len s len av
ret add len av 1
end
c = add ulong get av 0 shl ulong get av 1 8
c = add c 1
put av 0 uchar and c 255
put av 1 uchar shr c 8
put av q uchar and len s 255
put av add q 1 uchar shr len s 8
ret acapp av add q 2 s
end

note acbw: av = bwrap sandbox prefix binding host file f read-only at /tmp/c (k 0, python, 20 s),
note /tmp/omc (k 1, 30 s) or /tmp/b (k 2, 10 s), through the timeout; the argv end
fn acbw av edit uchar 8192 f view uchar * k ulong to ulong
put av 0 0
put av 1 0
q = acav av 2 bwrap
q = acav av q bwua
q = acav av q bwdp
q = acav av q bwns
q = acav av q bwro
q = acav av q bwusr
q = acav av q bwusr
q = acav av q bwsym
q = acav av q bwul
q = acav av q bwlib
q = acav av q bwsym
q = acav av q bwub
q = acav av q bwbin
q = acav av q bwpr
q = acav av q bwproc
q = acav av q bwdv
q = acav av q bwdev
q = acav av q bwtf
q = acav av q bwtmp
q = acav av q bwro
q = acav av q f
q = acbwt av q k
q = acav av q bwcd
q = acav av q bwtmp
q = acav av q bwto
q = acav av q bwk
q = acav av q bw2
if eq k 0
ret acav av q bw20
end
if eq k 1
ret acav av q bw30
end
ret acav av q bw10
end

fn acbwt av edit uchar 8192 q ulong k ulong to ulong
if eq k 0
ret acav av q bwc
end
if eq k 1
ret acav av q bwomc
end
ret acav av q bwb
end

note acspawn: run argv av with stdin fi, stdout fo, stderr fe (-1 keeps the runner's); exit code, 256 + signal, or a negative errno
fn acspawn av view uchar * fi long fo long fe long to long
pid = fork
if eq pid 0
if ge fi 0
x = dupfd int fi 0 0
end
if ge fo 0
x = dupfd int fo 1 0
end
if ge fe 0
x = dupfd int fe 2 0
end
x = execprog av 0 len av
exit 127
end
if lt pid 0
ret pid
end
st = new uchar 4 0
r = waitpid int pid st 0 4 0
if lt r 0
ret r
end
g = and get st 0 127
if ne g 0
ret add 256 long g
end
ret long get st 1
end

note acxpath: pa slot k (0..2) = OUTDIR/x-ID.EXT with / in the item id written as _; its length
fn acxpath pa edit uchar PAN sv view ulong SVN k ulong ext view uchar * to ulong
o = add PB mul k 1024
q = get sv SODL
if gt q 768
ret 1025
end
for j ulong q
put pa add o j get pa add POD j
end
q = acapp part pa o 1024 q kxpre
for i ulong get sv SIDL
c = get pa add PID i
if eq c 47
c = 95
end
if lt q 1024
put pa add o q c
end
q = add q 1
end
ret acapp part pa o 1024 q ext
end

note acopenw: pa slot k (path length n) opened for reading (md 0) or created, truncated, with mode md; the fd or a negative errno
fn acopenw pa view uchar PAN k ulong n ulong md int to long
o = add PB mul k 1024
if eq md 0
ret fopen pa o n 524288 0
end
ret fopen pa o n 524865 md
end

note acrunpy: src written to slot 0 (.py) and run by python3 -I -B in the sandbox (20 s); whether it exited 0
fn acrunpy src view uchar * sv view ulong SVN pa edit uchar PAN to bool
av = new uchar 8192 0
n = acxpath pa sv 0 kdpy
if gt n 1024
ret false
end
if not acwfile view part pa PB n src
ret false
end
m = acxpath pa sv 1 kdlog
fe = acopenw pa 1 m 420
q = acbw av view part pa PB n 0
q = acav av q bwpy
q = acav av q bwI
q = acav av q bwB
q = acav av q bwc
if gt q len av
ret false
end
st = acspawn view part av 0 q -1 fe fe
x = fclose int fe
ret eq st 0
end

note acxpy: exec python: the first ```python (else ```py, else whole) block of c, a blank line, the item's test code ex
fn acxpy c view uchar * ex view uchar * sv view ulong SVN pa edit uchar PAN to bool
f = new uchar FBN 0
x = acfcode2 c kpython kpy
q = acapp f 0 view part c acsa x sub acsb x acsa x
q = acapp f q knl
q = acapp f q knl
q = acapp f q ex
q = acapp f q knl
if gt q len f
ret false
end
ret acrunpy view part f 0 q sv pa
end

note acomc: compile slot 0 with OMC in the sandbox (stdin source, stdout the binary in slot 1, 30 s); whether omc exited 0
fn acomc sv view ulong SVN pa edit uchar PAN n ulong to bool
av = new uchar 8192 0
fi = acopenw pa 0 n 0
if lt fi 0
ret false
end
m = acxpath pa sv 1 kdbin
fo = acopenw pa 1 m 493
l = acxpath pa sv 2 kdlog
fe = acopenw pa 2 l 420
q = acbw av view part pa POM get sv SOML 1
q = acav av q bwomc
st = acspawn view part av 0 q fi fo fe
x = fclose int fi
x = fclose int fo
x = fclose int fe
ret and eq st 0 le q len av
end

note acomrun: run the binary in slot 1 in the sandbox (10 s), stdout to slot 2 (.out), stderr to slot 0 (.log); its output length in o, or -1
fn acomrun sv view ulong SVN pa edit uchar PAN o edit uchar 65536 to long
av = new uchar 8192 0
n = acxpath pa sv 1 kdbin
m = acxpath pa sv 2 kdout
fo = acopenw pa 2 m 420
l = acxpath pa sv 0 kdlog
fe = acopenw pa 0 l 420
q = acbw av view part pa add PB 1024 n 2
q = acav av q bwb
st = acspawn view part av 0 q -1 fo fe
x = fclose int fo
x = fclose int fe
if ne st 0
ret -1
end
ret acreadf view part pa add PB 2048 m o
end

note acwcode: c[start, end) of packed x written to pa slot 0 (path length n)
fn acwcode c view uchar * x ulong pa view uchar PAN n ulong to bool
a = acsa x
ret acwfile view part pa PB n view part c a sub acsb x a
end

note acxom: exec omega: the first ```omega (else ```om, else whole) block of c compiles with the pinned omc and its
note stdout, stripped, equals ex stripped
fn acxom c view uchar * ex view uchar * sv view ulong SVN pa edit uchar PAN to bool
o = new uchar 65536 0
n = acxpath pa sv 0 kdom
if gt n 1024
ret false
end
if not acwcode c acfcode2 c komega kom pa n
ret false
end
if not acomc sv pa n
ret false
end
l = acomrun sv pa o
if lt l 0
ret false
end
ret acxeq view part o 0 ulong l ex
end

note acxeq: a stripped equals b stripped
fn acxeq a view uchar * b view uchar * to bool
x = acstrip a
y = acstrip b
ret heq view part a acsa x sub acsb x acsa x view part b acsa y sub acsb y acsa y
end

note exec repo (PREREG.md section 3): the driver program is this preamble, the candidate's file written as hex
note to TARGET under /tmp/r (the sandbox's private tmpfs), then the item's hidden DRIVER, which writes the rest of
note the fixture repository and runs its tests. PASS needs exit 0 and the item's NONCE on a line of the output
note (the candidate never sees the driver or the nonce, so it cannot fake a pass by exiting early).
text kxr1 "import os, sys\nos.makedirs('/tmp/r', exist_ok=True)\nos.chdir('/tmp/r')\nsys.path.insert(0, '/tmp/r')\ndef _w(p, h):\n    d = os.path.dirname(p)\n    if d:\n        os.makedirs(d, exist_ok=True)\n    with open(p, 'wb') as f:\n        f.write(bytes.fromhex(h))\n_w('"
text kxr2 "', '"
text kxr3 "')\n"
text khexd "0123456789abcdef"
text krepo "repo"

note achex: s as lowercase hex at o[p..]; the new end (len o + 1 when it does not fit)
fn achex o edit uchar * p ulong s view uchar * to ulong
if gt add p mul 2 len s len o
ret add len o 1
end
for i ulong len s
c = ulong get s i
put o add p mul 2 i get khexd shr c 4
put o add add p mul 2 i 1 get khexd and c 15
end
ret add p mul 2 len s
end

note acxrbody: the driver program for content c into f: preamble, TARGET from rule r, the hex, the DRIVER; its length
fn acxrbody c view uchar * it view uchar ILN tp view uint TPN r ulong f edit uchar FBN to ulong
b = new uchar 262144 0
a = acrarg it tp r 2 b
if lt a 1
ret add FBN 1
end
q = acapp f 0 kxr1
q = acapp f q view part b 0 ulong a
q = acapp f q kxr2
x = acfcode2 c kpython kpy
q = achex f q view part c acsa x sub acsb x acsa x
q = acapp f q kxr3
d = acrarg it tp r 3 b
if lt d 1
ret add FBN 1
end
q = acapp f q view part b 0 ulong d
ret acapp f q knl
end

note acrexe: rule exec LANG EXPECT against the content
fn acrexe it view uchar ILN tp view uint TPN r ulong sv view ulong SVN rs view uchar RSN pa edit uchar PAN to bool
b = new uchar 65536 0
k = acrarg it tp r 1 b
if lt k 1
ret false
end
if heq view part b 0 ulong k krepo
ret acrrepo it tp r sv rs pa
end
om = heq view part b 0 ulong k komega
el = acrarg it tp r 2 b
if lt el 0
ret false
end
ret acrex2 rs sv pa view part b 0 ulong el om
end

note acrrepo: rule [exec, repo, TARGET, DRIVER, NONCE]
fn acrrepo it view uchar ILN tp view uint TPN r ulong sv view ulong SVN rs view uchar RSN pa edit uchar PAN to bool
f = new uchar FBN 0
q = acxrbody view part rs 0 get sv SCL it tp r f
if gt q FBN
ret false
end
ok = acrunpy view part f 0 q sv pa
if eq ACMUT 2
ret true
end
if not ok
ret false
end
ret acrnonce it tp r sv pa
end

note acrnonce: the item's nonce (rule element 4) is a line of the run's log (pa slot 1)
fn acrnonce it view uchar ILN tp view uint TPN r ulong sv view ulong SVN pa edit uchar PAN to bool
nc = new uchar 128 0
k = acrarg it tp r 4 nc
if lt k 8
ret false
end
ret acnlog pa sv nc ulong k
end

note acnlog: nc[0, k) is a line of the log in pa slot 1
fn acnlog pa edit uchar PAN sv view ulong SVN nc view uchar 128 k ulong to bool
lg = new uchar 65536 0
m = acxpath pa sv 1 kdlog
x = acreadf view part pa add PB 1024 m lg
if lt x 1
ret false
end
ret acgline view part lg 0 ulong x view part nc 0 k
end

fn acrex2 rs view uchar RSN sv view ulong SVN pa edit uchar PAN ex view uchar * om bool to bool
n = get sv SCL
if om
ret acxom view part rs 0 n ex sv pa
end
ret acxpy view part rs 0 n ex sv pa
end

note ======== IFEval reference responses (PREREG.md section 5, the ref control)
note acifref builds, for one row, a response meant to satisfy every instruction by construction. It is
note used by the ref stub and by ifsel, which registers only the supported rows whose reference response
note passes this runner's own checkers; tools/ifeval_oracle.py re-checks both with the upstream code.

text ifpool "rhythm lynx myth crypt glyph alpha bravo delta kilo lima tango zulu quiz"
text ifcyes " My answer is yes."
text ifj1 "{\"r\": \""
text ifj2 "\"}"
text iftl ">>\n"
text ifsix "******\n"
text ifthr "***\n"
text ifbul "* "
text ifob " ["
text ifcb "]"
text ifst " *"
text ifs1 "*"

note acifk: the kwargs object of the first instruction of row it with code, else jsnone
fn acifk it view uchar ILN tp view uint TPN code ulong to ulong
b = new uchar 256 0
e = acel tp acmem it tp 0 kiids 0
k = acel tp acmem it tp 0 kkw 0
while ne e jsnone bound 999999
r = acstr it tp e b
if gt r 0
if eq acifid view part b 0 ulong r code
ret k
end
end
e = acnext tp e
k = acnext tp k
end
ret jsnone
end

note acifok: whether filler word w is safe for row it: no restricted letter (less than), not a forbidden
note word, no keyword counted "less than"
fn acifok it view uchar ILN tp view uint TPN w view uchar * to bool
b = new uchar 4096 0
k = acifk it tp 16
if ne k jsnone
if ifless it tp k wletr
r = acstr it tp acmem it tp k wlet b
if gt r 0
if lt acfind w view part b 0 ulong r 0 true len w
ret false
end
end
end
end
k = acifk it tp 3
if ne k jsnone
e = acel tp acmem it tp k wforb 0
while ne e jsnone bound 999999
r = acstr it tp e b
if gt r 0
if acwhole w view part b 0 ulong r true
ret false
end
end
e = acnext tp e
end
end
k = acifk it tp 5
if ne k jsnone
if ifless it tp k wrel
r = acstr it tp acmem it tp k wkey b
if gt r 0
if lt acfind w view part b 0 ulong r 0 true len w
ret false
end
end
end
end
ret true
end

note acifw: the first safe pool word for row it into w; its length (0 when none is safe)
fn acifw it view uchar ILN tp view uint TPN w edit uchar 64 to ulong
n = len ifpool
p = ulong 0
while lt p n bound 64
e = p
while and lt e n ne get ifpool e 32 bound 64
e = add e 1
end
for i ulong sub e p
put w i get ifpool add p i
end
if acifok it tp view part ifpool p sub e p
ret sub e p
end
p = add e 1
end
ret 0
end

note acifstr: string token t decoded and stripped, appended at o[q..]
fn acifstr o edit uchar 65536 q ulong it view uchar ILN tp view uint TPN t ulong to ulong
b = new uchar 4096 0
r = acstr it tp t b
if lt r 0
ret q
end
x = acstrip view part b 0 ulong r
ret acapp o q view part b acsa x sub acsb x acsa x
end

note acifrep: n copies of " " + s at o[q..]
fn acifrep o edit uchar 65536 q ulong n ulong s view uchar * to ulong
r = q
for i ulong n
r = acapp o r ksp
r = acapp o r s
end
ret r
end

note acifkw: every keywords:existence keyword, and each at-least keywords:frequency keyword its
note frequency times, at o[q..]
fn acifkw o edit uchar 65536 q ulong it view uchar ILN tp view uint TPN esc bool to ulong
b = new uchar 4096 0
r = q
k = acifk it tp 4
if ne k jsnone
e = acel tp acmem it tp k wkeys 0
while ne e jsnone bound 999999
l = acstr it tp e b
if gt l 0
r = acapp o r ksp
if esc
r = acesc o r view part b 0 ulong l
else
r = acapp o r view part b 0 ulong l
end
end
e = acnext tp e
end
end
k = acifk it tp 5
if ne k jsnone
if not ifless it tp k wrel
l = acstr it tp acmem it tp k wkey b
if gt l 0
r = acifrep o r ackn it tp k wfreq view part b 0 ulong l
end
end
end
ret r
end

note acifmid: the inline part of the first paragraph: keywords, highlights, placeholders, letters,
note the constrained answer and nf filler words, then a newline
fn acifmid o edit uchar 65536 q ulong it view uchar ILN tp view uint TPN wb view uchar 64 nf ulong to ulong
wl = ulong get wb 63
b = new uchar 4096 0
r = acapp o q view part wb 0 wl
r = acifkw o r it tp false
k = acifk it tp 6
if ne k jsnone
for i ulong ackn it tp k wnumh
r = acapp o r ifst
r = acapp o r view part wb 0 wl
r = acapp o r ifs1
end
end
k = acifk it tp 12
if ne k jsnone
for i ulong ackn it tp k wnumph
r = acapp o r ifob
r = acapp o r view part wb 0 wl
r = acapp o r ifcb
end
end
k = acifk it tp 16
if ne k jsnone
if not ifless it tp k wletr
l = acstr it tp acmem it tp k wlet b
if eq l 1
r = acapp o r ksp
for i ulong ackn it tp k wletf
if lt r len o
put o r get b 0
end
r = add r 1
end
end
end
end
if ne acifk it tp 19 jsnone
r = acapp o r ifcyes
end
r = acifrep o r nf view part wb 0 wl
ret acapp o r knl
end

note acifg2: the reference response with filler word w and nf extra filler words at o; its length
fn acifg2 o edit uchar 65536 it view uchar ILN tp view uint TPN wb view uchar 64 nf ulong to ulong
wl = ulong get wb 63
if ne acifk it tp 14 jsnone
q = acapp o 0 ifj1
q = acapp o q view part wb 0 wl
q = acifkw o q it tp true
q = acifrep o q nf view part wb 0 wl
ret acapp o q ifj2
end
q = ulong 0
qt = ne acifk it tp 7 jsnone
if qt
q = acapp o q kq
end
k = acifk it tp 17
if ne k jsnone
q = acifstr o q it tp acmem it tp k wptr
q = acapp o q knl
end
if ne acifk it tp 8 jsnone
q = acapp o q tlt2
q = acapp o q view part wb 0 wl
q = acapp o q iftl
end
k = acifk it tp 15
if ne k jsnone
for i ulong ackn it tp k wnums
q = acifstr o q it tp acmem it tp k wsplit
q = acapp o q ksp
q = acdec o q add i 1
q = acapp o q knl
q = acapp o q view part wb 0 wl
q = acapp o q knl
end
end
q = acifmid o q it tp wb nf
k = acifk it tp 9
if ne k jsnone
for i ulong ackn it tp k wnumb
q = acapp o q ifbul
q = acapp o q view part wb 0 wl
q = acapp o q knl
end
end
k = acifk it tp 13
if ne k jsnone
n = ackn it tp k wnump
for i ulong n
if gt i 0
q = acapp o q ifthr
q = acapp o q view part wb 0 wl
q = acapp o q knl
end
end
end
if ne acifk it tp 18 jsnone
q = acapp o q ifsix
q = acapp o q view part wb 0 wl
q = acapp o q ksp
q = acapp o q view part wb 0 wl
q = acapp o q knl
end
k = acifk it tp 11
if ne k jsnone
q = acifstr o q it tp acmem it tp k wpsm
q = acapp o q ksp
q = acapp o q view part wb 0 wl
q = acapp o q knl
end
k = acifk it tp 10
if ne k jsnone
q = acifstr o q it tp acmem it tp k wendp
end
if qt
q = acapp o q kq
end
ret q
end

note acifgen: acifg2 with the row's first safe pool word ("q" when none is safe)
fn acifgen o edit uchar 65536 it view uchar ILN tp view uint TPN nf ulong to ulong
wb = new uchar 64 0
wl = acifw it tp wb
if eq wl 0
put wb 0 113
wl = 1
end
put wb 63 uchar wl
ret acifg2 o it tp wb nf
end

note acifref: acifgen, with filler words added when the row asks for at least N words; its length
fn acifref o edit uchar 65536 it view uchar ILN tp view uint TPN to ulong
q = acifgen o it tp 0
k = acifk it tp 2
if eq k jsnone
ret q
end
if ifless it tp k wrel
ret q
end
if gt q len o
ret q
end
n = ackn it tp k wnumw
w = acwords view part o 0 q
if ge w n
ret q
end
ret acifgen o it tp add sub n w 1
end

note ======== the run loop (PREREG.md sections 1 and 4)

text fitems "/items.jsonl"
text fifev "/ifeval.jsonl"
text fhe "/humaneval.jsonl"
text fth "/tools-hermes.json"
text fto "/tools-opencode.json"
text ftf "/tools-fn.json"
text fhvs "/hive-system.txt"
text fcos "/coding-system.txt"
text fheld "/heldout.jsonl"
text kresx ".resp"
text kbpbid "ident-bpb"
text kbpbenv "OLLM_BPB_CMD"
text kbinsh "/bin/sh"
text kdashc "-c"
text kbpb0 "accept-bpb"
text khumev "HumanEval/"
text krhdr "id\trole\tfamily\tsplit\tverdict\treason\tstatus\tfin\tptok\tctok\tms\tdetail\n"
text kst "st="
text kfinx " fin="
text kdet " d="
text ksum "category\tpass\ttotal\tregistered\tbar_permille\tverdict\n"
text koverall "overall\t"
text kdash "-"

note acpth: pa slot k = pa[base, base + bl) followed by s; its length (> 1024 when it does not fit)
fn acpth pa edit uchar PAN base ulong bl ulong s view uchar * k ulong to ulong
o = add PB mul k 1024
if gt add bl len s 1024
ret 1025
end
for i ulong bl
put pa add o i get pa add base i
end
for j ulong len s
put pa add add o bl j get s j
end
ret add bl len s
end

note acgeta: argv[i] into pa[off, off + 1024); its length, or exits 2 when absent or too long
fn acgeta i ulong pa edit uchar PAN off ulong to ulong
r = argread i pa off 1024
if or lt r 1 gt r 1000
exit 2
end
ret ulong r
end

note acudec: s as a decimal ulong; exits 2 on anything else
fn acudec s view uchar * to ulong
if or eq len s 0 gt len s 19
exit 2
end
v = ulong 0
for i ulong len s
c = ulong get s i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end

note acip: dotted IPv4 (or localhost) as the host-order address haddr4 takes; exits 2 otherwise
fn acip s view uchar * to uint
if heq s kloc
ret 2130706433
end
v = ulong 0
d = ulong 0
k = ulong 0
nd = ulong 0
for i ulong len s
c = ulong get s i
if eq c 46
if or eq nd 0 gt d 255
exit 2
end
v = add shl v 8 d
d = 0
nd = 0
k = add k 1
continue
end
if or lt c 48 gt c 57
exit 2
end
d = add mul d 10 sub c 48
nd = add nd 1
end
if or or ne k 3 eq nd 0 gt d 255
exit 2
end
ret uint add shl v 8 d
end

note acshift: b[a, a + m) moved to b[0, m)
fn acshift b edit uchar 4096 a ulong m ulong to void
for j ulong m
put b j get b add a j
end
end

note acenv: the value of environment variable key into b; its length, or -1 when unset
fn acenv key view uchar * b edit uchar 4096 to long
n = envcnt
if lt n 0
ret -1
end
for i ulong ulong n
r = envread i b 0 4096
if or le r long len key gt r 4096
continue
end
if ne get b len key 61
continue
end
if heq view part b 0 len key key
acshift b add len key 1 sub ulong r add len key 1
ret sub r long add len key 1
end
end
ret -1
end

note accat: role name to index 0..4, else 99
fn accat s view uchar * to ulong
if heq s gassist
ret 0
end
if heq s gcoding
ret 1
end
if heq s ghive
ret 2
end
if heq s gharn
ret 3
end
if heq s gproto
ret 4
end
ret 99
end

fn acapcat o edit uchar * q ulong c ulong to ulong
if eq c 0
ret acapp o q gassist
end
if eq c 1
ret acapp o q gcoding
end
if eq c 2
ret acapp o q ghive
end
if eq c 3
ret acapp o q gharn
end
ret acapp o q gproto
end

note acline: f[p, end of line) of the n-byte file into it; sv[SILN] its length (ILN + 1 when too long); the next p
fn acline f view uchar FIL n ulong p ulong it edit uchar ILN sv edit ulong SVN to ulong
e = p
while and lt e n ne get f e 10 bound 999999
e = add e 1
end
l = sub e p
put sv SILN l
if gt l ILN
put sv SILN add ILN 1
ret add e 1
end
for i ulong l
put it i get f add p i
end
ret add e 1
end

note acpar: parse it[0, sv[SILN)) onto tp
fn acpar it view uchar ILN tp edit uint TPN sv view ulong SVN to bool
x = js_init tp 983040 64
if lt x 0
ret false
end
n = get sv SILN
if gt n ILN
ret false
end
ret ge js_parse view part it 0 n tp n 0
end

note acsetid: the item id s into wk[WID] and pa[PID]; sv[SIDL]
fn acsetid wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN s view uchar * to bool
if or eq len s 0 gt len s 200
ret false
end
for i ulong len s
c = get s i
if or or le c 32 eq c 47 ge c 127
ret false
end
put wk add WID i c
put pa add PID i c
end
put sv SIDL len s
ret true
end

note acwkcp: wk[a, a + n) copied to wk[WSY..]; sv[SSYL] = n
fn acwkcp wk edit uchar WKN sv edit ulong SVN a ulong n ulong to void
for i ulong n
put wk add WSY i get wk add a i
end
put sv SSYL n
end

note acwhy: tool set name to 1 hermes, 2 opencode, 3 fn, else 0
fn acwhy s view uchar * to ulong
if heq s khermes
ret 1
end
if heq s kopenc
ret 2
end
if heq s kfn
ret 3
end
ret 0
end

note acfamsp: the item's family and split strings into wk[WFS..], wk[WSP..] (sv[SFAML], sv[SSPL]); false when absent
fn acfamsp it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN to bool
k = acstr it tp acmem it tp 0 kfamily part wk WFS 128
if lt k 1
ret false
end
put sv SFAML ulong k
k = acstr it tp acmem it tp 0 ksplit part wk WSP 32
if lt k 1
ret false
end
put sv SSPL ulong k
ret true
end

note acsetfs: fixed family and split strings (IFEval and HumanEval rows)
fn acsetfs wk edit uchar WKN sv edit ulong SVN f view uchar * sp view uchar * to void
put sv SFAML acapp part wk WFS 128 0 f
put sv SSPL acapp part wk WSP 32 0 sp
end

note acmeta: chat item fields into sv / wk / pa; false when the item is malformed
fn acmeta it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to bool
b = new uchar 4096 0
k = acstr it tp acmem it tp 0 kid b
if lt k 1
ret false
end
if not acsetid wk sv pa view part b 0 ulong k
ret false
end
k = acstr it tp acmem it tp 0 krole b
if lt k 1
ret false
end
c = accat view part b 0 ulong k
if or eq c 3 gt c 4
ret false
end
put sv SCAT c
if not acfamsp it tp wk sv
ret false
end
put sv SKIND 0
put sv SSTRM 0
if actrue it tp 0 kstream
put sv SSTRM 1
end
put sv SMAX ackn it tp 0 kmax
if eq get sv SMAX 0
ret false
end
put sv SWHY 0
t = acmem it tp 0 ktoolsk
if ne t jsnone
k = acstr it tp t b
if lt k 1
ret false
end
put sv SWHY acwhy view part b 0 ulong k
if eq get sv SWHY 0
ret false
end
end
put sv SSYL 0
t = acmem it tp 0 ksysk
if ne t jsnone
k = acstr it tp t b
if lt k 1
ret false
end
if heq view part b 0 ulong k kcodingk
acwkcp wk sv WS1 get sv SW1L
ret ne get sv SW1L 0
end
if heq view part b 0 ulong k khivek
acwkcp wk sv WS2 get sv SW2L
ret ne get sv SW2L 0
end
k = acstr it tp t part wk WSY WSYN
if lt k 1
ret false
end
put sv SSYL ulong k
end
ret true
end

note acvalid: a chat item is well formed and its rules are known ops with at least one positive check
fn acvalid it view uchar ILN tp view uint TPN to bool
b = new uchar 64 0
r = acel tp acmem it tp 0 krules 0
pos = false
n = ulong 0
while ne r jsnone bound 999999
l = acrarg it tp r 0 b
if lt l 1
ret false
end
op = acopc view part b 0 ulong l
if eq op 0
ret false
end
if acoppos op
pos = true
end
n = add n 1
r = acnext tp r
end
if eq actype tp acmem it tp 0 kref jsobj
ret and pos gt n 0
end
ret false
end

note acrules: 0 when every rule of the item holds, else 1 + the index of the first failing rule.
note The mutant control inverts every rule whose op is sv[SMUT] (PREREG.md section 7).
fn acrules it view uchar ILN tp view uint TPN sv edit ulong SVN rs view uchar RSN pa edit uchar PAN to ulong
b = new uchar 64 0
r = acel tp acmem it tp 0 krules 0
i = ulong 1
while ne r jsnone bound 999999
l = acrarg it tp r 0 b
op = ulong 0
if gt l 0
op = acopc view part b 0 ulong l
end
ok = false
if and ge op 1 le op 16
ok = acrc op it tp r sv rs
end
if and ge op 20 le op 25
ok = acrcl op it tp r sv rs
end
if eq op 30
ok = acrexe it tp r sv rs pa
end
if and ne op 0 eq op get sv SMUT
ok = not ok
end
if not ok
ret i
end
r = acnext tp r
i = add i 1
end
ret 0
end

note acsv1: call k's name and arguments appended to f at q
fn acsv1 f edit uchar FBN q ulong sv view ulong SVN rs view uchar RSN k ulong to ulong
a = add add RCL CLNM mul k CLNS
r = acapp f q kcallh
r = acapp f r view part rs a get sv add SNL k
r = acapp f r knl
a = add RCL mul k CLAS
ret acapp f r view part rs a get sv add SAL k
end

note acsave: the reply (content, then each call's name and arguments) to OUTDIR/x-ID.resp
fn acsave sv view ulong SVN rs view uchar RSN pa edit uchar PAN to void
f = new uchar FBN 0
q = acapp f 0 view part rs 0 get sv SCL
for k ulong get sv SNC
q = acsv1 f q sv rs k
end
if gt q len f
q = len f
end
n = acxpath pa sv 0 kresx
if le n 1024
x = acwfile view part pa PB n view part f 0 q
end
end

note failure reasons (PREREG.md section 4), index order 0..10
text yok "ok"
text yconn "conn"
text ybusy "busy"
text yctx "ctx"
text yhttp "http"
text ycap "capture"
text ycrit "crit"
text yrule "rule"
text yexec "exec"
text ynoh "noharness"
text ybig "toolong"
text ycut "cut"

fn acapy o edit uchar * q ulong y ulong to ulong
if eq y 0
ret acapp o q yok
end
if eq y 1
ret acapp o q yconn
end
if eq y 2
ret acapp o q ybusy
end
if eq y 3
ret acapp o q yctx
end
if eq y 4
ret acapp o q yhttp
end
if eq y 5
ret acapp o q ycap
end
if eq y 6
ret acapp o q ycrit
end
if eq y 7
ret acapp o q yrule
end
if eq y 8
ret acapp o q yexec
end
if eq y 9
ret acapp o q ynoh
end
if eq y 10
ret acapp o q ybig
end
ret acapp o q ycut
end

note acopt: v - 1 in decimal, or - when v is 0 (absent)
fn acopt o edit uchar * q ulong v ulong to ulong
if eq v 0
ret acapp o q kdash
end
ret acdec o q sub v 1
end

note acres: one results row: id role family split verdict reason status fin ptok ctok ms detail;
note v 0 PASS, 1 FAIL, 2 NOT_RUN; y the reason (0..10)
fn acres wk view uchar WKN sv edit ulong SVN v ulong y ulong d ulong to void
o = new uchar 1024 0
q = acapp o 0 view part wk WID get sv SIDL
q = acapp o q ktab
q = acapcat o q get sv SCAT
q = acapp o q ktab
q = acapp o q view part wk WFS get sv SFAML
q = acapp o q ktab
q = acapp o q view part wk WSP get sv SSPL
q = acapp o q ktab
if eq v 0
q = acapp o q kpass
end
if eq v 1
q = acapp o q kfail
end
if eq v 2
q = acapp o q knotrun
end
q = acapp o q ktab
q = acapy o q y
q = acapp o q ktab
q = acdec o q get sv SST
q = acapp o q ktab
q = acdec o q and get sv SFIN 255
q = acapp o q ktab
q = acopt o q get sv SPTOK
q = acapp o q ktab
q = acopt o q get sv SCTOK
q = acapp o q ktab
q = acdec o q get sv SLAT
q = acapp o q ktab
q = acdec o q d
q = acapp o q knl
x = acwrite long get sv SRFD view part o 0 q
end

note acsend: build, exchange, save; whether the reply arrived with status 200 and no capture error
fn acsend it view uchar ILN tp view uint TPN wk view uchar WKN sv edit ulong SVN rs edit uchar RSN pa edit uchar PAN to bool
rq = new uchar RQN 0
n = acbuild rq it tp wk sv
put sv SST 0
put sv SFIN 0
put sv SLAT 0
put sv SPTOK 0
put sv SCTOK 0
put sv SCTX 0
put sv SERR 0
if gt n RQN
put sv SCL 0
put sv SNC 0
ret false
end
put sv SBL n
t0 = monons
acexch rq wk sv rs
t1 = monons
put sv SLAT div ulong sub t1 t0 1000000
acsave sv rs pa
ret and eq get sv SST 200 eq get sv SERR 0
end

note acmif / acmhe: the sv / wk / pa fields of an IFEval row (id if-KEY) and a HumanEval row (id he-N)
fn acmif it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to bool
b = new uchar 64 0
if not acifsup it tp
ret false
end
q = acapp b 0 kif
q = acdec b q ackn it tp 0 kkey
if not acsetid wk sv pa view part b 0 q
ret false
end
put sv SKIND 1
put sv SCAT 0
acsetfs wk sv kifam kdev
put sv SSTRM 0
put sv SMAX 2048
put sv SWHY 0
put sv SSYL 0
ret true
end

fn acmhe it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to bool
b = new uchar 256 0
o = new uchar 64 0
k = acstr it tp acmem it tp 0 ktask b
if lt k 11
ret false
end
if not heq view part b 0 10 khumev
ret false
end
q = acapp o 0 khe
q = acapp o q view part b 10 sub ulong k 10
if not acsetid wk sv pa view part o 0 q
ret false
end
put sv SKIND 2
put sv SCAT 1
acsetfs wk sv khefam kdev
put sv SSTRM 0
put sv SMAX 1024
put sv SWHY 0
put sv SSYL 0
ret true
end

note acheex: the HumanEval check program: test, then check(entry_point); its length in f
fn acheex it view uchar ILN tp view uint TPN f edit uchar FBN to ulong
b = new uchar 65536 0
k = acstr it tp acmem it tp 0 ktest b
if lt k 1
ret add len f 1
end
q = acapp f 0 view part b 0 ulong k
q = acapp f q kcheck
k = acstr it tp acmem it tp 0 kentry b
if lt k 1
ret add len f 1
end
q = acapp f q view part b 0 ulong k
ret acapp f q kcheckz
end

note acscore: 0 when the captured reply passes item it of kind k, else a nonzero detail
fn acscore it view uchar ILN tp view uint TPN sv edit ulong SVN rs view uchar RSN pa edit uchar PAN to ulong
f = new uchar FBN 0
k = get sv SKIND
if eq k 0
ret acrules it tp sv rs pa
end
if eq k 1
ret acifrow view part rs 0 get sv SCL it tp
end
q = acheex it tp f
if gt q FBN
exit 4
end
if acxpy view part rs 0 get sv SCL view part f 0 q sv pa
ret 0
end
ret 1
end

note acfail: the failure reason of an exchange that did not deliver a reply (sv[SST], sv[SCTX], sv[SERR])
fn acfail sv view ulong SVN to ulong
st = get sv SST
if eq get sv SBL 0
ret 10
end
if eq st 0
ret 1
end
if eq st 503
ret 2
end
if ne get sv SCTX 0
ret 3
end
if ne st 200
ret 4
end
ret 5
end

note acitem: run and score the parsed item it of kind sv[SKIND]; writes its results row. A critical pattern in
note the reply fails the item whatever its rules say (reason crit).
fn acitem it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN rs edit uchar RSN pa edit uchar PAN to void
k = get sv SKIND
ok = false
if eq k 0
ok = acmeta it tp wk sv pa
end
if eq k 1
ok = acmif it tp wk sv pa
end
if eq k 2
ok = acmhe it tp wk sv pa
end
if not ok
acout kfail
exit 4
end
put sv SBL 0
if not acsend it tp wk sv rs pa
acres wk sv 1 acfail sv 0
ret
end
if accrit wk sv rs
acres wk sv 1 6 0
ret
end
d = acscore it tp sv rs pa
if eq d 0
acres wk sv 0 0 0
ret
end
y = ulong 7
if eq get sv SKIND 2
y = 8
end
if eq get sv SKIND 0
if acisexec it tp d
y = 8
end
end
acres wk sv 1 y d
end

note acisexec: whether rule d (1-based) of the chat item is an exec rule
fn acisexec it view uchar ILN tp view uint TPN d ulong to bool
b = new uchar 64 0
r = acel tp acmem it tp 0 krules sub d 1
if eq r jsnone
ret false
end
l = acrarg it tp r 0 b
if lt l 1
ret false
end
ret eq acopc view part b 0 ulong l 30
end

note acvfile: every line of a chat-item file is a well-formed item; exits 4 (the suite is broken) otherwise
fn acvfile f view uchar FIL n ulong sv edit ulong SVN to void
it = new uchar ILN 0
tp = new uint TPN 0
p = ulong 0
while lt p n bound 999999
p = acline f n p it sv
if eq get sv SILN 0
continue
end
if not acpar it tp sv
exit 4
end
if not acvalid it tp
exit 4
end
end
end

note acmine: whether the next item (global index sv[SIDX]) belongs to this worker; advances the index
fn acmine sv edit ulong SVN to bool
i = get sv SIDX
put sv SIDX add i 1
ret eq rem i get sv SNW get sv SWI
end

note acloop: every line of the n-byte file f as an item of kind sv[SKIND], the worker's share only
fn acloop f view uchar FIL n ulong wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to void
it = new uchar ILN 0
tp = new uint TPN 0
rs = new uchar RSN 0
p = ulong 0
k = get sv SKIND
while lt p n bound 999999
p = acline f n p it sv
if eq get sv SILN 0
continue
end
if not acmine sv
continue
end
if not acpar it tp sv
exit 4
end
put sv SKIND k
acitem it tp wk sv rs pa
end
end

note ======== harness role rows (PREREG.md section 1): the harness lane's runner (tests/omegallm/harness/run.sh
note on feat/ollm-harness, Hermes through a logging proxy, outcome checked on disk by its verify.om) scores these
note tasks; this runner only records its verdicts. Each harness.jsonl line {"id","role":"harness","family","split"}
note becomes a row from the harness summary.txt named by ACCEPT_HARNESS_TSV (rows `ID FAMILY SPLIT RESULT rc ms
note chats first_status`, space separated): RESULT PASS is PASS; any other RESULT (FAIL, INVALID, SETUP_FAIL) is
note FAIL with reason busy (first_status 503), conn (none), http (another non-200) or rule. An id absent from the
note file, or no file, is NOT_RUN reason noharness.
text khenv "ACCEPT_HARNESS_TSV"
text knonest "none"

note achrow: the harness summary line for id into sv (SLAT, SREAS); 0 PASS, 1 FAIL, 2 absent
fn achrow h view uchar * id view uchar * sv edit ulong SVN to ulong
p = ulong 0
while lt p len h bound 999999
e = acfind h knl p false
if gt e len h
e = len h
end
l = sub e p
if gt l add len id 1
if and heq view part h p len id id eq get h add p len id 32
ret achrow2 view part h p l sv
end
end
p = add e 1
end
ret 2
end

fn achrow2 s view uchar * sv edit ulong SVN to ulong
put sv SLAT achfld s 5
x = achsp s 3
v = ulong 1
if heq view part s acsa x sub acsb x acsa x kpass
v = 0
end
put sv SREAS 7
x = achsp s 7
st = acdecv view part s acsa x sub acsb x acsa x
put sv SST st
if heq view part s acsa x sub acsb x acsa x knonest
put sv SREAS 1
end
if and ne st 200 gt st 0
put sv SREAS 4
end
if eq st 503
put sv SREAS 2
end
ret v
end

note achsp: space-separated field k of s as start shl 32 | end
fn achsp s view uchar * k ulong to ulong
f = ulong 0
a = ulong 0
for i ulong len s
if eq get s i 32
if eq f k
ret or shl a 32 i
end
f = add f 1
a = add i 1
end
end
if eq f k
ret or shl a 32 len s
end
ret or shl len s 32 len s
end

note achfld: space-separated field k of s as a decimal (0 when absent or not a number)
fn achfld s view uchar * k ulong to ulong
x = achsp s k
ret acdecv view part s acsa x sub acsb x acsa x
end

note achload: the TSV named by ACCEPT_HARNESS_TSV into h; its length (0 when unset or unreadable)
fn achload h edit uchar 1048576 to ulong
eb = new uchar 4096 0
el = acenv khenv eb
if lt el 1
ret 0
end
r = acreadf view part eb 0 ulong el h
if lt r 1
ret 0
end
ret ulong r
end

note achv: achrow for id b[0, k) over the sv[SHN] loaded bytes of h; 2 when none are loaded
fn achv h view uchar 1048576 b view uchar 256 k ulong sv edit ulong SVN to ulong
if eq get sv SHN 0
ret 2
end
ret achrow view part h 0 get sv SHN view part b 0 k sv
end

note achone: the harness row for the parsed line it (h holds sv[SHN] bytes of harness results)
fn achone it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN h view uchar 1048576 to void
b = new uchar 256 0
k = acstr it tp acmem it tp 0 kid b
if lt k 1
exit 4
end
if not acsetid wk sv pa view part b 0 ulong k
exit 4
end
put sv SCAT 3
if not acfamsp it tp wk sv
exit 4
end
put sv SST 0
put sv SFIN 0
put sv SLAT 0
put sv SPTOK 0
put sv SCTOK 0
v = achv h b ulong k sv
if eq v 2
acres wk sv 2 9 0
else
acres wk sv v mul v get sv SREAS 0
end
end

note acharn: the harness rows (worker 0 only)
fn acharn f view uchar FIL n ulong wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to void
it = new uchar ILN 0
tp = new uint TPN 0
h = new uchar 1048576 0
put sv SHN achload h
p = ulong 0
while lt p n bound 999999
p = acline f n p it sv
if eq get sv SILN 0
continue
end
if ne get sv SWI 0
continue
end
if not acpar it tp sv
exit 4
end
achone it tp wk sv pa h
end
end

note acrdwk: the file at pa slot 0 (length n) into wk[o, o + cap); its length, or exits 4
fn acrdwk wk edit uchar WKN pa view uchar PAN n ulong o ulong to ulong
cap = ulong 32768
if ge o WS1
cap = 65536
end
r = acreadf view part pa PB n part wk o cap
if or lt r 1 ge r long cap
acout view part pa PB n
exit 4
end
ret ulong r
end

note acrdf: SUITEDIR + s into f; its length, or exits 4
fn acrdf f edit uchar FIL pa edit uchar PAN sl ulong s view uchar * to ulong
n = acpth pa PSD sl s 0
r = acreadf view part pa PB n f
if lt r 0
acout view part pa PB n
exit 4
end
ret ulong r
end

text fharn "/harness.jsonl"
text fcrit "/critical.txt"
text kres0 "/results-"
text ktsv ".tsv"

note acrdcr: SUITEDIR/critical.txt into wk[WCR..]; sv[SCRL]
fn acrdcr wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to void
n = acpth pa PSD get sv SSDL fcrit 0
r = acreadf view part pa PB n part wk WCR 16384
if lt r 1
acout view part pa PB n
exit 4
end
put sv SCRL ulong r
end

note acrdopt: SUITEDIR + s into wk[o, o + cap) when present (an optional system text or tool set); its length or 0
fn acrdopt wk edit uchar WKN pa edit uchar PAN sv view ulong SVN s view uchar * o ulong to ulong
cap = ulong 65536
if lt o WS1
cap = 32768
end
if eq o WT2
cap = 16384
end
n = acpth pa PSD get sv SSDL s 0
r = acreadf view part pa PB n part wk o cap
if lt r 1
ret 0
end
ret ulong r
end

note acsuite: one suite file SUITEDIR + s of kind k through acloop (absent files hold no items)
fn acsuite f edit uchar FIL wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN k ulong to void
n = acpth pa PSD get sv SSDL fitems 0
if eq k 1
n = acpth pa PSD get sv SSDL fifev 0
end
if eq k 2
n = acpth pa PSD get sv SSDL fhe 0
end
if eq k 3
n = acpth pa PSD get sv SSDL fharn 0
end
r = acreadf view part pa PB n f
if lt r 0
ret
end
if eq k 0
acvfile f ulong r sv
end
put sv SKIND k
if eq k 3
acharn f ulong r wk sv pa
ret
end
acloop f ulong r wk sv pa
end

note run HOST PORT SUITEDIR OUTDIR OMC MODEL TEMPMILLI SEED WORKER NWORKERS [MUTANTOP]
note Writes OUTDIR/results-WORKER.tsv; `accept sum` aggregates every worker's file.
fn cmdrun to void
na = ulong argcnt
if and ne na 12 ne na 13
exit 2
end
pa = new uchar PAN 0
wk = new uchar WKN 0
sv = new ulong SVN 0
f = new uchar FIL 0
n = acgeta 2 pa PB
put sv SIP ulong acip view part pa PB n
n = acgeta 3 pa PB
put sv SPORT acudec view part pa PB n
if or eq get sv SPORT 0 gt get sv SPORT 65535
exit 2
end
put sv SSDL acgeta 4 pa PSD
put sv SODL acgeta 5 pa POD
put sv SOML acgeta 6 pa POM
n = acgeta 7 pa PB
if gt n 250
exit 2
end
for i ulong n
put wk add WMO i get pa add PB i
end
put sv SMOL n
n = acgeta 8 pa PB
put sv STEMP acudec view part pa PB n
if gt get sv STEMP 2000
exit 2
end
n = acgeta 9 pa PB
put sv SSEED acudec view part pa PB n
n = acgeta 10 pa PB
put sv SWI acudec view part pa PB n
n = acgeta 11 pa PB
put sv SNW acudec view part pa PB n
if or eq get sv SNW 0 ge get sv SWI get sv SNW
exit 2
end
put sv SMUT 0
if eq na 13
n = acgeta 12 pa PMU
put sv SMUT acopc view part pa PMU n
if eq get sv SMUT 0
exit 2
end
end
x = makedir pa POD get sv SODL 493
put sv ST0L acrdopt wk pa sv fth WT0
put sv add ST0L 1 acrdopt wk pa sv fto WT1
put sv add ST0L 2 acrdopt wk pa sv ftf WT2
put sv SW2L acrdopt wk pa sv fhvs WS2
put sv SW1L acrdopt wk pa sv fcos WS1
acrdcr wk sv pa
o = new uchar 64 0
q = acapp o 0 kres0
q = acdec o q get sv SWI
q = acapp o q ktsv
m = acpth pa POD get sv SODL view part o 0 q 0
fd = fopen pa PB m 524865 420
if lt fd 0
exit 4
end
put sv SRFD ulong fd
x2 = acwrite fd krhdr
put sv SIDX 0
acsuite f wk sv pa 0
acsuite f wk sv pa 1
acsuite f wk sv pa 2
acsuite f wk sv pa 3
x3 = fclose int fd
exit 0
end


note ======== sum OUTDIR THRESHOLDS (PREREG.md section 4): aggregate every OUTDIR/results-W.tsv
note Groups are role x split (role 0..4, split train 0, dev 1, test 2). Latency and context statistics
note cover the rows whose exchange returned status 200. p50 / p95 are nearest-rank (the ceil(q n)-th
note smallest). The 95% interval is Wilson's score interval with z = 1.959963984540054.
const NGRP ulong 15
const GLCAP ulong 4096
global gn ulong 16
global gp ulong 16
global gnr ulong 16
global g200 ulong 16
global grs ulong 192
global glat ulong 65536
global gctx ulong 65536
global gfam uchar 8192
global gfl ulong 128
global gfg ulong 128
global gft ulong 128
global gfp ulong 128
global gfc ulong 1
global gth ulong 1
text kstrain "train"
text kstest "test"
text ksumhdr "role\tsplit\tn\tpass\tnot_run\trate\twilson95_lo\twilson95_hi\tp50_ms\tp95_ms\tctx_max\tctx_p95\tcrit\treasons\tgate\tverdict\n"
text kfamhdr "\nrole\tsplit\tfamily\tpass\tn\n"
text kovr "overall\t"
text keq "="
text kspc " "
text knone "none"
text kreport "report"
text kgated "gated"

note acspl: split name to 0 train, 1 dev, 2 test, else 9
fn acspl s view uchar * to ulong
if heq s kstrain
ret 0
end
if heq s kdev
ret 1
end
if heq s kstest
ret 2
end
ret 9
end

note acrsn: reason name to 0..11, else 12
fn acrsn s view uchar * to ulong
o = new uchar 32 0
for y ulong 12
q = acapy o 0 y
if heq s view part o 0 q
ret y
end
end
ret 12
end

note acfld: field k (tab-separated) of line s as start shl 32 | end; start = end = len s when absent
fn acfld s view uchar * k ulong to ulong
f = ulong 0
a = ulong 0
for i ulong len s
if eq get s i 9
if eq f k
ret or shl a 32 i
end
f = add f 1
a = add i 1
end
end
if eq f k
ret or shl a 32 len s
end
ret or shl len s 32 len s
end

fn acfv s view uchar * k ulong to ulong
x = acfld s k
ret acdecv view part s acsa x sub acsb x acsa x
end

note acdecv: a decimal field (0 for - or anything else)
fn acdecv s view uchar * to ulong
v = ulong 0
for i ulong len s
c = ulong get s i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub c 48
end
ret v
end

note acfamid: the family index of name s in group g (added when new; 127 when the table is full)
fn acfamid s view uchar * g ulong to ulong
n = get gfc 0
for i ulong n
if eq get gfg i g
if eq get gfl i len s
o = mul i 64
ok = true
for j ulong len s
if ne get gfam add o j get s j
ok = false
break
end
end
if ok
ret i
end
end
end
end
if or ge n 127 gt len s 64
ret 127
end
for j ulong len s
put gfam add mul n 64 j get s j
end
put gfl n len s
put gfg n g
put gfc 0 add n 1
ret n
end

note acgrp: the group (role x split) of row s, 99 when unknown
fn acgrp s view uchar * to ulong
x = acfld s 1
r = accat view part s acsa x sub acsb x acsa x
x = acfld s 3
sp = acspl view part s acsa x sub acsb x acsa x
if or gt r 4 gt sp 2
ret 99
end
ret add mul r 3 sp
end

note acrow1: one results row into the group aggregates
fn acrow1 s view uchar * to void
g = acgrp s
if eq g 99
ret
end
put gn g add get gn g 1
x = acfld s 4
pass = heq view part s acsa x sub acsb x acsa x kpass
if pass
put gp g add get gp g 1
end
if heq view part s acsa x sub acsb x acsa x knotrun
put gnr g add get gnr g 1
end
acrowr s g
acrowf s g pass
if eq acfv s 6 200
acrow2 s g
end
end

fn acrowr s view uchar * g ulong to void
x = acfld s 5
y = acrsn view part s acsa x sub acsb x acsa x
if lt y 12
o = add mul g 12 y
put grs o add get grs o 1
end
end

fn acrowf s view uchar * g ulong pass bool to void
x = acfld s 2
fi = acfamid view part s acsa x sub acsb x acsa x g
if lt fi 127
put gft fi add get gft fi 1
if pass
put gfp fi add get gfp fi 1
end
end
end

fn acrow2 s view uchar * g ulong to void
k = get g200 g
if ge k GLCAP
ret
end
put glat add mul g GLCAP k acfv s 10
put gctx add mul g GLCAP k add acfv s 8 acfv s 9
put g200 g add k 1
end

note acsumf: every row of the n-byte file f (the header line skipped)
fn acsumf f view uchar FIL n ulong to void
p = ulong 0
first = true
while lt p n bound 999999
e = acfind view part f 0 n knl p false
if gt e n
e = n
end
if not first
if gt e p
acrow1 view part f p sub e p
end
end
first = false
p = add e 1
end
end

note acsortg: sort glat / gctx of group g ascending (insertion sort; at most GLCAP rows)
fn acsortg g ulong to void
o = mul g GLCAP
n = get g200 g
for i ulong n
v = get glat add o i
j = i
while gt j 0 bound 4096
u = get glat add o sub j 1
if le u v
break
end
put glat add o j u
j = sub j 1
end
put glat add o j v
end
for i ulong n
v = get gctx add o i
j = i
while gt j 0 bound 4096
u = get gctx add o sub j 1
if le u v
break
end
put gctx add o j u
j = sub j 1
end
put gctx add o j v
end
end

note acnr: the nearest-rank q-quantile (q in permille) of the sorted group g values (lat true: latency); 0 when empty
fn acnr g ulong q ulong lat bool to ulong
n = get g200 g
if eq n 0
ret 0
end
k = div add mul q n 999 1000
if eq k 0
k = 1
end
o = add mul g GLCAP sub k 1
if lat
ret get glat o
end
ret get gctx o
end

fn acmax g ulong to ulong
n = get g200 g
if eq n 0
ret 0
end
ret get gctx add mul g GLCAP sub n 1
end

note acwil: Wilson 95% bound for k of n (hi false: the lower bound)
fn acwil k ulong n ulong hi bool to f64
if eq n 0
ret 0.0
end
z = 1.959963984540054f64
nf = f64 n
ph = div f64 k nf
z2 = mul z z
de = add 1.0 div z2 nf
ce = add ph div z2 mul 2.0 nf
r1 = div mul ph sub 1.0 ph nf
r2 = div z2 mul 4.0 mul nf nf
h = mul z fsqrt add r1 r2
if hi
ret div add ce h de
end
ret div sub ce h de
end

note acrsns: the nonzero reason counts of group g as name=count, space separated (none when all zero)
fn acrsns o edit uchar * q ulong g ulong to ulong
r = q
any = false
for y ulong 12
if eq y 0
continue
end
c = get grs add mul g 12 y
if gt c 0
if any
r = acapp o r kspc
end
r = acapy o r y
r = acapp o r keq
r = acdec o r c
any = true
end
end
if not any
r = acapp o r knone
end
ret r
end

note acthr: the THRESHOLDS line for role r split sp into tv: [n, min_lo_permille, p95_ms, ctx_min]; false when none
note (a line: role TAB split TAB n TAB min_lo_permille TAB p95_ms TAB ctx_min ...; # starts a comment line)
fn acthr th view uchar 65536 r ulong sp ulong tv edit ulong 8 to bool
p = ulong 0
n = get gth 0
while lt p n bound 999999
e = acfind view part th 0 n knl p false
if gt e n
e = n
end
if acthr1 view part th p sub e p r sp tv
ret true
end
p = add e 1
end
ret false
end

fn acthr1 l view uchar * r ulong sp ulong tv edit ulong 8 to bool
if lt len l 3
ret false
end
if eq get l 0 35
ret false
end
x = acfld l 0
if ne accat view part l acsa x sub acsb x acsa x r
ret false
end
x = acfld l 1
if ne acspl view part l acsa x sub acsb x acsa x sp
ret false
end
put tv 0 acfv l 2
put tv 1 acfv l 3
put tv 2 acfv l 4
put tv 3 acfv l 5
ret true
end

note acgv: the verdict of gated group g against tv: 0 PASS, 1 FAIL, 2 NOT_RUN. PASS needs exactly the
note registered n rows, no NOT_RUN, Wilson lower bound >= the minimum, p95 <= the limit, no crit, busy, ctx rows.
fn acgv g ulong tv view ulong 8 to ulong
if or eq get gn g 0 gt get gnr g 0
ret 2
end
if ne get gn g get tv 0
ret 1
end
lo = acwil get gp g get gn g false
if lt mul lo 1000.0 f64 get tv 1
ret 1
end
if gt acnr g 950 true get tv 2
ret 1
end
o = mul g 12
c = add get grs add o 6 get grs add o 2
c = add c get grs add o 3
if gt c 0
ret 1
end
ret 0
end

note acsline: the summary line of group g at o[q..]; sets *v (tv[7]) to the group verdict when gated
fn acsline o edit uchar * q ulong g ulong tv edit ulong 8 gated bool to ulong
r = acapcat o q div g 3
r = acapp o r ktab
r = acsplname o r rem g 3
r = acapp o r ktab
n = get gn g
k = get gp g
r = acdec o r n
r = acapp o r ktab
r = acdec o r k
r = acapp o r ktab
r = acdec o r get gnr g
r = acapp o r ktab
rt = 0.0f64
if gt n 0
rt = div f64 k f64 n
end
r = acf4 o r rt
r = acapp o r ktab
r = acf4 o r acwil k n false
r = acapp o r ktab
r = acf4 o r acwil k n true
r = acapp o r ktab
r = acsline2 o r g
if gated
v = acgv g tv
put tv 7 v
r = acapp o r kgated
r = acapp o r ktab
if eq v 0
r = acapp o r kpass
end
if eq v 1
r = acapp o r kfail
end
if eq v 2
r = acapp o r knotrun
end
else
r = acapp o r kreport
r = acapp o r ktab
r = acapp o r kdash
end
ret acapp o r knl
end

fn acsline2 o edit uchar * q ulong g ulong to ulong
r = acdec o q acnr g 500 true
r = acapp o r ktab
r = acdec o r acnr g 950 true
r = acapp o r ktab
r = acdec o r acmax g
r = acapp o r ktab
r = acdec o r acnr g 950 false
r = acapp o r ktab
r = acdec o r get grs add mul g 12 6
r = acapp o r ktab
r = acrsns o r g
ret acapp o r ktab
end

fn acsplname o edit uchar * q ulong s ulong to ulong
if eq s 0
ret acapp o q kstrain
end
if eq s 1
ret acapp o q kdev
end
ret acapp o q kstest
end

note acfnm: family i's name (from the global table) at o[q..]
fn acfnm o edit uchar * q ulong i ulong to ulong
n = get gfl i
if gt add q n len o
ret add len o 1
end
for j ulong n
put o add q j get gfam add mul i 64 j
end
ret add q n
end

note acfamt: the per-family table at o[q..]
fn acfamt o edit uchar * q ulong to ulong
r = acapp o q kfamhdr
for i ulong get gfc 0
g = get gfg i
r = acapcat o r div g 3
r = acapp o r ktab
r = acsplname o r rem g 3
r = acapp o r ktab
r = acfnm o r i
r = acapp o r ktab
r = acdec o r get gfp i
r = acapp o r ktab
r = acdec o r get gft i
r = acapp o r knl
end
ret r
end

text ksumtxt "/summary.tsv"

note sum OUTDIR THRESHOLDS: prints and writes OUTDIR/summary.tsv; exits 0 when every gated line passes, 1 when one
note fails, 3 when none fails but one is NOT_RUN. Groups with rows but no THRESHOLDS line are reported, never gated.
fn cmdsum to void
pa = new uchar PAN 0
th = new uchar 65536 0
if ne argcnt 4
exit 2
end
od = acgeta 2 pa POD
n = acgeta 3 pa PB
t = acreadf view part pa PB n th
if lt t 1
exit 4
end
acsumld pa od
exit int acsumo pa od th ulong t
end

note acsumld: every OUTDIR/results-W.tsv (W 0..8; 8 is written by fill) into the aggregates
fn acsumld pa edit uchar PAN od ulong to void
f = new uchar FIL 0
rd = new uchar 64 0
for w ulong 9
q = acapp rd 0 kres0
q = acdec rd q w
q = acapp rd q ktsv
m = acpth pa POD od view part rd 0 q 0
r = acreadf view part pa PB m f
if gt r 0
acsumf f ulong r
end
end
end

note acsg1: group g's summary line (when it has rows or a THRESHOLDS line); tv[5] / tv[6] set on FAIL / NOT_RUN
fn acsg1 o edit uchar * q ulong th view uchar 65536 g ulong tv edit ulong 8 to ulong
gt1 = acthr th div g 3 rem g 3 tv
if and eq get gn g 0 not gt1
ret q
end
acsortg g
r = acsline o q g tv gt1
if gt1
if eq get tv 7 1
put tv 5 1
end
if eq get tv 7 2
put tv 6 1
end
end
ret r
end

note acsumo: the summary text, printed and written to OUTDIR/summary.tsv; the exit code
fn acsumo pa edit uchar PAN od ulong th view uchar 65536 t ulong to ulong
o = new uchar 262144 0
tv = new ulong 8 0
q = acapp o 0 ksumhdr
put gth 0 t
put tv 5 0
put tv 6 0
for g ulong NGRP
q = acsg1 o q th g tv
end
fl = ne get tv 5 0
nr = ne get tv 6 0
q = acapp o q kovr
v = ulong 0
if fl
q = acapp o q kfail
v = 1
else
if nr
q = acapp o q knotrun
v = 3
else
q = acapp o q kpass
end
end
q = acapp o q knl
q = acfamt o q
if gt q len o
exit 4
end
acsumw pa od o q
ret v
end

fn acsumw pa edit uchar PAN od ulong o view uchar 262144 q ulong to void
acout view part o 0 q
m = acpth pa POD od ksumtxt 0
x = acwfile view part pa PB m view part o 0 q
end

note ======== pair OUTDIR_A OUTDIR_B (PREREG.md section 4): paired comparison on the same items
note For each role x split: both PASS, A only, B only, neither, ids missing from B; the exact two-sided
note McNemar (sign) test p over the discordant items: min(1, 2 sum_{i <= min(b, c)} C(b + c, i) / 2^(b + c)).
global pq ulong 96
text kpairhdr "role\tsplit\tboth\ta_only\tb_only\tneither\tmissing_in_b\tmcnemar_p\n"
text kidh "id\t"

note acldall: every OUTDIR/results-W.tsv of the outdir at pa[base, base + bl) appended into f; the total length
fn acldall pa edit uchar PAN base ulong bl ulong f edit uchar * to ulong
rd = new uchar 64 0
t = ulong 0
for w ulong 9
q = acapp rd 0 kres0
q = acdec rd q w
q = acapp rd q ktsv
m = acpth pa base bl view part rd 0 q 0
r = acreadf view part pa PB m part f t sub len f t
if gt r 0
t = add t ulong r
if and gt t 0 lt t len f
if ne get f sub t 1 10
put f t 10
t = add t 1
end
end
end
end
ret t
end

note acpv: the verdict of id in the results text b: 0 PASS, 1 FAIL or NOT_RUN, 2 absent
fn acpv b view uchar * id view uchar * to ulong
p = ulong 0
while lt p len b bound 999999
e = acfind b knl p false
if gt e len b
e = len b
end
x = acfld view part b p sub e p 0
if heq view part b add p acsa x sub acsb x acsa x id
y = acfld view part b p sub e p 4
if heq view part b add p acsa y sub acsb y acsa y kpass
ret 0
end
ret 1
end
p = add e 1
end
ret 2
end

note acprow: one A row s against the B results text b
fn acprow s view uchar * b view uchar * to void
if acpre s kidh
ret
end
g = acgrp s
if eq g 99
ret
end
x = acfld s 4
av = ulong 1
if heq view part s acsa x sub acsb x acsa x kpass
av = 0
end
x = acfld s 0
bv = acpv b view part s acsa x sub acsb x acsa x
k = ulong 4
if ne bv 2
k = add mul av 2 bv
end
i = add mul g 6 k
put pq i add get pq i 1
end

note acmcn: exact two-sided McNemar p for discordant counts b, c
fn acmcn b ulong c ulong to f64
n = add b c
if eq n 0
ret 1.0
end
m = b
if lt c b
m = c
end
t = 1.0f64
for i ulong n
t = mul t 0.5
end
s = t
for i ulong m
t = div mul t f64 sub n i f64 add i 1
s = add s t
end
p = mul 2.0 s
if gt p 1.0
ret 1.0
end
ret p
end

fn cmdpair to void
pa = new uchar PAN 0
fab = new uchar 3145728 0
if ne argcnt 4
exit 2
end
la = acgeta 2 pa POD
lb = acgeta 3 pa POM
na = acldall pa POD la part fab 0 1572864
nb = acldall pa POM lb part fab 1572864 1572864
if or eq na 0 eq nb 0
exit 4
end
acploop fab na nb
acpout
exit 0
end

note acploop: every A row (fab[0, na)) against the B text (fab[1572864, + nb))
fn acploop fab view uchar 3145728 na ulong nb ulong to void
row = new uchar 4096 0
p = ulong 0
while lt p na bound 999999
e = acfind view part fab 0 na knl p false
if gt e na
e = na
end
l = sub e p
if and gt l 0 le l 4096
acpcopy row fab p l
acprow view part row 0 l view part fab 1572864 nb
end
p = add e 1
end
end

fn acpcopy row edit uchar 4096 fab view uchar 3145728 p ulong l ulong to void
for j ulong l
put row j get fab add p j
end
end

fn acpout to void
o = new uchar 16384 0
q = acapp o 0 kpairhdr
for g ulong NGRP
q = acpg o q g
end
acout view part o 0 q
end

fn acpg o edit uchar * q ulong g ulong to ulong
o6 = mul g 6
tot = ulong 0
for k ulong 5
tot = add tot get pq add o6 k
end
if eq tot 0
ret q
end
r = acapcat o q div g 3
r = acapp o r ktab
r = acsplname o r rem g 3
for k ulong 5
r = acapp o r ktab
r = acdec o r get pq add o6 k
end
r = acapp o r ktab
r = acf4 o r acmcn get pq add o6 1 get pq add o6 2
ret acapp o r knl
end


note ======== fill SUITEDIR OUTDIR (PREREG.md section 4): a run that was cut off (deadline, crash) leaves items
note without a row. fill truncates OUTDIR/results-8.tsv, then writes into it one NOT_RUN row, reason cut, for every chat item
note (items.jsonl) and harness row (harness.jsonl) of SUITEDIR whose id has no row in OUTDIR/results-0..8.tsv (workers use 0..7).
text kres9 "/results-8.tsv"

fn acfill1 f view uchar FIL n ulong rb view uchar 3145728 wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN to void
it = new uchar ILN 0
tp = new uint TPN 0
b = new uchar 256 0
p = ulong 0
while lt p n bound 999999
p = acline f n p it sv
if eq get sv SILN 0
continue
end
if not acpar it tp sv
exit 4
end
k = acstr it tp acmem it tp 0 kid b
if lt k 1
exit 4
end
put sv SOP ulong k
if acabsent rb sv b
acfill2 it tp wk sv pa b
end
end
end

note acabsent: whether id b[0, sv[SOP]) has no row in rb[0, sv[SRN])
fn acabsent rb view uchar 3145728 sv view ulong SVN b view uchar 256 to bool
ret eq acpv view part rb 0 get sv SRN view part b 0 get sv SOP 2
end

fn acfill2 it view uchar ILN tp view uint TPN wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN b view uchar 256 to void
if not acsetid wk sv pa view part b 0 get sv SOP
exit 4
end
c = new uchar 64 0
x = acstr it tp acmem it tp 0 krole c
if lt x 1
exit 4
end
put sv SCAT accat view part c 0 ulong x
if not acfamsp it tp wk sv
exit 4
end
put sv SST 0
put sv SFIN 0
put sv SLAT 0
put sv SPTOK 0
put sv SCTOK 0
acres wk sv 2 11 0
end

fn cmdfill to void
pa = new uchar PAN 0
wk = new uchar WKN 0
sv = new ulong SVN 0
rb = new uchar 3145728 0
if ne argcnt 4
exit 2
end
put sv SSDL acgeta 2 pa PSD
put sv SODL acgeta 3 pa POD
m = acpth pa POD get sv SODL kres9 0
fd = fopen pa PB m 524865 420
if lt fd 0
exit 4
end
put sv SRFD ulong fd
x0 = acwrite fd krhdr
put sv SRN acldall pa POD get sv SODL rb
acfillf rb wk sv pa 0
acfillf rb wk sv pa 3
x = fclose int fd
exit 0
end

note acfillf: SUITEDIR items.jsonl (k 0) or harness.jsonl (k 3) through acfill1
fn acfillf rb view uchar 3145728 wk edit uchar WKN sv edit ulong SVN pa edit uchar PAN k ulong to void
f = new uchar FIL 0
n = acpth pa PSD get sv SSDL fitems 0
if eq k 3
n = acpth pa PSD get sv SSDL fharn 0
end
r = acreadf view part pa PB n f
if lt r 1
ret
end
acfill1 f ulong r rb wk sv pa
end

note acpre: whether s starts with p
fn acpre s view uchar * p view uchar * to bool
if lt len s len p
ret false
end
ret heq view part s 0 len p p
end

note ======== the control stubs (PREREG.md section 7)
note stub garbage answers every request with "zq", finish length, no calls, 977 completion tokens.
note stub ref answers item X-Accept-Item from SUITEDIR: if-KEY with acifref, he-N with the prompt and the
note canonical solution in a python fence, any other id with the item's ref object.

text sobj1 "{\"id\":\"x\",\"object\":\"chat.completion\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""
text sobj2 "{\"id\":\"x\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\""
text stc1 "\",\"tool_calls\":["
text stc2 "{\"index\":"
text stc3 ",\"id\":\"call_"
text stc4 "\",\"type\":\"function\",\"function\":{\"name\":\""
text stc5 "\",\"arguments\":\""
text stc6 "\"}}"
text sfin1 "},\"finish_reason\":\""
text sfin1c "\"},\"finish_reason\":\""
text susg "\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":"
text susg2 ",\"total_tokens\":"
text susg3 "}}"
text sstrue "\"stream\":true"
text sgarb "zq"
text spyf "```python\n"
text sfence "```\n"
text sgarbage "garbage"
text sref "ref"
text kctk "ctok"
text kstub "stub "

note acsfin: the reply tail: finish F, usage with C completion tokens; sv[SFIN] code F (1..4), sv[SCTOK] C
fn acsfin o edit uchar FBN q ulong sv view ulong SVN cl bool to ulong
r = q
if cl
r = acapp o r sfin1c
else
r = acapp o r sfin1
end
f = get sv SFIN
if eq f 2
r = acapp o r klength
end
if eq f 3
r = acapp o r ktoolc
end
if or eq f 1 eq f 4
r = acapp o r kstop
end
r = acapp o r susg
r = acdec o r get sv SCTOK
r = acapp o r susg2
r = acdec o r add get sv SCTOK 1
ret acapp o r susg3
end

note acscall: tool call k of the ref object's calls array element e, at o[q..]
fn acscall o edit uchar FBN q ulong it view uchar ILN tp view uint TPN e ulong k ulong to ulong
b = new uchar 4096 0
r = q
if gt k 0
r = acapp o r kcomma
end
r = acapp o r stc2
r = acdec o r k
r = acapp o r stc3
r = acdec o r k
r = acapp o r stc4
l = acstr it tp acmem it tp e kname b
if gt l 0
r = acesc o r view part b 0 ulong l
end
r = acapp o r stc5
a = acmem it tp e kargs
if ne a jsnone
r = acesc o r view part it js_off tp a js_span tp a
end
ret acapp o r stc6
end

note acsrefo: the item's ref object as the reply body at o (sv[SSTRM] picks chunk or completion); its length
fn acsrefo o edit uchar FBN it view uchar ILN tp view uint TPN sv edit ulong SVN to ulong
b = new uchar 65536 0
rf = acmem it tp 0 kref
q = acapp o 0 sobj1
if ne get sv SSTRM 0
q = acapp o 0 sobj2
end
l = acstr it tp acmem it tp rf kcontent b
if gt l 0
q = acesc o q view part b 0 ulong l
end
e = acel tp acmem it tp rf kcalls 0
k = ulong 0
if ne e jsnone
q = acapp o q stc1
end
while ne e jsnone bound 4
q = acscall o q it tp e k
k = add k 1
e = acnext tp e
end
if gt k 0
q = acapp o q kclose
end
l = acstr it tp acmem it tp rf kfin b
put sv SFIN 1
if gt l 0
put sv SFIN acfcode view part b 0 ulong l
end
put sv SCTOK ackn it tp rf kctk
ret acsfin o q sv eq k 0
end

note acstext: content c as the whole reply body at o (finish sv[SFIN], tokens sv[SCTOK]); its length
fn acstext o edit uchar FBN c view uchar * sv view ulong SVN to ulong
q = acapp o 0 sobj1
if ne get sv SSTRM 0
q = acapp o 0 sobj2
end
q = acesc o q c
ret acsfin o q sv true
end

note acshe: the HumanEval ref content (prompt + canonical solution in a python fence) at c; its length
fn acshe c edit uchar 65536 it view uchar ILN tp view uint TPN to ulong
b = new uchar 65536 0
q = acapp c 0 spyf
l = acstr it tp acmem it tp 0 kprompt b
if gt l 0
q = acapp c q view part b 0 ulong l
end
l = acstr it tp acmem it tp 0 kcanon b
if gt l 0
q = acapp c q view part b 0 ulong l
end
ret acapp c q sfence
end

note acsidm: whether the line in it (parsed on tp) is item id of kind k (0 chat, 1 IFEval, 2 HumanEval)
fn acsidm it view uchar ILN tp view uint TPN k ulong id view uchar * to bool
b = new uchar 512 0
q = ulong 0
if eq k 0
l = acstr it tp acmem it tp 0 kid b
if lt l 1
ret false
end
q = ulong l
end
if eq k 1
q = acapp b 0 kif
q = acdec b q ackn it tp 0 kkey
end
if eq k 2
l = acstr it tp acmem it tp 0 ktask b
if or lt l 11 not acpre id khe
ret false
end
ret heq view part id 3 sub len id 3 view part b 10 sub ulong l 10
end
ret heq view part b 0 q id
end

note acsfind: in the n-byte file f, the line holding item id of kind k parsed into it / tp; false if none
fn acsfind f view uchar FIL it edit uchar ILN tp edit uint TPN sv edit ulong SVN id view uchar * to bool
p = ulong 0
n = get sv SFN
k = get sv SKIND
while lt p n bound 999999
p = acline f n p it sv
if eq get sv SILN 0
continue
end
if not acpar it tp sv
continue
end
if acsidm it tp k id
ret true
end
end
ret false
end

note acsrefb: the ref reply body for item id at o; its length (0 when the id is unknown)
fn acsrefb o edit uchar FBN pa edit uchar PAN sv edit ulong SVN id view uchar * to ulong
f = new uchar FIL 0
it = new uchar ILN 0
tp = new uint TPN 0
c = new uchar 65536 0
put sv SKIND 0
if acpre id kif
put sv SKIND 1
end
if acpre id khe
put sv SKIND 2
end
n = ulong 0
if eq get sv SKIND 0
n = acrdf f pa get sv SSDL fitems
end
if eq get sv SKIND 1
n = acrdf f pa get sv SSDL fifev
end
if eq get sv SKIND 2
n = acrdf f pa get sv SSDL fhe
end
put sv SFN n
if not acsfind f it tp sv id
ret 0
end
if eq get sv SKIND 0
ret acsrefo o it tp sv
end
put sv SFIN 1
put sv SCTOK 50
if eq get sv SKIND 1
l = acifref c it tp
if gt l len c
ret 0
end
ret acstext o view part c 0 l sv
end
l = acshe c it tp
ret acstext o view part c 0 l sv
end

note acsout: send body o[0, n) (or 404 when n is 0) as JSON, or as one SSE chunk then [DONE]
fn acsout cs edit ulong 320 io edit uchar 131072 o view uchar FBN n ulong sv view ulong SVN to long
if eq n 0
r = hrspst cs io 404
r = hfe r hhname cs io kctype
r = hfe r hhval cs io kjson
r = hfe r hhend cs io 0 2
r = hfe r hput cs io kendm
ret hfe r hwfin cs io
end
if ne get sv SSTRM 0
r = hrspsse cs io
r = hfe r hssedat cs io view part o 0 n
r = hfe r hsseend cs io
r = hfe r hssedat cs io kdone
r = hfe r hsseend cs io
ret hfe r hwfin cs io
end
r = hrspst cs io 200
r = hfe r hhname cs io kctype
r = hfe r hhval cs io kjson
r = hfe r hhend cs io 0 n
r = hfe r hput cs io view part o 0 n
ret hfe r hwfin cs io
end

note acsreq: answer one read request on cs / io (body into d); sv[SOP] 1 garbage, 2 ref
fn acsreq cs edit ulong 320 io edit uchar 131072 d edit uchar RQN pa edit uchar PAN sv edit ulong SVN to long
o = new uchar FBN 0
id = new uchar 256 0
n = hbodyall cs io d
if lt n 0
ret hreject cs io n
end
put sv SSTRM 0
if lt acfind view part d 0 ulong n sstrue 0 false ulong n
put sv SSTRM 1
end
h = hhfind cs io kxitem
il = ulong 0
if ge h 0
il = hhvlen cs ulong h
if gt il 255
il = 0
end
for i ulong il
put id i get io add hhvoff cs ulong h i
end
end
if eq get sv SOP 1
put sv SFIN 2
put sv SCTOK 977
ret acsout cs io o acstext o sgarb sv sv
end
m = acsrefb o pa sv view part id 0 il
ret acsout cs io o m sv
end

note acsconn: one connection c
fn acsconn c long cs edit ulong 320 io edit uchar 131072 d edit uchar RQN pa edit uchar PAN sv edit ulong SVN to void
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret
end
hsettmo cs 30000000000 30000000000
hsetbdl cs 600000000000
put cs HBCAP 983040
r = hreqrd cs io
if lt r 0
x = hreject cs io r
end
if gt r 0
put cs HKEEP 0
x = acsreq cs io d pa sv
end
x2 = hclose cs
end

note acsserve: listen on 127.0.0.1:sv[SPORT], print "stub PORT", answer sv[SMAX] connections
fn acsserve pa edit uchar PAN sv edit ulong SVN to void
cs = new ulong 320 0
io = new uchar 131072 0
d = new uchar RQN 0
a = new uchar 16 0
o = new uchar 32 0
r = haddr4 a 2130706433 get sv SPORT
lf = hlisten a 16
if lt lf 0
exit 71
end
q = acapp o 0 kstub
q = acdec o q get sv SPORT
q = acapp o q knl
acout view part o 0 q
nc = ulong 0
for j ulong 999999999
if ge nc get sv SMAX
break
end
c = haccept int lf 60000000000
if ge c 0
acsconn c cs io d pa sv
nc = add nc 1
end
end
x = fclose int lf
end

note stub PORT garbage|ref SUITEDIR [COUNT]: serve the control replies on 127.0.0.1:PORT, COUNT connections
fn cmdstub to void
na = ulong argcnt
if and ne na 5 ne na 6
exit 2
end
pa = new uchar PAN 0
sv = new ulong SVN 0
n = acgeta 2 pa PB
put sv SPORT acudec view part pa PB n
if or eq get sv SPORT 0 gt get sv SPORT 65535
exit 2
end
n = acgeta 3 pa PB
put sv SOP 0
if heq view part pa PB n sgarbage
put sv SOP 1
end
if heq view part pa PB n sref
put sv SOP 2
end
if eq get sv SOP 0
exit 2
end
put sv SSDL acgeta 4 pa PSD
put sv SMAX 1000000000
if eq na 6
n = acgeta 5 pa PB
put sv SMAX acudec view part pa PB n
end
acsserve pa sv
end

note ======== IFEval registration and self-test (PREREG.md section 5)

text kours ",\"ours\":"
text kresp1 ",\"response\":\""
text kkey1 "{\"key\":"
text kifsel "ifsel supported="
text kifreg " registered="
text kself "selftest rows="
text kselfm " mismatches="

note acifsel1: the upstream row in it: whether it is supported, and its ref response's verdict into the
note RESP line at o (from p); the new end. sv[SOP] gets 1 when the row is registered.
fn acifsel1 it view uchar ILN tp view uint TPN o edit uchar FBN p ulong sv edit ulong SVN to ulong
c = new uchar 65536 0
put sv SOP 0
if not acifsup it tp
ret p
end
l = acifref c it tp
if gt l len c
ret p
end
v = acifrow view part c 0 l it tp
if eq v 0
put sv SOP 1
end
q = acapp o p kkey1
q = acdec o q ackn it tp 0 kkey
q = acapp o q kours
q = acdec o q v
q = acapp o q kresp1
q = acesc o q view part c 0 l
q = acapp o q kendo
ret acapp o q knl
end

note acfput: s appended to fd; exits 4 when the write fails
fn acfput fd long s view uchar * to void
if not acwrite fd s
exit 4
end
end

note acifsl: every row of the sv[90]-byte file f: supported rows' RESP lines to fd sv[92], registered
note rows verbatim to fd sv[91]; the counts into sv[93] and sv[94]
fn acifsl f view uchar FIL it edit uchar ILN tp edit uint TPN o edit uchar FBN sv edit ulong SVN to void
p = ulong 0
put sv 93 0
put sv 94 0
while lt p get sv 90 bound 999999
s = p
p = acline f get sv 90 p it sv
if eq get sv SILN 0
continue
end
if not acpar it tp sv
exit 4
end
q = acifsel1 it tp o 0 sv
if gt q 0
put sv 93 add get sv 93 1
if gt q len o
exit 4
end
acfput long get sv 92 view part o 0 q
end
if eq get sv SOP 1
put sv 94 add get sv 94 1
acfput long get sv 91 view part f s get sv SILN
acfput long get sv 91 knl
end
end
end

note ifsel UPSTREAM OUT RESP: OUT = the registered rows (verbatim), RESP = every supported row's reference
note response with this runner's verdict (0 pass), for tools/ifeval_oracle.py
fn cmdifsel to void
if ne argcnt 5
exit 2
end
pa = new uchar PAN 0
sv = new ulong SVN 0
f = new uchar FIL 0
it = new uchar ILN 0
tp = new uint TPN 0
o = new uchar FBN 0
n = acgeta 2 pa PB
r = acreadf view part pa PB n f
if lt r 0
exit 4
end
n = acgeta 3 pa PB
fo = fopen pa PB n 524865 420
n = acgeta 4 pa add PB 1024
fr = fopen pa add PB 1024 n 524865 420
if or lt fo 0 lt fr 0
exit 4
end
put sv 90 ulong r
put sv 91 ulong fo
put sv 92 ulong fr
acifsl f it tp o sv
x = fclose int fo
x2 = fclose int fr
q = acapp o 0 kifsel
q = acdec o q get sv 93
q = acapp o q kifreg
q = acdec o q get sv 94
q = acapp o q knl
acout view part o 0 q
end

note acself1: one self-test line (an IFEval row plus response and expect); whether this runner agrees
fn acself1 it view uchar ILN tp view uint TPN to bool
b = new uchar 262144 0
l = acstr it tp acmem it tp 0 kresp b
if lt l 0
exit 4
end
v = acifrow view part b 0 ulong l it tp
ret eq eq v 0 actrue it tp 0 kexpect
end

note selftest FILE: every line's verdict must equal its expect; prints the counts, exits 1 on a mismatch
fn cmdself to void
if ne argcnt 3
exit 2
end
pa = new uchar PAN 0
sv = new ulong SVN 0
f = new uchar FIL 0
it = new uchar ILN 0
tp = new uint TPN 0
o = new uchar 256 0
n = acgeta 2 pa PB
r = acreadf view part pa PB n f
if lt r 0
exit 4
end
p = ulong 0
nl = ulong 0
nm = ulong 0
while lt p ulong r bound 999999
p = acline f ulong r p it sv
if eq get sv SILN 0
continue
end
if not acpar it tp sv
exit 4
end
if not acifsup it tp
exit 4
end
nl = add nl 1
if not acself1 it tp
nm = add nm 1
q = acapp o 0 kfail
q = acapp o q ksp
q = acdec o q ackn it tp 0 kkey
q = acapp o q knl
acout view part o 0 q
end
end
q = acapp o 0 kself
q = acdec o q nl
q = acapp o q kselfm
q = acdec o q nm
q = acapp o q knl
acout view part o 0 q
if or ne nm 0 eq nl 0
exit 1
end
end

text crun "run"
text cstub "stub"
text cifsel "ifsel"
text cself "selftest"
text csum "sum"
text cpair "pair"
text cfill "fill"

fn main to int
b = new uchar 64 0
if lt argcnt 2
exit 2
end
r = argread 1 b 0 64
if or lt r 1 gt r 64
exit 2
end
if heq view part b 0 ulong r crun
cmdrun
end
if heq view part b 0 ulong r cstub
cmdstub
ret 0
end
if heq view part b 0 ulong r cifsel
cmdifsel
ret 0
end
if heq view part b 0 ulong r cself
cmdself
ret 0
end
if heq view part b 0 ulong r csum
cmdsum
end
if heq view part b 0 ulong r cpair
cmdpair
end
if heq view part b 0 ulong r cfill
cmdfill
end
ret 2
end
