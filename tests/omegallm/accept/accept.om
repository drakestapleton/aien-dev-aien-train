note ======== byte helpers

note acat: s[i], or 256 past the end (and/or evaluate both sides, so guarded reads go through here)
fn acat s view uchar * i ulong to ulong
if ge i len s
ret 256
end
ret ulong get s i
end

note acapp: s copied to o[p..]; the new end, or len o + 1 when it does not fit (sticky)
fn acapp o edit uchar * p ulong s view uchar * to ulong
n = len s
if gt add p n len o
ret add len o 1
end
for i ulong n
put o add p i get s i
end
ret add p n
end

note acdec: v in decimal at o[p..]
fn acdec o edit uchar * p ulong v ulong to ulong
d = new uchar 24 0
k = ulong 0
x = v
for i ulong 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
if gt add p k len o
ret add len o 1
end
for j ulong k
put o add p j get d sub sub k j 1
end
ret add p k
end

note acf4: a non-negative f64 with four decimals at o[p..]
fn acf4 o edit uchar * p ulong v f64 to ulong
w = v
if lt w 0.0
w = 0.0
end
if gt w 1000000000.0
w = 1000000000.0
end
u = ulong add mul w 10000.0 0.5
q = acdec o p div u 10000
if ge q len o
ret add len o 1
end
put o q 46
f = rem u 10000
q = add q 1
q = acdec o q div f 1000
q = acdec o q rem div f 100 10
q = acdec o q rem div f 10 10
ret acdec o q rem f 10
end

note acesc: s JSON-escaped (quote, backslash, control bytes) at o[p..]
fn acesc o edit uchar * p ulong s view uchar * to ulong
q = p
lo = len o
for i ulong len s
if gt add q 6 lo
ret add lo 1
end
c = get s i
if or eq c 34 eq c 92
put o q 92
put o add q 1 c
q = add q 2
continue
end
if eq c 10
put o q 92
put o add q 1 110
q = add q 2
continue
end
if eq c 13
put o q 92
put o add q 1 114
q = add q 2
continue
end
if eq c 9
put o q 92
put o add q 1 116
q = add q 2
continue
end
if lt c 32
put o q 92
put o add q 1 117
put o add q 2 48
put o add q 3 48
put o add q 4 hhexd ulong shr c 4
put o add q 5 hhexd ulong and c 15
q = add q 6
continue
end
put o q c
q = add q 1
end
ret q
end

note acmat: whether nd occurs in h at j (ASCII case-folded when ci); the caller keeps j + len nd <= len h
fn acmat h view uchar * j ulong nd view uchar * ci bool to bool
for k ulong len nd
a = get h add j k
b = get nd k
if ci
a = hlow a
b = hlow b
end
if ne a b
ret false
end
end
ret true
end

note acfind: first index >= from where nd occurs in h (ASCII case-folded when ci), else len h
fn acfind h view uchar * nd view uchar * from ulong ci bool to ulong
if or eq len nd 0 gt len nd len h
ret len h
end
e = sub len h len nd
j = from
while le j e bound 999999
if acmat h j nd ci
ret j
end
j = add j 1
end
ret len h
end

note acnoc: non-overlapping occurrences of nd in h, scanning left to right
fn acnoc h view uchar * nd view uchar * ci bool to ulong
c = ulong 0
p = ulong 0
n = len h
while lt p n bound 999999
i = acfind h nd p ci
if ge i n
break
end
c = add c 1
p = add i len nd
end
ret c
end

fn acpfx s view uchar * t view uchar * ci bool to bool
if lt len s len t
ret false
end
for i ulong len t
a = get s i
b = get t i
if ci
a = hlow a
b = hlow b
end
if ne a b
ret false
end
end
ret true
end

fn acsfx s view uchar * t view uchar * ci bool to bool
if lt len s len t
ret false
end
o = sub len s len t
for i ulong len t
a = get s add o i
b = get t i
if ci
a = hlow a
b = hlow b
end
if ne a b
ret false
end
end
ret true
end

note acu8: the code point at s[i] as cp shl 3 | its byte length; a malformed byte stands for itself
fn acu8 s view uchar * i ulong to ulong
c = acat s i
if lt c 128
ret or shl c 3 1
end
k = ulong 0
cp = ulong 0
if eq and c 224 192
k = 2
cp = and c 31
end
if eq and c 240 224
k = 3
cp = and c 15
end
if eq and c 248 240
k = 4
cp = and c 7
end
if eq k 0
ret or shl c 3 1
end
for j ulong sub k 1
d = acat s add add i j 1
if ne and d 192 128
ret or shl c 3 1
end
cp = or shl cp 6 and d 63
end
ret or shl cp 3 k
end

note acisws: Python str.isspace for one code point
fn acisws cp ulong to bool
if and ge cp 9 le cp 13
ret true
end
if and ge cp 28 le cp 32
ret true
end
if or eq cp 133 eq cp 160
ret true
end
if or eq cp 5760 and ge cp 8192 le cp 8202
ret true
end
if or or eq cp 8232 eq cp 8233 or eq cp 8239 eq cp 8287
ret true
end
ret eq cp 12288
end

note acisw: Python re \w for one code point, approximated by ranges (PREREG.md deviation D2)
fn acisw cp ulong to bool
if lt cp 128
if or and ge cp 48 le cp 57 eq cp 95
ret true
end
c = or cp 32
ret and ge c 97 le c 122
end
if lt cp 256
if or or eq cp 170 eq cp 178 or eq cp 179 eq cp 181
ret true
end
if or or eq cp 185 eq cp 186 and ge cp 188 le cp 190
ret true
end
if lt cp 192
ret false
end
ret and ne cp 215 ne cp 247
end
if and ge cp 768 le cp 879
ret false
end
if and ge cp 8192 le cp 8303
ret false
end
if and ge cp 8352 le cp 8399
ret false
end
if and ge cp 8592 le cp 11263
ret false
end
if or and ge cp 12288 le cp 12292 and ge cp 12296 le cp 12320
ret false
end
if or and ge cp 65024 le cp 65103 and ge cp 65280 le cp 65295
ret false
end
if or and ge cp 65306 le cp 65312 and ge cp 57344 le cp 63743
ret false
end
if and ge cp 126976 le cp 129791
ret false
end
ret true
end

note acwsat: byte length of the whitespace code point at s[i], else 0
fn acwsat s view uchar * i ulong to ulong
if ge i len s
ret 0
end
x = acu8 s i
if acisws shr x 3
ret and x 7
end
ret 0
end

note acstrip: Python str.strip bounds of s as start shl 32 | end
fn acstrip s view uchar * to ulong
n = len s
a = ulong 0
while lt a n bound 999999
w = acwsat s a
if eq w 0
break
end
a = add a w
end
b = n
while gt b a bound 999999
q = sub b 1
while and gt q a eq and acat s q 192 128 bound 8
q = sub q 1
end
x = acu8 s q
if or ne add q and x 7 b not acisws shr x 3
break
end
b = q
end
ret or shl a 32 b
end

fn acsa x ulong to ulong
ret shr x 32
end

fn acsb x ulong to ulong
ret and x 4294967295
end

fn acblank s view uchar * to bool
x = acstrip s
ret eq acsa x acsb x
end

note acwords: the number of maximal \w runs in s (nltk RegexpTokenizer \w+, as IFEval counts words)
fn acwords s view uchar * to ulong
n = len s
c = ulong 0
inw = false
i = ulong 0
while lt i n bound 999999
x = acu8 s i
w = acisw shr x 3
if and w not inw
c = add c 1
end
inw = w
i = add i and x 7
end
ret c
end

note acwbef: whether the code point ending at s[i) is a \w character
fn acwbef s view uchar * i ulong to bool
if eq i 0
ret false
end
q = sub i 1
while and gt q 0 eq and acat s q 192 128 bound 8
q = sub q 1
end
x = acu8 s q
if ne add q and x 7 i
ret false
end
ret acisw shr x 3
end

fn acwat s view uchar * i ulong to bool
if ge i len s
ret false
end
ret acisw shr acu8 s i 3
end

note acwhole: whether w occurs in s as a whole word (re \bw\b, case-folded when ci)
fn acwhole s view uchar * w view uchar * ci bool to bool
n = len s
p = ulong 0
while lt p n bound 999999
i = acfind s w p ci
if ge i n
ret false
end
if and not acwbef s i not acwat s add i len w
ret true
end
p = add i 1
end
ret false
end

note acwrite: all of s to fd
fn acwrite fd long s view uchar * to bool
o = ulong 0
n = len s
while lt o n bound 999999
r = write int fd s o sub n o
if le r 0
ret false
end
o = add o ulong r
end
ret true
end

note acreadf: the file at path p (relative or absolute) into b; its length, or a negative errno / -1 if it does not fit
fn acreadf p view uchar * b edit uchar * to long
fd = fopen p 0 len p 524288 0
if lt fd 0
ret fd
end
o = ulong 0
for i ulong 16777216
if ge o len b
c = fclose int fd
ret -1
end
r = read int fd b o sub len b o
if lt r 0
c = fclose int fd
ret r
end
if eq r 0
break
end
o = add o ulong r
end
c = fclose int fd
ret long o
end

note acwfile: s written to a new file at path p
fn acwfile p view uchar * s view uchar * to bool
fd = fopen p 0 len p 524865 420
if lt fd 0
ret false
end
ok = acwrite fd s
c = fclose int fd
ret ok
end

note acout: s to stdout
fn acout s view uchar * to void
x = acwrite 1 s
end

note ======== JSON access over a json.om tape

note acmem: the value token of member key in object o of src, else jsnone
fn acmem src view uchar * tp view uint TPN o ulong key view uchar * to ulong
if eq o jsnone
ret jsnone
end
if ne js_type tp o jsobj
ret jsnone
end
k = js_first tp o
for i ulong js_nkids tp o
if eq k jsnone
break
end
if js_streq src js_off tp k key
ret add k 1
end
k = js_mnext tp k
end
ret jsnone
end

note acel: element i of array a, else jsnone
fn acel tp view uint TPN a ulong i ulong to ulong
if eq a jsnone
ret jsnone
end
if ne js_type tp a jsarr
ret jsnone
end
e = js_first tp a
for j ulong i
if eq e jsnone
ret jsnone
end
e = js_enext tp e
end
ret e
end

fn acnext tp view uint TPN e ulong to ulong
if eq e jsnone
ret jsnone
end
ret js_enext tp e
end

fn actype tp view uint TPN t ulong to ulong
if eq t jsnone
ret 0
end
ret js_type tp t
end

note acstr: string token t decoded into ob; its length, or -1 when t is not a string
fn acstr src view uchar * tp view uint TPN t ulong ob edit uchar * to long
ty = actype tp t
if and ne ty jsstr ne ty jskey
ret -1
end
ret js_sget src js_off tp t ob
end

note acnum: number token t as ulong (0 when absent or not a number)
fn acnum src view uchar * tp view uint TPN t ulong to ulong
if ne actype tp t jsnum
ret 0
end
ret js_tou src js_off tp t
end

note ackn: the number at member key of object o
fn ackn src view uchar * tp view uint TPN o ulong key view uchar * to ulong
ret acnum src tp acmem src tp o key
end

fn actrue src view uchar * tp view uint TPN o ulong key view uchar * to bool
ret eq actype tp acmem src tp o key jstrue
end

