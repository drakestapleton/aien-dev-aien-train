note SPDX-License-Identifier: AGPL-3.0-only
note ckforge: forge one adtrain.ck variant with a VALID FNV-1a 64 checksum, so
note each structural check of native/adtrain/mlp.om ckcheck is reached on its own
note (a plain byte flip only ever reaches the checksum check).
note stdin: one ASCII mode byte, then the 536-byte image. stdout: 536 bytes.
note Image (docs/adtrain/CONTRACT.md): u64 LE words 0 magic, 1 version, 2 step,
note 3 count, 4 lr bits, 5 loss bits, 6 data hash, 7 zero, 8..65 params, 66 FNV.
note Modes, each changing one field and then re-checksumming bytes 0..527:
note   0 nothing (positive control: must reproduce the input byte for byte)
note   m magic byte 0 xor 1      v version 2        s step 201    S step 200
note   c count 57                l lr bits + 1      p word 7 = 1
note   u param 0 bit 32 set      n param 0 = NaN    i param 0 = +Inf
note   h data hash xor 1
note   x checksum byte 528 xor 1, NOT re-checksummed (checksum-only image)
note Exits: 0 done, 74 I/O, 75 bad input or mode.
note Independent of mlp.om: its own FNV-1a 64 (offset 14695981039346656037,
note prime 1099511628211) and its own word codec.
global CB uchar 1024
global CN ulong 1

fn slurp to void
p = ulong 0
reading = true
while reading bound 1025
if eq p 1024
exit 75
end
n = read 0 CB p sub 1024 p
if eq n 0
reading = false
else
if lt n 0
exit 74
end
p = add p ulong n
end
end
put CN 0 p
end

note word w of the image (the image starts at CB 1, after the mode byte)
fn wget w ulong to ulong
v = ulong 0
b = add 1 mul w 8
for i ulong 8
v = or v shl ulong get CB add b i mul i 8
end
ret v
end

fn wput w ulong v ulong to void
b = add 1 mul w 8
for i ulong 8
put CB add b i uchar and shr v mul i 8 255
end
end

fn fnv to ulong
h = ulong 14695981039346656037
for i ulong 528
h = mul xor h ulong get CB add 1 i 1099511628211
end
ret h
end

note apply mode m; returns false for an unknown mode
fn apply m uchar to bool
if eq m 48
ret true
end
if eq m 109
put CB 1 xor get CB 1 1
ret true
end
if eq m 118
wput 1 2
ret true
end
if eq m 115
wput 2 201
ret true
end
if eq m 83
wput 2 200
ret true
end
if eq m 99
wput 3 57
ret true
end
if eq m 108
wput 4 add wget 4 1
ret true
end
if eq m 112
wput 7 1
ret true
end
if eq m 117
wput 8 or wget 8 4294967296
ret true
end
if eq m 110
wput 8 2143289344
ret true
end
if eq m 105
wput 8 2139095040
ret true
end
if eq m 104
wput 6 xor wget 6 1
ret true
end
ret false
end

fn main to int
slurp
if ne get CN 0 537
ret 75
end
m = get CB 0
if eq m 120
put CB 529 xor get CB 529 1
else
if not apply m
ret 75
end
wput 66 fnv
end
o = ulong 0
while lt o 536 bound 537
w = write 1 CB add 1 o sub 536 o
if le w 0
ret 74
end
o = add o ulong w
end
ret 0
end
