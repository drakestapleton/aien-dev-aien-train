note SPDX-License-Identifier: AGPL-3.0-only
note omegallm lio.om (aien-train#52): the Linux platform unit, the only unit that uses host words.
note It is concatenated last for targets aarch64 and x86linux; eio.om replaces it for x86efi. Both
note define the same functions: oargc, oargr, oflush, ocwopen, ocwput, ocwend, ofsz, ogradw, ocsinit,
note ocsg, ocsp, odread, owflush, owopen, owclose, ooffrd, oprd, obmsave and main. Every other unit is
note free of host words.
global owfd int 2
global opth uchar 2100
global opk uchar 4200
global ocfd int 1
global opp uchar 8
global ost uchar 8
global owrf int 64
global owpd int 64

note the argument count (argv[0] included)
fn oargc to ulong
ret ulong argcnt
end

note argv[i] into oarg (at most 4096 bytes); returns the argread result (negative: no such argument)
fn oargr i ulong to long
ret argread i oarg 0 4096
end

fn main to int
if lt oargc 2
exit 2
end
ret ocmd
end

fn oflush to void
n = get oon 0
p = ulong 0
while lt p n bound 4097
w = write 1 oout p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
put oon 0 0
end

note v1 checkpoint stream (ckpt.om): open PATH.tmp for the path in argv[ai] (created, emptied)
fn ocwopen ai ulong to void
pl = oargp ai
if gt pl 2000
exit 2
end
for i ulong pl
put opth i get oarg i
end
put opth pl 46
put opth add pl 1 116
put opth add pl 2 109
put opth add pl 3 112
fd = int fopen opth 0 add pl 4 577 420
if lt fd 0
exit 70
end
put ocfd 0 fd
end

note write ock[0 .. n) at byte position pos of the open PATH.tmp
fn ocwput pos ulong n ulong to void
fd = get ocfd 0
p = ulong 0
while lt p n bound 999999
w = pwrite fd ock p sub n p long add pos p
if le w 0
exit 70
end
p = add p ulong w
end
end

note fsync and close PATH.tmp, then rename it onto the path in argv[ai]
fn ocwend ai ulong to void
fd = get ocfd 0
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
ocrename oargp ai
end

note rename opth[0 .. pl+4) to opth[0 .. pl) via a packed two-path list
fn ocrename pl ulong to void
put opk 0 2
put opk 1 0
put opk 2 uchar and add pl 4 255
put opk 3 uchar shr add pl 4 8
for i ulong add pl 4
put opk add 4 i get opth i
end
q = add 8 pl
put opk q uchar and pl 255
put opk add q 1 uchar shr pl 8
for j ulong pl
put opk add add q 2 j get opth j
end
r = renames opk 0 add add q 2 pl 0
if ne r 0
exit 70
end
end

note size in bytes of the file named by argv[ai] (seek to its end)
fn ofsz ai ulong to ulong
n = oargp ai
fd = int fopen oarg 0 n 0 0
if lt fd 0
exit 70
end
sz = fseek fd 0 2
if lt sz 0
exit 70
end
if ne fclose fd 0
exit 70
end
ret ulong sz
end

note cold store (CONTRACT-V3 section 2): GRD and the Adam moments, 3 P values at the CONTRACT-V3
note maxima (3 29995392 -> 89986176 values, 719889408 bytes), in one private anonymous mapping made
note on first use (mapnew prot 3 read/write, flags 34 private|anonymous; zero-filled, and inherited
note copy-on-write by the gradient workers). A failed mapping is an I/O refusal (exit 70).
const OCSN ulong 89986176
global ocsh long 1
global ocsf ulong 1

note capacity of the cold store in f64 values (maps it on the first call)
fn ocsinit to ulong
if eq get ocsf 0 0
h = mapnew int -1 0 mul OCSN 8 3 34
if lt h 0
exit 70
end
put ocsh 0 h
put ocsf 0 1
end
ret OCSN
end

fn ocsg i ulong to f64
ret bitcast f64 mapget get ocsh 0 mul i 8 8
end

fn ocsp i ulong v f64 to void
x = mapset get ocsh 0 mul i 8 8 bitcast ulong v
end

note gradient of the step loss with K = og[45] processes (CONTRACT-V1 section 5.1). K = 1 is
note ograd. For K > 1 the parent forks workers w = 1 .. K-1, each with its own pipe; worker w
note computes blocks w G/K .. (w+1) G/K - 1 (each from zero into its own BLK copy), writes each
note block's f64 bits and then its sequences' losses to the pipe and exits 0. The parent computes
note blocks 0 .. G/K - 1 itself, then reads the workers in ascending w, adding each block into GRD
note in ascending j as ograd does, and the losses into olos; olsum sums them in ascending b. So the
note gradient and loss are the same bits for every K. A failed fork, pipe, read or a worker that
note does not exit 0 is an I/O refusal (exit 70).
fn ogradw to f64
k = get og 45
if le k 1
ret ograd
end
per = div get og 44 k
oflush
for w ulong sub k 1
ofork1 w per
end
for j ulong per
oblkc j
ogfold eq j 0
end
for w ulong sub k 1
ojoin1 w per
end
ret olsum
end

note fork worker w (blocks (w+1) per .. (w+2) per - 1); keep its pipe read end and pid
fn ofork1 w ulong per ulong to void
r = pipefds opp 0 8 0
if ne r 0
exit 70
end
rf = int or ulong get opp 0 shl ulong get opp 1 8
wf = int or ulong get opp 4 shl ulong get opp 5 8
pid = fork
if lt pid 0
exit 70
end
if eq pid 0
c = fclose rf
owork wf mul add w 1 per per
exit 0
end
c2 = fclose wf
put owrf w rf
put owpd w int pid
end

note read worker w's blocks into GRD in ascending j and its losses into olos, then reap it
fn ojoin1 w ulong per ulong to void
rf = get owrf w
for j ulong per
orecvb rf
ogadd
end
r = div get og 6 get og 44
m = mul per r
orecvl rf mul add w 1 m m
c = fclose rf
pd = get owpd w
x = waitpid pd ost 0 4 0
if ne x long pd
exit 70
end
s0 = get ost 0
s1 = get ost 1
if ne or s0 s1 0
exit 70
end
end

note worker: blocks j0 .. j0 + n - 1 into BLK (gradient pool from P), each sent as it is done, then
note the losses of its sequences
fn owork fd int j0 ulong n ulong to void
for t ulong n
oblkc add j0 t
osendb fd
end
r = div get og 6 get og 44
b0 = mul j0 r
m = mul n r
for i ulong m
ocput8 mul i 8 bitcast ulong get olos add b0 i
end
owall fd mul m 8
end

fn owall fd int n ulong to void
p = ulong 0
while lt p n bound 999999
w = write fd ock p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
end

fn ordall fd int n ulong to void
p = ulong 0
while lt p n bound 999999
r = read fd ock p sub n p
if le r 0
exit 70
end
p = add p ulong r
end
end

note send BLK (gradient pool [P .. 2P)) in chunks of OCKC values
fn osendb fd int to void
p = get og 8
nc = div add p sub OCKC 1 OCKC
for c ulong nc
i = mul c OCKC
m = sub p i
if gt m OCKC
m = OCKC
end
ocenc 4 i m
owall fd mul m 8
end
end

note receive one block into BLK (gradient pool [P .. 2P))
fn orecvb fd int to void
p = get og 8
nc = div add p sub OCKC 1 OCKC
for c ulong nc
i = mul c OCKC
m = sub p i
if gt m OCKC
m = OCKC
end
ordall fd mul m 8
ocdecb add p i m
end
end

note receive n losses into olos[b0 ..)
fn orecvl fd int b0 ulong n ulong to void
ordall fd mul n 8
for i ulong n
put olos add b0 i bitcast f64 ocget8 mul i 8
end
end

note Read the file named by argv[i] into od0/od1; refuse more than ODCAP bytes (exit 21).
note Each read pass adds at least one byte or ends, so ODCAP + 2 passes suffice: 64 outer passes
note of at most 999999 inner passes each cover 2^25 + 2.
fn odread i ulong to ulong
n = oargp i
fd = int fopen oarg 0 n 0 0
if lt fd 0
exit 70
end
p = ulong 0
dn = false
for o ulong 64
q = ulong 0
while and not dn lt q 999999 bound 999999
q = add q 1
r = long 0
if lt p ODHALF
r = read fd od0 p sub ODHALF p
else
if lt p ODCAP
r = read fd od1 sub p ODHALF sub ODCAP p
else
r = read fd ochk 0 1
end
end
if lt r 0
exit 70
end
if eq r 0
dn = true
else
p = add p ulong r
if gt p ODCAP
exit 21
end
end
end
if dn
break
end
end
if not dn
exit 70
end
c = fclose fd
put odn 0 p
ret p
end

note prep output: two buffered writers (k = 0 TRAIN, k = 1 HELD).
fn owflush k ulong to void
n = get owbn k
fd = get owfd k
p = ulong 0
while lt p n bound 65537
w = long 0
if eq k 0
w = write fd owb0 p sub n p
else
w = write fd owb1 p sub n p
end
if le w 0
exit 70
end
p = add p ulong w
end
put owbn k 0
end

fn owopen k ulong i ulong to void
n = oargp i
fd = int fopen oarg 0 n 577 420
if lt fd 0
exit 70
end
put owfd k fd
put owbn k 0
end

fn owclose k ulong to void
owflush k
fd = get owfd k
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
end

note read argv[ai] (B little-endian u64 offsets) into ochk; exit 21 unless it holds exactly 8 B bytes
fn ooffrd ai ulong to void
n = oargp ai
fd = int fopen oarg 0 n 0 0
if lt fd 0
exit 70
end
p = ulong 0
dn = false
while not dn bound 70000
r = read fd ochk p sub 65536 p
if lt r 0
exit 70
end
if eq r 0
dn = true
else
p = add p ulong r
if ge p 65536
exit 21
end
end
end
c = fclose fd
if ne p mul 8 get og 6
exit 21
end
end


note v1 positioned read (CONTRACT-V1 section 3): read up to n bytes of the file named by argv[ai],
note from byte pos, into opw[off .. off + n). The file is opened and closed on every call. Returns
note the bytes read: n, fewer only when the file ends first, 0 at or after its end. Exit 70 on an
note I/O error, 2 on a bad argument; off + n over len opw traps 3. Each pread pass adds at least one
note byte or ends, so n + 1 <= 2097153 passes suffice: 3 outer passes of at most 999999 inner ones.
fn oprd ai ulong pos ulong off ulong n ulong to ulong
pl = oargp ai
fd = int fopen oarg 0 pl 0 0
if lt fd 0
exit 70
end
p = ulong 0
dn = false
for o ulong 3
while and not dn lt p n bound 999999
r = pread fd opw add off p sub n p long add pos p
if lt r 0
exit 70
end
if eq r 0
dn = true
else
p = add p ulong r
end
end
end
if ne fclose fd 0
exit 70
end
ret p
end

note v1 (CONTRACT-V1 section 7): write obm[0 .. n) (bpe.om) to the path in argv[ai] as ocwrite does:
note PATH.tmp, fsync, rename
fn obmsave ai ulong n ulong to void
pl = oargp ai
if gt pl 2000
exit 2
end
for i ulong pl
put opth i get oarg i
end
put opth pl 46
put opth add pl 1 116
put opth add pl 2 109
put opth add pl 3 112
fd = int fopen opth 0 add pl 4 577 420
if lt fd 0
exit 70
end
p = ulong 0
while lt p n bound 999999
w = write fd obm p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
ocrename pl
end
