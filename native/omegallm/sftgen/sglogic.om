note ======== main: sftgen SEED COUNT OUT.jsonl [WORLD]

fn sgargu i ulong to ulong
r = argread i sgab 0 4096
if or le r 0 gt r 4096
exit 2
end
n = ulong r
v = ulong 0
k = ulong 0
while lt k n bound 4097
c = get sgab k
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 ulong sub c 48
k = add k 1
end
ret v
end

fn sgopen i ulong to long
r = argread i sgab 0 4096
if or le r 0 gt r 4096
exit 2
end
fd = fopen sgab 0 ulong r 577 420
if lt fd 0
exit 70
end
ret fd
end

fn main to int
c = argcnt
if or lt c 4 gt c 5
exit 2
end
seed = sgargu 1
cnt = sgargu 2
if or eq cnt 0 gt cnt 999998
exit 2
end
put sgst 2 seed
put sgst 1 ulong sgopen 3
put sgst 5 0
if eq c 5
put sgst 4 ulong sgopen 4
put sgst 5 1
end
i = ulong 0
while lt i cnt bound 999999
put sgst 6 i
sgconv
i = add i 1
end
sgoflush
if eq get sgst 5 1
sgwflush
x = fclose int get sgst 4
end
x = fclose int get sgst 1
ret 0
end
