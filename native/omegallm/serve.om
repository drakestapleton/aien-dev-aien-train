text sem18 "stop must be null, a string or an array of at most 8 strings of 1 to 128 bytes"
text sem19 "top_k must be an integer from -1 to 999999 (-1 and 0 turn it off)"
text sem20 "top_p must be a number from 0 to 1 without exponent (resolution 0.000001; 0 keeps only the most probable token)"
text sem21 "tools must be an array of at most 128 {\"type\":\"function\",\"function\":{\"name\":string of 1 to 64 bytes}} objects"
text sem22 "tool_choice must be \"none\", \"auto\", \"required\" or a {\"type\":\"function\"} object"
text sem23 "tool_calls must be an array of {\"function\":{\"name\":string,\"arguments\":string or object}} objects"
text sem24 "ollm_test_output (a string of at most 16384 bytes), ollm_test_delay_ms (0 to 10000), ollm_test_info, ollm_test_cold and ollm_test_serial (booleans) need a server started with test=1"
text sem25 "the request body has over 65532 JSON tokens (values, keys and closers), the JSON parser's limit"
text sem26 "message role must be system, developer, user, assistant or tool (CHAT1 template)"
text sem11a "prompt is "
text sem11b " tokens including the start token; the context window is "
text sem11c " tokens, so no room is left for output"

note forced tokens (test=1), top_k/top_p marks, stop lengths, tool name lengths, tool call spans
global svft ulong 4096
global svmk uchar 4096
global svstl ulong 8
global svtnl ulong 128
global svtcx ulong 32
note pending connections (svwait): descriptor + 1 (0 free), accept time, record slot; pollfd records;
note the svgone peek byte
global svpfd ulong 8
global svpat ulong 8
global svpix ulong 8
global svpl uchar 72
global svpk uchar 1
note CHAT1 (serve.om section CHAT1): svpt prompt tokens, svpm their loss mask, svpn 0 count (counting on past the 65536 stored) 1
note the mask of the next token; svtcp the content positions of generated <|tool_call|> tokens
global svpt ulong 65536
global svpm uchar 65536
global svpn ulong 4
global svtcp ulong 16

note ======== small byte helpers over wb

note svmcat: copy text t into wb at p, at most up to e; the next p
fn svmcat wb edit uchar 1073664 p ulong e ulong t view uchar * to ulong
q = p
for i ulong len t
if ge q e
ret q
end
put wb q get t i
q = add q 1
end
ret q
end

note svmdec: v in decimal into wb at p (at most 20 digits, up to e); the next p
fn svmdec wb edit uchar 1073664 p ulong e ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for k ulong sub 20 i
if ge q e
ret q
end
put wb q get d add i k
q = add q 1
end
ret q
end

note svat: whether the content at p starts with the pattern wb[po, po + pl) (p + pl <= content)
fn svat wb edit uchar 1073664 p ulong po ulong pl ulong to bool
for i ulong pl
if ne get wb add 8192 add p i get wb add po i
ret false
end
end
ret true
end

note svfind: the first position >= s where the pattern wb[po, po + pl) lies wholly in the content
note [0, n), or jsnone
fn svfind wb edit uchar 1073664 s ulong n ulong po ulong pl ulong to ulong
p = s
while le add p pl n bound 65537
if svat wb p po pl
ret p
end
p = add p 1
end
ret jsnone
end

note svpsuf: the longest k < pl, k <= n - lo, with content [n - k, n) a prefix of the pattern
fn svpsuf wb edit uchar 1073664 lo ulong n ulong po ulong pl ulong to ulong
k = sub pl 1
if lt sub n lo k
k = sub n lo
end
m = k
for it ulong m
if svat wb sub n k po k
ret k
end
k = sub k 1
end
ret 0
end

fn svisws c ulong to bool
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note svtrim: h moved back over trailing whitespace of the content, not below lo
fn svtrim wb edit uchar 1073664 lo ulong h ulong to ulong
if le h lo
ret h
end
q = h
for it ulong sub h lo
if not svisws ulong get wb add 8191 q
break
end
q = sub q 1
end
ret q
end

note svskws: p moved over whitespace of the content, not past n
fn svskws wb edit uchar 1073664 p ulong n ulong to ulong
q = p
for it ulong sub n p
if not svisws ulong get wb add 8192 q
break
end
q = add q 1
end
ret q
end

note ======== UTF-8 (RFC 3629 section 4)

note svu8n: the sequence at a[p], with a[0 .. n) the bytes so far: 1 .. 4 its length when well
note formed; 0 when a[p .. n) is a proper prefix of a well-formed sequence; 8 + k when its maximal
note ill-formed subpart is k bytes (replaced by one U+FFFD)
fn svu8n a view uchar * p ulong n ulong to ulong
c = ulong get a p
if lt c 128
ret 1
end
k = svu8k c
if eq k 0
ret 9
end
for i ulong sub k 1
q = add p add i 1
if ge q n
ret 0
end
if not svu8ok c i ulong get a q
ret add 9 i
end
end
ret k
end

note svu8k: the sequence length a lead byte c >= 128 starts, 0 when it starts none
fn svu8k c ulong to ulong
if and ge c 194 le c 223
ret 2
end
if and ge c 224 le c 239
ret 3
end
if and ge c 240 le c 244
ret 4
end
ret 0
end

note svu8ok: whether b may be continuation byte i (0 the first) after lead byte c (RFC 3629 table)
fn svu8ok c ulong i ulong b ulong to bool
lo = ulong 128
hi = ulong 191
if eq i 0
if eq c 224
lo = 160
end
if eq c 237
hi = 159
end
if eq c 240
lo = 144
end
if eq c 244
hi = 143
end
end
ret and ge b lo le b hi
end

note svrepl: U+FFFD (EF BF BD) into the content at its end
fn svrepl wb edit uchar 1073664 sv edit ulong 64 to void
g = add 8192 get sv 13
put wb g 239
put wb add g 1 191
put wb add g 2 189
put sv 13 add get sv 13 3
end

note svclean: move the complete sequences of the raw bytes wb[0, sv12) to the content; fin 1 also
note replaces a cut tail. The rest moves to the front of the raw bytes.
fn svclean wb edit uchar 1073664 sv edit ulong 64 fin ulong to void
rn = get sv 12
p = ulong 0
for it ulong add rn 1
if ge p rn
break
end
r = svu8n wb p rn
if eq r 0
if eq fin 0
break
end
svrepl wb sv
p = rn
else
if gt r 8
svrepl wb sv
p = add p sub r 8
else
svmove wb add 8192 get sv 13 p r
put sv 13 add get sv 13 r
p = add p r
end
end
end
svmove wb 0 p sub rn p
put sv 12 sub rn p
end

note svmove: wb[d, d + n) = wb[s, s + n), copying forward (d <= s or the ranges apart)
fn svmove wb edit uchar 1073664 d ulong s ulong n ulong to void
for i ulong n
put wb add d i get wb add s i
end
end

note ======== responses

fn svstat cs edit ulong 320 io edit uchar 131072 code ulong t view uchar * to long
r = hrspst cs io code
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhend cs io 0 len t
r = hfe r hput cs io t
ret hfe r hwfin cs io
end

note svs503: the fixed server_busy error with Retry-After: 1
fn svs503 cs edit ulong 320 io edit uchar 131072 to long
r = hrspst cs io 503
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhname cs io svtra
r = hfe r hhval cs io svone
r = hfe r hhend cs io 0 len svt503
r = hfe r hput cs io svt503
ret hfe r hwfin cs io
end

note svsend: the writer's text ob[1040, 1040 + n) as a JSON response with status code
fn svsend cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 code ulong n ulong to long
r = hrspst cs io code
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhend cs io 0 n
r = hfe r hput cs io view part ob 1040 n
ret hfe r hwfin cs io
end

fn svwt ob edit uchar 409600 t view uchar * to void
js_wsbuf ob t 0 len t
end

note svemsg: the message of error code sv16 into wb[81920 ..); its length
fn svemsg wb edit uchar 1073664 sv edit ulong 64 to ulong
e = get sv 16
b = ulong 81920
z = ulong 82176
p = b
if eq e 1
p = svmcat wb p z sem1
end
if eq e 2
p = svmcat wb p z sem2
end
if eq e 3
p = svmcat wb p z sem3
end
if eq e 4
p = svmcat wb p z sem4
end
if eq e 5
p = svmcat wb p z sem5
end
if eq e 6
p = svmcat wb p z sem6a
p = svmdec wb p z get sv 23
p = svmcat wb p z sem6b
end
if eq e 7
p = svmcat wb p z sem7
end
if eq e 8
p = svmcat wb p z sem8
end
if eq e 9
p = svmcat wb p z sem9
end
if eq e 10
p = svmcat wb p z sem10
end
if eq e 11
p = svmcat wb p z sem11a
p = svmdec wb p z get sv 6
p = svmcat wb p z sem11b
p = svmdec wb p z get sv 19
p = svmcat wb p z sem11c
end
if eq e 12
p = svmcat wb p z sem12
end
if eq e 13
p = svmcat wb p z sem13
end
if eq e 14
p = svmcat wb p z sem14
end
if eq e 15
p = svmcat wb p z sem15
end
if eq e 16
p = svmcat wb p z sem16
end
ret sub svemsg2 wb e p z b
end

note svemsg2: the messages of error codes 17 .. 26 at p; the end
fn svemsg2 wb edit uchar 1073664 e ulong p ulong z ulong to ulong
if eq e 17
ret svmcat wb p z sem17
end
if eq e 18
ret svmcat wb p z sem18
end
if eq e 19
ret svmcat wb p z sem19
end
if eq e 20
ret svmcat wb p z sem20
end
if eq e 21
ret svmcat wb p z sem21
end
if eq e 22
ret svmcat wb p z sem22
end
if eq e 23
ret svmcat wb p z sem23
end
if eq e 24
ret svmcat wb p z sem24
end
if eq e 25
ret svmcat wb p z sem25
end
if eq e 26
ret svmcat wb p z sem26
end
ret p
end

fn svecode ob edit uchar 409600 e ulong to void
if eq e 1
svwt ob secjson
ret
end
if eq e 11
svwt ob secctx
ret
end
if or eq e 13 eq e 25
svwt ob secbig
ret
end
if eq e 14
svwt ob secnf
ret
end
if eq e 15
svwt ob secmeth
ret
end
if eq e 16
svwt ob secint
ret
end
svwt ob secreq
end

note svfail: {"error":{"message","type","param":null,"code"}} for error code sv16 with status st
fn svfail cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 st ulong to long
ob = new uchar 409600 0
put sv 21 st
m = svemsg wb sv
x = js_winit ob
js_wobj ob
svwt ob skerr
js_wobj ob
svwt ob skmsg
js_wsbuf ob wb 81920 m
svwt ob sktype
if eq st 500
svwt ob svsrv
else
svwt ob svinv
end
svwt ob skparam
js_wnull ob
svwt ob skcode
svecode ob get sv 16
js_wobje ob
js_wobje ob
n = js_wdone ob
if lt n 0
put cs HKEEP 0
ret hrsperr cs io 500
end
ret svsend cs io ob st ulong n
end

note svhead: {"id", "object" t, "created", "model" opened; the caller adds the rest
fn svhead ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 t view uchar * to void
x = js_winit ob
js_wobj ob
svwt ob skid
js_wsbuf ob wb 82176 get sv 15
svwt ob skobj
svwt ob t
svwt ob skcrt
js_wulong ob get sv 10
svwt ob skmodel
svwt ob svollm
end

fn svfr ob edit uchar 409600 sv edit ulong 64 to void
f = get sv 8
if eq f 1
svwt ob svstop
ret
end
if eq f 2
svwt ob svlen
ret
end
if eq f 3
svwt ob sktcall
ret
end
js_wnull ob
end

fn svusage ob edit uchar 409600 sv edit ulong 64 to void
svwt ob skusage
js_wobj ob
svwt ob skpt
js_wulong ob get sv 6
svwt ob skct
js_wulong ob get sv 7
svwt ob sktt
js_wulong ob add get sv 6 get sv 7
js_wobje ob
end

note svwcalls: the tool_calls array (idx 1 adds each call's index, as a stream delta does)
fn svwcalls ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 idx ulong to void
js_warr ob
for i ulong get sv 32
b = mul i 4
js_wobj ob
if eq idx 1
svwt ob skidx
js_wulong ob i
end
svwt ob skid
p = svmcat wb 82240 82432 svcallp
p = svmdec wb p 82432 get sv 9
p = svmcat wb p 82432 svus
p = svmdec wb p 82432 i
js_wsbuf ob wb 82240 sub p 82240
svwt ob sktype
svwt ob skfunc
svwt ob skfunc
js_wobj ob
svwt ob sknam
js_wsbuf ob bd get svtcx b get svtcx add b 1
svwt ob skargs
js_wsbuf ob bd get svtcx add b 2 get svtcx add b 3
js_wobje ob
js_wobje ob
end
js_warre ob
end

note svfull: the chat.completion object (stream false)
fn svfull ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to long
svhead ob wb sv svcc
svwt ob skchoi
js_warr ob
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skmsg
js_wobj ob
svwt ob skrole
svwt ob svasst
svwt ob skcont
if gt get sv 32 0
h = svtrim wb 0 get sv 33
if eq h 0
js_wnull ob
else
js_wsbuf ob wb 8192 h
end
svwt ob sktcall
svwcalls ob wb sv bd 0
else
js_wsbuf ob wb 8192 get sv 13
end
js_wobje ob
svwt ob skfin
svfr ob sv
js_wobje ob
js_warre ob
svusage ob sv
if eq get sv 51 1
svtinfo ob sv
end
js_wobje ob
ret js_wdone ob
end

note svtinfo: test=1 ollm_test_info: "ollm_test":{"logits_fnv" (svlhash of the first sampled step's
note logits, 0 when none was computed),"reused","prefilled" (prefix reuse),"prompt" (the prompt ids)}
fn svtinfo ob edit uchar 409600 sv edit ulong 64 to void
svwt ob sktobj
js_wobj ob
svwt ob sklfnv
js_wulong ob get sv 49
svwt ob skreu
js_wulong ob get sv 44
svwt ob skpre
js_wulong ob get sv 45
svwt ob skprm
js_warr ob
n = get svpn 0
if gt n 65536
n = 65536
end
for i ulong n
js_wulong ob get svpt i
end
js_warre ob
js_wobje ob
end

note svchunk: one chat.completion.chunk; kind 0 the role, 1 the content wb[8192 + sv14, 8192 + sv17),
note 2 the finish reason, 3 usage (empty choices). Sends it as one SSE event.
fn svchunk cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 kind ulong to long
svhead ob wb sv svccc
svwt ob skchoi
js_warr ob
if ne kind 3
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skdelta
js_wobj ob
if eq kind 0
svwt ob skrole
svwt ob svasst
svwt ob skcont
note "" as zero bytes of a non-empty text: under omc e5b32567 an empty text passed as a view has a
note wrong length (omega-mv#775, fixed after this pin), and js_wsbuf then refuses it (jswearg)
js_wsbuf ob svasst 0 0
end
if eq kind 1
svwt ob skcont
g0 = get sv 14
js_wsbuf ob wb add 8192 g0 sub get sv 17 g0
end
js_wobje ob
svwt ob skfin
if eq kind 2
svfr ob sv
else
js_wnull ob
end
js_wobje ob
end
js_warre ob
if eq kind 3
svusage ob sv
end
js_wobje ob
ret svsse cs io ob js_wdone ob
end

note svsse: the writer's text ob[1040, 1040 + n) as one SSE event; -5 when n < 0
fn svsse cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 n long to long
if lt n 0
ret -5
end
r = hssedat cs io view part ob 1040 ulong n
ret hfe r hsseend cs io
end

note svtchunk: the tool_calls delta chunk (stream true)
fn svtchunk cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to long
svhead ob wb sv svccc
svwt ob skchoi
js_warr ob
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skdelta
js_wobj ob
svwt ob sktcall
svwcalls ob wb sv bd 1
js_wobje ob
svwt ob skfin
js_wnull ob
js_wobje ob
js_warre ob
js_wobje ob
ret svsse cs io ob js_wdone ob
end

note ======== request parsing

note svtemp: the temperature token's lexeme at bd[o, o + n) as TEMPMILLI (digits, optional
note fraction, used to 0.001), or 999999 when it is not a number from 0 to 2
fn svtemp bd edit uchar 983040 o ulong n ulong to ulong
ip = ulong 0
fr = ulong 0
fd = ulong 0
dot = false
for i ulong n
c = ulong get bd add o i
if eq c 46
if dot
ret 999999
end
dot = true
else
if or lt c 48 gt c 57
ret 999999
end
if dot
if lt fd 3
fr = add mul fr 10 sub c 48
fd = add fd 1
end
else
if ge ip 100
ret 999999
end
ip = add mul ip 10 sub c 48
end
end
end
for k ulong 3
if lt fd 3
fr = mul fr 10
fd = add fd 1
end
end
m = add mul ip 1000 fr
if gt m 2000
ret 999999
end
ret m
end

note svtopp: the top_p token's lexeme at bd[o, o + n) in millionths (used to 0.000001), or jsnone
note when it is not a number from 0 to 1
fn svtopp bd edit uchar 983040 o ulong n ulong to ulong
ip = ulong 0
fr = ulong 0
fd = ulong 0
dot = false
for i ulong n
c = ulong get bd add o i
if eq c 46
if dot
ret jsnone
end
dot = true
else
if or lt c 48 gt c 57
ret jsnone
end
if dot
if lt fd 6
fr = add mul fr 10 sub c 48
fd = add fd 1
end
else
if ge ip 10
ret jsnone
end
ip = add mul ip 10 sub c 48
end
end
end
for k ulong 6
if lt fd 6
fr = mul fr 10
fd = add fd 1
end
end
m = add mul ip 1000000 fr
if gt m 1000000
ret jsnone
end
ret m
end

note svmem: the value token of member key in object o, or jsnone (the first when repeated)
fn svmem src view uchar * tp view uint 262144 o ulong key view uchar * to ulong
if ne js_type tp o 1
ret jsnone
end
k = js_first tp o
for it ulong js_nkids tp o
if eq k jsnone
break
end
if js_streq src js_off tp k key
ret add k 1
end
k = js_mnext tp k
end
ret jsnone
end

note svpcat: append text t to the template; false when it would pass tplmax (sv23)
fn svpcat wb edit uchar 1073664 sv edit ulong 64 t view uchar * to bool
pl = get sv 5
if gt add pl len t get sv 23
ret false
end
for i ulong len t
put wb add 90624 add pl i get t i
end
put sv 5 add pl len t
ret true
end

note svpstr: append the decoded string token t to the template
fn svpstr bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to bool
pl = get sv 5
cap = get sv 23
if ge pl cap
ret false
end
n = js_sget bd js_off tp t part wb add 90624 pl sub cap pl
if lt n 0
ret false
end
put sv 5 add pl ulong n
ret true
end

note svpraw: append token t's JSON text as sent (a container's whole span) to the template
fn svpraw bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to bool
ret svpcopy bd js_off tp t js_span tp t wb sv
end

note svpcopy: append bd[o, o + n) to the template; false when it would pass tplmax (sv23)
fn svpcopy bd edit uchar 983040 o ulong n ulong wb edit uchar 1073664 sv edit ulong 64 to bool
d = add 90624 get sv 5
if gt add get sv 5 n get sv 23
ret false
end
for i ulong n
put wb add d i get bd add o i
end
put sv 5 add get sv 5 n
ret true
end

note svparts: a content array of text parts into the template, joined with no separator
fn svparts bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
ty = svmem bd tp e sktype
tx = svmem bd tp e sktext
if or eq ty jsnone eq tx jsnone
ret 17
end
if or ne js_type tp ty 6 ne js_type tp tx 6
ret 17
end
if not js_streq bd js_off tp ty sktext
ret 17
end
if not svpstr bd tp tx wb sv
ret 6
end
e = js_enext tp e
end
ret 0
end

note svtc1r: one assistant tool call e as <tool_call>{"name":N,"arguments":A}</tool_call>
fn svtc1r bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
f = svmem bd tp e skfunc
if eq f jsnone
ret 23
end
nm = svmem bd tp f sknam
if eq nm jsnone
ret 23
end
if ne js_type tp nm 6
ret 23
end
ar = svmem bd tp f skargs
aty = ulong 0
if ne ar jsnone
aty = js_type tp ar
end
if and and ne aty 0 ne aty 6 ne aty 1
ret 23
end
if not svpcat wb sv svtcn
ret 6
end
if not svpraw bd tp nm wb sv
ret 6
end
if not svpcat wb sv svtca
ret 6
end
ok = true
if eq aty 6
ok = svpstr bd tp ar wb sv
end
if eq aty 1
ok = svpraw bd tp ar wb sv
end
if eq aty 0
ok = svpcat wb sv svempt
end
if not ok
ret 6
end
if not svpcat wb sv svtcz
ret 6
end
ret 0
end

note svtcs: an assistant message's tool_calls array a into the template
fn svtcs bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp a 3
ret 23
end
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
if not svpcat wb sv svtco
ret 6
end
r = svtc1r bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note svmsg1: one message object e into the template; 0 or an error code
fn svmsg1 bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp e 1
ret 3
end
ro = svmem bd tp e skrole
if eq ro jsnone
ret 5
end
if or ne js_type tp ro 6 gt js_slen tp ro 32
ret 5
end
co = svmem bd tp e skcont
tc = svmem bd tp e sktcall
if ne tc jsnone
if eq js_type tp tc 10
tc = jsnone
end
end
ct = ulong 10
if ne co jsnone
ct = js_type tp co
end
if and eq co jsnone eq tc jsnone
ret 4
end
if and and ne ct 6 ne ct 10 ne ct 3
ret 4
end
if not svpstr bd tp ro wb sv
ret 6
end
if not svpcat wb sv svsep
ret 6
end
if eq ct 6
if not svpstr bd tp co wb sv
ret 6
end
end
if eq ct 3
r = svparts bd tp co wb sv
if ne r 0
ret r
end
end
if ne tc jsnone
r = svtcs bd tp tc wb sv
if ne r 0
ret r
end
end
if not svpcat wb sv svnl
ret 6
end
ret 0
end

fn svmsgs bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp a 3
ret 3
end
n = js_nkids tp a
if eq n 0
ret 3
end
e = js_first tp a
for it ulong n
if eq e jsnone
break
end
r = svmsg1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
if not svpcat wb sv svaprm
ret 6
end
ret 0
end

note svtool1: one tools entry e; its name into wb[82432 + 64 i ..)
fn svtool1 bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
ty = svmem bd tp e sktype
f = svmem bd tp e skfunc
if or eq ty jsnone eq f jsnone
ret 21
end
if ne js_type tp ty 6
ret 21
end
if not js_streq bd js_off tp ty skfunc
ret 21
end
nm = svmem bd tp f sknam
if eq nm jsnone
ret 21
end
if ne js_type tp nm 6
ret 21
end
ret svtname bd js_off tp nm wb sv
end

note svtname: the tool name string at bd[o ..) into wb[82432 + 64 i ..), i = sv30
fn svtname bd edit uchar 983040 o ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
i = get sv 30
if ge i 128
ret 21
end
m = js_sget bd o part wb add 82432 mul i 64 64
if lt m 1
ret 21
end
put svtnl i ulong m
put sv 30 add i 1
ret 0
end

note svtools: the tools value a (jsnone when absent): checked, its names kept, its JSON text
note rendered as the template's first line
fn svtools bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq a jsnone
ret 0
end
ty = js_type tp a
if eq ty 10
ret 0
end
if ne ty 3
ret 21
end
n = js_nkids tp a
if gt n 128
ret 21
end
if eq n 0
ret 0
end
e = js_first tp a
for it ulong n
if eq e jsnone
break
end
r = svtool1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
if eq get sv 40 1
put sv 48 add a 1
ret 0
end
if not svpcat wb sv svtlp
ret 6
end
if not svpraw bd tp a wb sv
ret 6
end
if not svpcat wb sv svnl
ret 6
end
ret 0
end

note svopts: stream_options value v: include_usage true sets sv4
fn svopts bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to void
if ne js_type tp v 1
ret
end
k = js_first tp v
for it ulong js_nkids tp v
if eq k jsnone
break
end
if js_streq bd js_off tp k skincl
if eq js_type tp add k 1 8
put sv 4 1
end
end
k = js_mnext tp k
end
end

note svscal: one scalar member (key token k, value k + 1); 0 or an error code
fn svscal bd edit uchar 983040 tp edit uint 262144 k ulong sv edit ulong 64 to ulong
o = js_off tp k
v = add k 1
ty = js_type tp v
vo = js_off tp v
if or js_streq bd o skmaxt js_streq bd o skmaxc
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 8
end
x = js_tou bd vo
if or eq x 0 gt x 999999
ret 8
end
put sv 1 x
ret 0
end
if js_streq bd o sktemp
if eq ty 10
ret 0
end
if ne ty 7
ret 7
end
if ne and js_nflags tp v 5 0
ret 7
end
m = svtemp bd vo js_span tp v
if gt m 2000
ret 7
end
put sv 2 m
ret 0
end
if js_streq bd o skseed
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 9
end
put sv 3 js_tou bd vo
ret 0
end
if js_streq bd o skstrm
if eq ty 8
put sv 0 1
ret 0
end
if or eq ty 9 eq ty 10
ret 0
end
ret 10
end
if js_streq bd o skn
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 12
end
if ne js_tou bd vo 1
ret 12
end
ret 0
end
if js_streq bd o skopts
svopts bd tp v sv
end
ret 0
end

note svstop1: one stop string token t into wb[73728 + 128 i ..)
fn svstop1 bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp t 6
ret 18
end
ret svstopn bd js_off tp t wb sv
end

note svstopn: the stop string at bd[o ..) into wb[73728 + 128 i ..), i = sv35
fn svstopn bd edit uchar 983040 o ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
i = get sv 35
if ge i 8
ret 18
end
m = js_sget bd o part wb add 73728 mul i 128 128
if lt m 1
ret 18
end
put svstl i ulong m
put sv 35 add i 1
ret 0
end

note svstopp: the stop value v (null, a string or an array of strings)
fn svstopp bd edit uchar 983040 tp edit uint 262144 v ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if eq ty 6
ret svstop1 bd tp v wb sv
end
if ne ty 3
ret 18
end
n = js_nkids tp v
if gt n 8
ret 18
end
e = js_first tp v
for it ulong n
if eq e jsnone
break
end
r = svstop1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note svtopk: the top_k value v; -1, 0 and null leave it off
fn svtopk bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if ne ty 7
ret 19
end
vo = js_off tp v
if js_isu bd vo
x = js_tou bd vo
if gt x 999999
ret 19
end
put sv 28 x
ret 0
end
if js_isl bd vo
if eq js_tol bd vo neg long 1
ret 0
end
end
ret 19
end

note svtchoi: the tool_choice value v; "none" turns tool-call detection off
fn svtchoi bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if eq ty 6
o = js_off tp v
if js_streq bd o sknone
put sv 31 0
ret 0
end
if or js_streq bd o svauto js_streq bd o svreq
ret 0
end
ret 22
end
if eq ty 1
t = svmem bd tp v sktype
if ne t jsnone
if eq js_type tp t 6
if js_streq bd js_off tp t skfunc
ret 0
end
end
end
end
ret 22
end

note svtest: a test-only member (key k), refused unless the server runs with test=1
fn svtest bd edit uchar 983040 tp edit uint 262144 k ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq get sv 22 0
ret 24
end
v = add k 1
ty = js_type tp v
vo = js_off tp v
if js_streq bd js_off tp k sktdel
if ne ty 7
ret 24
end
if not js_isu bd vo
ret 24
end
x = js_tou bd vo
if gt x 10000
ret 24
end
put sv 27 x
ret 0
end
if or or js_streq bd js_off tp k sktinf js_streq bd js_off tp k sktcol js_streq bd js_off tp k sktser
ret svtbool bd tp k sv
end
if ne ty 6
ret 24
end
m = js_sget bd vo part wb 8192 16384
if lt m 0
ret 24
end
put sv 25 1
put sv 26 ulong m
ret 0
end

note svtbool: ollm_test_info (sv51) or ollm_test_cold (sv52), true or false
fn svtbool bd edit uchar 983040 tp edit uint 262144 k ulong sv edit ulong 64 to ulong
ty = js_type tp add k 1
if and ne ty 8 ne ty 9
ret 24
end
b = ulong 0
if eq ty 8
b = 1
end
o = js_off tp k
if js_streq bd o sktinf
put sv 51 b
end
if js_streq bd o sktcol
put sv 52 b
end
if js_streq bd o sktser
put sv 55 b
end
ret 0
end

note svscal2: the members stop, top_k, top_p, tool_choice and the test-only ones; 0 or a code
fn svscal2 bd edit uchar 983040 tp edit uint 262144 k ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
o = js_off tp k
v = add k 1
if js_streq bd o svstop
ret svstopp bd tp v wb sv
end
if js_streq bd o sktopk
ret svtopk bd tp v sv
end
if js_streq bd o sktopp
ty = js_type tp v
if eq ty 10
ret 0
end
if ne ty 7
ret 20
end
if ne and js_nflags tp v 5 0
ret 20
end
m = svtopp bd js_off tp v js_span tp v
if eq m jsnone
ret 20
end
put sv 29 m
ret 0
end
if js_streq bd o sktchoi
ret svtchoi bd tp v sv
end
if or or js_streq bd o sktout js_streq bd o sktdel or or js_streq bd o sktinf js_streq bd o sktcol js_streq bd o sktser
ret svtest bd tp k wb sv
end
ret 0
end

note svreset: a request's options to their defaults
fn svreset sv edit ulong 64 to void
put sv 0 0
put sv 1 999999
put sv 2 1000
put sv 3 1
put sv 4 0
put sv 5 0
for i ulong 12
put sv add 24 i 0
end
put sv 29 1000000
put sv 31 1
put sv 48 0
put sv 51 0
put sv 52 0
put sv 55 0
end

note svparse: the request body bd[0, n) into sv and the template; 0 or an error code
fn svparse bd edit uchar 983040 n ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
tp = new uint 262144 0
x = js_init tp 983040 64
r = js_parse bd tp n
if lt r 0
if eq r neg long jsetok
ret 25
end
ret 1
end
if ne js_type tp 0 1
ret 2
end
svreset sv
k = js_first tp 0
for it ulong js_nkids tp 0
if eq k jsnone
break
end
e = svscal bd tp k sv
if eq e 0
e = svscal2 bd tp k wb sv
end
if ne e 0
ret e
end
k = js_mnext tp k
end
ma = svmem bd tp 0 skmsgs
if eq ma jsnone
ret 3
end
e = svtools bd tp svmem bd tp 0 sktools wb sv
if ne e 0
ret e
end
if eq get sv 30 0
put sv 31 0
end
if eq get sv 40 1
ret c1conv bd tp ma wb sv
end
ret svmsgs bd tp ma wb sv
end

note ======== CHAT1 (DRA-123: the one chat template of serving, training data and evaluation)

note With OLLMTOK1 merges (sv40 = 1) a request's conversation becomes token ids directly (svparse
note calls c1conv; `ollm chatenc` runs the same svparse per JSONL line, so both produce the same
note tokens): 263 <|doc|>; per message system/developer 257, user 258, assistant 259, tool 261, then
note raw(content) (FORMAT.md section 6 raw mode, so content can never forge a special); the first
note system message also gets raw("\n\n# Tools\n" + the tools JSON text as sent) when tools is
note non-empty (no system message: a system turn of only that section right after 263); an
note assistant message adds, per tool call, 260 then raw({"name":NAME,"arguments":ARGS}) with NAME
note the name's JSON string as sent and ARGS the decoded string, the object's JSON text as sent, or
note {} when absent; every message ends with 256 <|end|> (one per assistant turn). serve appends the
note generation prompt 259. svpm marks the assistant tokens after 259 (content, calls, the closing
note 256): the training loss mask. Other roles are 400 (error 26).
text c1th "\n\n# Tools\n"
text c1rbr "}"
text c1rsys "system"
text c1rdev "developer"
text c1ruse "user"
text c1rtol "tool"

note c1put: token t onto the prompt buffer (mask svpn 1)
fn c1put t ulong to void
m = get svpn 0
if lt m 65536
put svpt m t
put svpm m uchar get svpn 1
end
put svpn 0 add m 1
end

note c1seg: raw-encode the template bytes wb[90624, 90624 + sv5) onto the prompt; sv5 back to 0
fn c1seg wb edit uchar 1073664 sv edit ulong 64 to void
n = get sv 5
for i ulong n
put tkw i get wb add 90624 i
end
i = ulong 0
while lt i n bound 999999
l = tknext i n false
c = tkencc i l
for j ulong c
c1put ulong get tkct j
end
i = add i l
end
put sv 5 0
end

note c1role: 1 system or developer, 2 user, 3 assistant, 4 tool, 0 another role (string at bd[o ..))
fn c1role bd edit uchar 983040 o ulong to ulong
if or js_streq bd o c1rsys js_streq bd o c1rdev
ret 1
end
if js_streq bd o c1ruse
ret 2
end
if js_streq bd o svasst
ret 3
end
if js_streq bd o c1rtol
ret 4
end
ret 0
end

note c1sp: the special id that starts a turn of role kind r
fn c1sp r ulong to ulong
if eq r 1
ret 257
end
if eq r 2
ret 258
end
if eq r 3
ret 259
end
ret 261
end

note c1tools: the pending tools section (sv48 = tools token + 1) as one raw segment; sv48 cleared
fn c1tools bd edit uchar 983040 tp edit uint 262144 wb edit uchar 1073664 sv edit ulong 64 to ulong
a = get sv 48
if eq a 0
ret 0
end
put sv 48 0
put sv 5 0
if not svpcat wb sv c1th
ret 6
end
if not svpraw bd tp sub a 1 wb sv
ret 6
end
c1seg wb sv
ret 0
end

note c1tc1: one assistant tool call e as 260 raw({"name":N,"arguments":A})
fn c1tc1 bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
f = svmem bd tp e skfunc
if eq f jsnone
ret 23
end
nm = svmem bd tp f sknam
if eq nm jsnone
ret 23
end
if ne js_type tp nm 6
ret 23
end
ar = svmem bd tp f skargs
aty = ulong 0
if ne ar jsnone
aty = js_type tp ar
end
if and and ne aty 0 ne aty 6 ne aty 1
ret 23
end
put sv 5 0
ok = svpcat wb sv svtcn
ok = and ok svpraw bd tp nm wb sv
ok = and ok svpcat wb sv svtca
if eq aty 6
ok = and ok svpstr bd tp ar wb sv
end
if eq aty 1
ok = and ok svpraw bd tp ar wb sv
end
if eq aty 0
ok = and ok svpcat wb sv svempt
end
ok = and ok svpcat wb sv c1rbr
if not ok
ret 6
end
c1put 260
c1seg wb sv
ret 0
end

note c1tcs: an assistant message's tool_calls array a
fn c1tcs bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp a 3
ret 23
end
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
r = c1tc1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note c1body: the content value co (type ct; 10 none) as one raw segment
fn c1body bd edit uchar 983040 tp edit uint 262144 co ulong ct ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
put sv 5 0
if eq ct 6
if not svpstr bd tp co wb sv
ret 6
end
end
if eq ct 3
r = svparts bd tp co wb sv
if ne r 0
ret r
end
end
c1seg wb sv
ret 0
end

note c1msg: one message object e; 0 or an error code
fn c1msg bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp e 1
ret 3
end
ro = svmem bd tp e skrole
if eq ro jsnone
ret 5
end
if or ne js_type tp ro 6 gt js_slen tp ro 32
ret 5
end
r = c1role bd js_off tp ro
if eq r 0
ret 26
end
co = svmem bd tp e skcont
tc = svmem bd tp e sktcall
if ne tc jsnone
if eq js_type tp tc 10
tc = jsnone
end
end
ct = ulong 10
if ne co jsnone
ct = js_type tp co
end
if and eq co jsnone eq tc jsnone
ret 4
end
if and and ne ct 6 ne ct 10 ne ct 3
ret 4
end
put svpn 1 0
c1put c1sp r
if eq r 3
put svpn 1 1
end
x = c1body bd tp co ct wb sv
if ne x 0
ret x
end
if eq r 1
x = c1tools bd tp wb sv
if ne x 0
ret x
end
end
if and eq r 3 ne tc jsnone
x = c1tcs bd tp tc wb sv
if ne x 0
ret x
end
end
c1put 256
put svpn 1 0
ret 0
end

note c1hsys: whether the messages array a has a system or developer message
fn c1hsys bd edit uchar 983040 tp edit uint 262144 a ulong to bool
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
if eq js_type tp e 1
ro = svmem bd tp e skrole
if ne ro jsnone
if eq js_type tp ro 6
if eq c1role bd js_off tp ro 1
ret true
end
end
end
end
e = js_enext tp e
end
ret false
end

note c1conv: the messages array a as CHAT1 tokens into svpt (no generation prompt); 0 or a code
fn c1conv bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
put svpn 0 0
put svpn 1 0
if ne js_type tp a 3
ret 3
end
n = js_nkids tp a
if eq n 0
ret 3
end
c1put 263
if ne get sv 48 0
if not c1hsys bd tp a
c1put 257
x = c1tools bd tp wb sv
if ne x 0
ret x
end
c1put 256
end
end
e = js_first tp a
for it ulong n
if eq e jsnone
break
end
r = c1msg bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note c1fenc: the test output wb[8192, 8192 + n) in chat mode (its exact markers become specials:
note test-only text, never a request's content) into the forced tokens; the count (at most 4096)
fn c1fenc wb edit uchar 1073664 n ulong to ulong
for i ulong n
put tkw i get wb add 8192 i
end
i = ulong 0
m = ulong 0
while lt i n bound 999999
l = tknext i n true
s = get tkv 1
if ne s 0
if lt m 4096
put svft m s
end
m = add m 1
else
c = tkencc i l
for j ulong c
if lt m 4096
put svft m ulong get tkct j
end
m = add m 1
end
end
i = add i l
end
if gt m 4096
ret 4096
end
ret m
end

note c1tcall: CHAT1 tool calls in the output: with detection on and 1 .. 8 generated <|tool_call|>
note tokens (content positions svtcp), each call's text (to the next marker or the end, whitespace
note around dropped) must be a JSON object naming a declared tool; else the output stays content
fn c1tcall wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to void
k = get sv 50
if or eq k 0 gt k 8
ret
end
n = get sv 13
for i ulong k
s = add get svtcp i 13
e = n
if lt add i 1 k
e = get svtcp add i 1
end
if or gt s e gt e n
put sv 32 0
ret
end
s = svskws wb s e
e = svtrim wb s e
if not svtc1 wb sv bd s sub e s
put sv 32 0
ret
end
end
put sv 33 get svtcp 0
put sv 8 3
end

note c1mark: a generated <|tool_call|> (its 13 marker bytes end the content) at content n - 13
fn c1mark sv edit ulong 64 to void
k = get sv 50
if lt k 16
if ge get sv 13 13
put svtcp k sub get sv 13 13
put sv 50 add k 1
end
end
end

note ======== the model: v3 (CK01, CK02: model.om, a full forward per token) or v4 (CK03: v4.om's
note KV-cache decode, xdpos, so a token costs O(context) and a prompt only its new positions)

note svmld: the prompt svpt[0, np) into the model's context. v3: the context is rebuilt. v4 (prefix
note reuse): the cache keeps the positions [0, p) of the last sequence whose tokens equal the
note prompt's, p <= np - 1 so the last prompt position is always decoded for its logits; the
note positions from p on are invalidated and prefilled at the first step (sv44 reused, sv45
note prefilled). Mutant pj (OMUTPJ 0) skips the invalidation: the stale positions stay cached.
const OMUTPJ ulong 1
fn svmld sv edit ulong 64 to void
np = get svpn 0
if ne get sv 41 4
put og 9 0
for i ulong np
ocpush get svpt i
end
put sv 44 0
put sv 45 np
ret
end
cv = get xg 47
if eq get sv 52 1
cv = 0
end
lim = sub np 1
if lt cv lim
lim = cv
end
p = ulong 0
while lt p lim bound 65537
if ne get xtk p get svpt p
break
end
p = add p 1
end
if eq OMUTPJ 1
put xg 47 p
else
put xg 47 lim
end
for i ulong np
put xtk i get svpt i
end
put xg 48 np
put sv 44 get xg 47
put sv 45 sub np get xg 47
end

note svmpush: generated token c onto the context (never past T: generation stops at T - np)
fn svmpush sv edit ulong 64 c ulong to void
if eq get sv 41 4
cn = get xg 48
put xtk cn c
put xg 48 add cn 1
ret
end
ocpush c
end

note svmlog: the next-token logits into oa[og 27, og 27 + V). v4 decodes the positions the cache
note lacks (xg 47 .. xg 48), the head only at the last (every 32 positions of a long
note prefill the side connections and the queue are served, as between tokens); v3 runs the whole
note forward (cmdsamp's osstep)
fn svmlog sv edit ulong 64 bd edit uchar 983040 to void
if eq get sv 41 4
cn = get xg 48
if and lt add get xg 47 1 cn eq get sv 55 0
svpref sv bd get xg 47 sub cn 1
put xg 47 sub cn 1
end
while lt get xg 47 cn bound 65537
cv = get xg 47
xdpos cv eq cv sub cn 1
put xg 47 add cv 1
if eq and cv 31 31
svside bd sv 0
svqpoll
end
end
ret
end
lf = ofwd 0
olast
end

note svlhash: word-wise FNV-1a 64 of the V logits' f64 bit patterns (test=1 ollm_test_info)
fn svlhash to ulong
o = get og 27
h = ulong 14695981039346656037
for c ulong get og 0
h = mul xor h bitcast ulong get oa add o c 1099511628211
end
ret h
end

note svisend: whether sampled token c ends the output: v1 token 0; OLLMTOK1 <|end|> (256) and every
note other special or reserved id 257 .. 271 except <|tool_call|> 260 (a turn start ends the turn)
fn svisend sv edit ulong 64 c ulong to bool
if eq get sv 40 0
ret eq c 0
end
if and ge c 256 lt c 272
ret ne c 260
end
ret false
end

note svpref: the cache positions [cv, ce) of a prefill decoded layer by layer: each layer's weights
note are staged (xstw) and a staged layer's KV rows loaded (xkvs) once per chunk instead of once per
note position. The hidden rows wait in svhid, chunks of min(32, 2^21 / D) positions (so the side
note connections and the queue are served at least every 32 positions, as in the position-by-position
note loop, while a staged layer is still loaded 32 times less often). Every operation is
note xdpos's for the same (layer, position), in an order that keeps each layer's dependencies (its
note KV rows of the earlier positions), so the cache and the last row are bit-identical to the
note position-by-position decode (checked against it: test member ollm_test_serial). Between chunks
note the side connections and the queue are served.
global svhid f64 2097152
note Mutant pl (OMUTPL 0) skips the last layer of the layer-by-layer prefill: the check against
note ollm_test_serial (c1_prefill_layer_bitexact) must catch it.
const OMUTPL ulong 1
fn svpref sv edit ulong 64 bd edit uchar 983040 cv ulong ce ulong to void
ch = div 2097152 get xg 2
if gt ch 32
ch = 32
end
p = cv
while lt p ce bound 65537
e = add p ch
if gt e ce
e = ce
end
svpref1 p e
p = e
svside bd sv 0
svqpoll
end
end

fn svpref1 s ulong e ulong to void
d = get xg 2
for t ulong sub e s
svpemb t get xtk add s t d
end
nl = sub get xg 5 sub 1 OMUTPL
for l ulong nl
for t ulong sub e s
svpref2 l s t d
end
end
end

note svpemb: svhid row t = the embedding row of token c, read from the wte banks exactly as
note xdpos's xcpe reads it (v4 wide layout: rows below R1 = xg 72 in opa, the rest in oww from xg 73)
fn svpemb t ulong c ulong d ulong to void
o = mul t d
r1 = get xg 72
if lt c r1
s = mul c d
for i ulong d
put svhid add o i get opa add s i
end
ret
end
s2 = add get xg 73 mul sub c r1 d
for j ulong d
put svhid add o j get oww add s2 j
end
end

note svpref2: layer l at position s + t: the row svhid[t] through xdlay and back
fn svpref2 l ulong s ulong t ulong d ulong to void
o = mul t d
xr = get xg 49
for i ulong d
put oa add xr i get svhid add o i
end
xdlay l add s t
for i ulong d
put svhid add o i get oa add xr i
end
end

note ======== encoding

note svemit: token t, the m-th of an encoding: md 0 onto the prompt (svpt), md 1 into the forced tokens
fn svemit md ulong m ulong t ulong to void
if eq md 0
c1put t
ret
end
if lt m 4096
put svft m t
end
end

note svenc1: the pre-token oarg[i, i + l) encoded and emitted after m tokens; the new count
fn svenc1 i ulong l ulong md ulong m ulong to ulong
for k ulong l
put bqtm k ushort get oarg add i k
end
c = bpenct l
for k ulong c
svemit md add m k ulong get bqtm k
end
ret add m c
end

note svenc: encode src[0, n) of any length as obpenc does, in windows of at most 4000 bytes copied
note to oarg; a window ends at a pre-token boundary at least 64 bytes before its end (a pre-token
note is at most 64 bytes, so the boundaries agree with one pass), the last one at n. Returns the
note token count.
fn svenc src view uchar * n ulong md ulong to ulong
s = ulong 0
m = ulong 0
while lt s n bound 999999
w = sub n s
if gt w 4000
w = 4000
end
for k ulong w
put oarg k get src add s k
end
la = eq add s w n
i = ulong 0
while lt i w bound 4097
if and not la gt add i 64 w
break
end
l = bpclena i w
m = svenc1 i l md m
i = add i l
end
s = add s i
end
ret m
end

note ======== generation

note svgen: sample up to min(sv1, T - CT0) tokens; streams chunks when sv0 is 1. 0, or negative
note when a chunk could not be sent or the client left (svgone: finish 4, status 499). Between
note tokens the listener and pending connections are served (svside), waiting up to
note ollm_test_delay_ms.
fn svgen cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to long
lim = sub get sv 19 get sv 6
if lt get sv 1 lim
lim = get sv 1
end
put sv 7 0
put sv 8 0
put sv 12 0
put sv 13 0
put sv 14 0
put sv 17 0
put sv 50 0
put sv 49 0
tmo = long mul get sv 27 1000000
for g ulong lim
svside bd sv tmo
svqpoll
if svgone cs
put sv 8 4
put sv 21 499
ret -104
end
if not svtake wb sv bd
break
end
r = svpend cs io ob wb sv 0
if lt r 0
ret r
end
end
if eq get sv 8 0
put sv 8 2
end
p = get sv 13
svclean wb sv 1
x = svstopc wb sv p
svtcall wb sv bd
r = svpend cs io ob wb sv 1
if lt r 0
ret r
end
if and eq get sv 0 1 gt get sv 32 0
ret svtchunk cs io ob wb sv bd
end
ret r
end

note svtake: one sampled token into the context and the content; false when it ends the output
note (sv8: 1 an end token (svisend) or a stop string, 2 the content would pass its 65536 bytes)
fn svtake wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to bool
c = svdraw sv bd
if svisend sv c
put sv 8 1
ret false
end
if not svfits sv c
put sv 8 2
ret false
end
svcap wb sv c
p = get sv 13
svclean wb sv 0
if and eq c 260 eq get sv 40 1
c1mark sv
end
if svstopc wb sv p
ret false
end
ret true
end

note svstopc: the earliest stop string match that ends past the content's old length p cuts the
note content there (finish stop); whether one did
fn svstopc wb edit uchar 1073664 sv edit ulong 64 p ulong to bool
n = get sv 13
b = jsnone
for i ulong get sv 35
l = get svstl i
s = ulong 0
if gt add p 1 l
s = sub add p 1 l
end
q = svfind wb s n add 73728 mul i 128 l
if lt q b
b = q
end
end
if eq b jsnone
ret false
end
put sv 13 b
put sv 12 0
put sv 8 1
ret true
end

note svhold: how far a streamed chunk may send: not into the tail a stop string or the tool-call
note marker could still claim, nor (detection on) past the marker or into trailing whitespace
fn svhold wb edit uchar 1073664 sv edit ulong 64 to ulong
n = get sv 13
lo = get sv 14
h = n
for i ulong get sv 35
k = svpsuf wb lo n add 73728 mul i 128 get svstl i
if lt sub n k h
h = sub n k
end
end
if eq get sv 31 1
if eq get sv 40 1
if gt get sv 50 0
if lt get svtcp 0 h
h = get svtcp 0
end
end
else
q = svfind wb lo n 74752 11
if lt q h
h = q
end
k2 = svpsuf wb lo n 74752 11
if lt sub n k2 h
h = sub n k2
end
end
h = svtrim wb lo h
end
ret h
end

note svdraw: the next token (cmdsamp's step osstep, or svdrawf with top_k/top_p on, or the forced
note tokens of ollm_test_output then 0), advancing the seed stream when sampling
fn svdraw sv edit ulong 64 bd edit uchar 983040 to ulong
if eq get sv 25 1
g = get sv 7
if lt g get sv 24
ret get svft g
end
if eq get sv 40 1
ret 256
end
ret 0
end
svmlog sv bd
if eq get sv 7 0
put sv 49 svlhash
end
st = get sv 3
tm = get sv 2
c = ulong 0
if or eq tm 0 not svfon sv
if eq tm 0
c = oargmax
else
c = odraw st div f64 tm 1000.0
end
else
c = svdrawf st div f64 tm 1000.0 get sv 28 get sv 29
end
if ne tm 0
put sv 3 add st 11400714819323198485
end
ret c
end

note svfon: whether top_k (0 < K < V) or top_p (< 1) filters
fn svfon sv edit ulong 64 to bool
k = get sv 28
if and gt k 0 lt k get og 0
ret true
end
ret lt get sv 29 1000000
end

note svdrawf: odraw over the kept tokens (svkeep), the uniform scaled to their mass
fn svdrawf st ulong tau f64 k ulong p6 ulong to ulong
svlogit tau
o = get og 27
v = get og 0
cm = svkeep o v k p6
u = mul f64 shr smx st 11 1.1102230246251565e-16
r = svpick o v mul u cm
for j ulong v
put svmk j 0
end
ret r
end

note svlogit: the next-token logits (svmlog, already computed) divided by tau, then made
note probabilities (as odraw does)
fn svlogit tau f64 to void
o = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for c ulong v
x = div get oa add o c tau
put oa add o c x
m = fmax m x
end
sm = osoft o v m
end

note svkeep: mark the most probable tokens (ties to the lower id), at most K (0 < K < V), until
note their mass reaches top_p (p6 < 1000000); their mass
fn svkeep o ulong v ulong k ulong p6 ulong to f64
lim = v
if and gt k 0 lt k v
lim = k
end
pf = div f64 p6 1000000.0
cm = 0.0f64
for j ulong lim
b = svmax o v
put svmk b 1
cm = add cm get oa add o b
if and lt p6 1000000 ge cm pf
break
end
end
ret cm
end

note svmax: the unmarked token of highest probability, the lower id on ties
fn svmax o ulong v ulong to ulong
b = ulong 0
bv = 0.0f64
fd = false
for c ulong v
if eq get svmk c 0
x = get oa add o c
if or not fd gt x bv
b = c
bv = x
fd = true
end
end
end
ret b
end

note svpick: the first kept token (id order) whose running kept mass passes t; else the last kept
fn svpick o ulong v ulong t f64 to ulong
acc = 0.0f64
la = ulong 0
for c ulong v
if eq get svmk c 1
acc = add acc get oa add o c
la = c
if lt t acc
ret c
end
end
end
ret la
end

note svfits: whether token c's bytes fit the raw buffer (8192) and, as up to three content bytes
note each, the content (65536)
fn svfits sv edit ulong 64 c ulong to bool
tl = otlen c
rn = add get sv 12 tl
gn = add get sv 13 mul rn 3
ret not or or gt rn 8192 gt tl 4096 gt gn 65536
end

note svcap: token c's bytes onto the raw buffer, c onto the context
fn svcap wb edit uchar 1073664 sv edit ulong 64 c ulong to void
otcap c
rn = get sv 12
for i ulong get obon 0
put wb add rn i get obo i
end
put sv 12 add rn get obon 0
svmpush sv c
put sv 7 add get sv 7 1
end

note svpend: when streaming, the content not yet sent (up to svhold; fin 1 all of it, or the text
note before the tool calls) as one chunk; 0 or the send error
fn svpend cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 fin ulong to long
if ne get sv 0 1
ret 0
end
h = get sv 13
if eq fin 0
h = svhold wb sv
else
if gt get sv 32 0
h = svtrim wb get sv 14 get sv 33
end
end
if le h get sv 14
ret 0
end
put sv 17 h
r = svchunk cs io ob wb sv 1
put sv 14 h
ret r
end

note ======== tool calls in the output

note svtdecl: whether bd[f, f + q) is a declared tool name
fn svtdecl wb edit uchar 1073664 bd edit uchar 983040 f ulong q ulong sv edit ulong 64 to bool
for i ulong get sv 30
if eq get svtnl i q
if svteq wb bd f q add 82432 mul i 64
ret true
end
end
end
ret false
end

note svteq: whether bd[f, f + q) equals wb[b, b + q)
fn svteq wb edit uchar 1073664 bd edit uchar 983040 f ulong q ulong b ulong to bool
for j ulong q
if ne get bd add f j get wb add b j
ret false
end
end
ret true
end

note svtargs: the arguments token ar of a block at wb[b ..) into bd at f (object: its JSON text;
note string: decoded; absent: {}); its length, or negative
fn svtargs wb edit uchar 1073664 bd edit uchar 983040 tp view uint 262144 ar ulong f ulong b ulong to long
if eq ar jsnone
put bd f 123
put bd add f 1 125
ret 2
end
ty = js_type tp ar
if eq ty 6
ret js_sget view part wb b 65536 js_off tp ar part bd f 65536
end
if ne ty 1
ret -1
end
o = add b js_off tp ar
n = js_span tp ar
for i ulong n
put bd add f i get wb add o i
end
ret long n
end

note svtc1: the block JSON at content [s, s + l) as tool call sv32; false when it is not one
fn svtc1 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 s ulong l ulong to bool
if or eq l 0 gt l 65536
ret false
end
tp = new uint 262144 0
x = js_init tp 65536 64
b = add 8192 s
r = js_parse view part wb b l tp l
if lt r 0
ret false
end
if ne js_type tp 0 1
ret false
end
ret svtc2 wb sv bd tp b
end

note svtc2: the parsed block at wb[b ..) (tape tp) recorded as tool call sv32; whether it is one
fn svtc2 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 tp view uint 262144 b ulong to bool
nm = svmem view part wb b 65536 tp 0 sknam
if eq nm jsnone
ret false
end
if ne js_type tp nm 6
ret false
end
q = svtnam wb sv bd js_off tp nm b
if lt q 1
ret false
end
f = get sv 34
g = add f ulong q
a = svtargs wb bd tp svmem view part wb b 65536 tp 0 skargs g b
if lt a 0
ret false
end
svtrec sv f ulong q g ulong a
ret true
end

note svtnam: the name string at wb[b + o ..) decoded to bd[sv34 ..); its length when it is a
note declared tool name, else -1
fn svtnam wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 o ulong b ulong to long
f = get sv 34
q = js_sget view part wb b 65536 o part bd f 64
if lt q 1
ret -1
end
if not svtdecl wb bd f ulong q sv
ret -1
end
ret q
end

note svtrec: record tool call sv32's name bd[f, f + q) and arguments bd[g, g + a)
fn svtrec sv edit ulong 64 f ulong q ulong g ulong a ulong to void
m = mul get sv 32 4
put svtcx m f
put svtcx add m 1 q
put svtcx add m 2 g
put svtcx add m 3 a
put sv 34 add g a
put sv 32 add get sv 32 1
end

note svtblk: the block <tool_call>JSON</tool_call> at content p; the position after it, or jsnone
fn svtblk wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 p ulong n ulong to ulong
if gt add p 11 n
ret jsnone
end
if not svat wb p 74752 11
ret jsnone
end
s = add p 11
z = svfind wb s n 74763 12
if eq z jsnone
ret jsnone
end
if not svtc1 wb sv bd s sub z s
ret jsnone
end
ret add z 12
end

note svtcall: with detection on, whether the content from the first marker on is 1 .. 8 tool-call
note blocks with only whitespace around: sv32 calls, sv33 the marker, finish tool_calls
fn svtcall wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to void
put sv 32 0
put sv 34 0
if eq get sv 31 0
ret
end
if eq get sv 40 1
c1tcall wb sv bd
ret
end
n = get sv 13
q = svfind wb 0 n 74752 11
if eq q jsnone
ret
end
p = q
for it ulong 9
p = svskws wb p n
if ge p n
break
end
z = jsnone
if lt get sv 32 8
z = svtblk wb sv bd p n
end
if eq z jsnone
put sv 32 0
ret
end
p = z
end
if lt p n
put sv 32 0
ret
end
put sv 33 q
put sv 8 3
end

note ======== request queue (one generation slot, FIFO of SVQCAP waiting chat completions)

note A chat completion that arrives while another generates is read whole (the pending-slot and
note head/body deadline protections of svwait and svside2 apply first), then waits in one of
note SVQCAP = 32 queue slots (its connection state cs, io and body copied there; the descriptor stays
note open) and is served in arrival order once the generation ends: the main loop takes the oldest
note waiting entry before it accepts new connections. Only with all 32 slots taken is the request
note answered 503 queue_full with Retry-After: 1. A waiting client that leaves (svqpoll: a peek
note reads end of stream or an error, checked between generated tokens) frees its slot at once,
note logged as status 499 finish 4. Health reports in_flight, queued and capacity. Why 32: an
note agent fleet of a few clients each holding at most one request in flight stays far below it,
note and the slots cost 32 x (2560 + 131072 + 983040) bytes = 35.7 MB of globals (the bodies at
note full jsmaxn size, so any request the idle server accepts can also wait).
const SVQCAP ulong 32
global svqcs ulong 10240
global svqio uchar 4194304
note the bodies: slots 0 .. 15 in svqb0, 16 .. 31 in svqb1 (an array holds at most 2^24 elements)
global svqb0 uchar 15728640
global svqb1 uchar 15728640
note per slot: 0 free / 1 waiting, body length, arrival sequence, arrival monons
global svqst ulong 32
global svqln ulong 32
global svqsq ulong 32
global svqat ulong 32
note 0 waiting count, 1 next sequence, 2 in flight (0 or 1)
global svqn ulong 4
text svtq503 "{\"error\":{\"message\":\"the request queue is full (32 waiting chat completions): retry after 1 s\",\"type\":\"server_error\",\"param\":null,\"code\":\"queue_full\"}}"
text svthl1 "{\"status\":\"ok\",\"in_flight\":"
text svthl2 ",\"queued\":"
text svthl3 ",\"capacity\":"
text svthl4 ",\"busy\":"
text svttru "true"
text svtfal "false"

note svqput: the request read on cs/io with body bd[0, n) into a free slot; false when all are taken
fn svqput cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 n ulong to bool
s = jsnone
for i ulong SVQCAP
if eq get svqst i 0
s = i
break
end
end
if eq s jsnone
ret false
end
b = mul s 320
for k ulong 320
put svqcs add b k get cs k
end
b = mul s 131072
for k ulong 131072
put svqio add b k get io k
end
b = mul and s 15 983040
if lt s 16
for k ulong n
put svqb0 add b k get bd k
end
else
for k ulong n
put svqb1 add b k get bd k
end
end
put svqln s n
put svqsq s get svqn 1
put svqat s ulong monons
put svqst s 1
put svqn 1 add get svqn 1 1
put svqn 0 add get svqn 0 1
ret true
end

note svqold: the waiting slot of the lowest sequence, or jsnone
fn svqold to ulong
s = jsnone
q = jsnone
for i ulong SVQCAP
if eq get svqst i 1
if lt get svqsq i q
q = get svqsq i
s = i
end
end
end
ret s
end

note svqget: slot s back into cs, io and bd; frees it; the body length
fn svqget s ulong cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 to ulong
b = mul s 320
for k ulong 320
put cs k get svqcs add b k
end
b = mul s 131072
for k ulong 131072
put io k get svqio add b k
end
n = get svqln s
b = mul and s 15 983040
if lt s 16
for k ulong n
put bd k get svqb0 add b k
end
else
for k ulong n
put bd k get svqb1 add b k
end
end
put svqst s 0
put svqn 0 sub get svqn 0 1
ret n
end

note svqpoll: close and free every waiting slot whose client has left (logged 499)
fn svqpoll to void
if eq get svqn 0 0
ret
end
for i ulong SVQCAP
if eq get svqst i 1
fd = get svqcs mul i 320
r = recv int fd svpk 0 1 66
gone = eq r 0
if and lt r 0 and ne r -11 ne r -4
gone = true
end
if gone
y = fclose int fd
put svqst i 0
put svqn 0 sub get svqn 0 1
svlogq 499 4 div sub ulong monons get svqat i 1000000
end
end
end
end

fn svlogq st ulong fin ulong ms ulong to void
oputc 67
oputc 32
oputu st
oputc 32
oputc 48
oputc 32
oputc 48
oputc 32
oputu fin
oputc 32
oputu ms
oputc 32
oputc 48
oputc 32
oputc 48
oputc 32
oputu ms
oputc 10
oflush
end

note svq503: queue_full with Retry-After: 1
fn svq503 cs edit ulong 320 io edit uchar 131072 to long
r = hrspst cs io 503
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhname cs io svtra
r = hfe r hhval cs io svone
r = hfe r hhend cs io 0 len svtq503
r = hfe r hput cs io svtq503
ret hfe r hwfin cs io
end

note svhb: text t into b at p; the next p
fn svhb b edit uchar 640 p ulong t view uchar * to ulong
q = p
for i ulong len t
put b q get t i
q = add q 1
end
ret q
end

fn svhd b edit uchar 640 p ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for k ulong sub 20 i
put b q get d add i k
q = add q 1
end
ret q
end

note svhlth: GET /health {"status":"ok","in_flight":N,"queued":Q,"capacity":32,"busy":B,
note "model":{...}} (the loaded identity, section loaded identity)
fn svhlth cs edit ulong 320 io edit uchar 131072 to long
b = new uchar 640 0
f = get svqn 2
p = svhb b 0 svthl1
p = svhd b p f
p = svhb b p svthl2
p = svhd b p get svqn 0
p = svhb b p svthl3
p = svhd b p SVQCAP
p = svhb b p svthl4
if eq f 1
p = svhb b p svttru
else
p = svhb b p svtfal
end
p = svidj b p
ret svstat cs io 200 view part b 0 p
end

note ======== loaded identity (DRA-125 deploy, docs/omegallm/DEPLOY.md)
note svidn, filled once at start after both loads succeeded: 0 checkpoint magic, 1 .. 7 V T D H F L B,
note 8 step, 9 P, 10 ck_fnv, 11 merges kind (1 OLLMTOK1, 2 v1 OLLMBPE1), 12 merges V, 13 tok_fnv,
note 14 checkpoint bytes, 15 rope base f64 bits (CK03; 0 for CK01/CK02, which have no rope).
note DRA-420: every checkpoint value comes from the load itself (ckpt.om ockhd / ockid: the header
note bytes the loader admitted and the payload FNV-1a 64 it recomputed, read through one held
note descriptor), never from the file on disk afterwards, so replacing the file under a running
note server cannot change what /health reports. GET /health appends them as "model":{"ck":MAGIC,
note "V":..,"T":..,"D":..,"H":..,"F":..,"L":..,"B":..,"step":..,"P":..,"ck_bytes":..,
note "ck_fnv":HEX16,"rope":HEX16|null,"tok":KIND,"tok_V":..,"tok_fnv":HEX16|null}. Mutant id
note (OMUTID 0) reports ck_fnv xor 1, which the deploy live check
note (tests/omegallm/deploy/mancheck.om live) must refuse.
const OMUTID ulong 1
global svidn ulong 16
text svi0 ",\"model\":{\"ck\":\""
text svi1 "\",\"V\":"
text svi2 ",\"T\":"
text svi3 ",\"D\":"
text svi4 ",\"H\":"
text svi5 ",\"F\":"
text svi6 ",\"L\":"
text svi7 ",\"B\":"
text svi8 ",\"step\":"
text svi9 ",\"P\":"
text svia ",\"ck_bytes\":"
text svib ",\"ck_fnv\":\""
text svir "\",\"rope\":\""
text svirn "\",\"rope\":null"
text svic "\",\"tok\":\""
text svicn ",\"tok\":\""
text svit1 "OLLMTOK1"
text svitb "OLLMBPE1"
text svif "\",\"tok_V\":"
text svig ",\"tok_fnv\":\""
text svih "\"}}"
text svinul ",\"tok_fnv\":null}}"

note svck8: little-endian u64 at ockhd[o .. o + 8), the admitted checkpoint header
fn svck8 o ulong to ulong
v = ulong 0
for k ulong 8
v = or v shl ulong get ockhd add o k mul k 8
end
ret v
end

note svidck: the identity of the checkpoint the loader admitted (ockhd, ockid), after its load
fn svidck to void
if ne get ockid 2 1
exit 14
end
mg = svck8 0
put svidn 0 mg
for i ulong 7
put svidn add i 1 svck8 mul add i 1 8
end
put svidn 8 svck8 72
put svidn 9 svck8 96
h = get ockid 1
if eq OMUTID 0
h = xor h 1
end
put svidn 10 h
put svidn 14 get ockid 0
put svidn 15 0
if eq mg XCK3
put svidn 15 svck8 112
end
end

note svidtk: the merges identity, after otload succeeded
fn svidtk to void
if otison
put svidn 11 1
put svidn 12 get otkm 1
h = ulong 0
for k ulong 8
h = or h shl ulong get tkmf add 24 k mul k 8
end
put svidn 13 h
else
put svidn 11 2
put svidn 12 get og 0
end
end

note svhx: v as 16 lowercase hex digits at b[p ..)
fn svhx b edit uchar 640 p ulong v ulong to ulong
q = p
for i ulong 16
d = and shr v mul sub 15 i 4 15
if lt d 10
put b q uchar add d 48
else
put b q uchar add d 87
end
q = add q 1
end
ret q
end

note svidj: the "model" member and the closing brace of /health at b[p ..)
fn svidj b edit uchar 640 p ulong to ulong
q = svhb b p svi0
mg = get svidn 0
for k ulong 8
put b add q k uchar and shr mg mul k 8 255
end
q = add q 8
q = svhb b q svi1
q = svhd b q get svidn 1
q = svhb b q svi2
q = svhd b q get svidn 2
q = svhb b q svi3
q = svhd b q get svidn 3
q = svhb b q svi4
q = svhd b q get svidn 4
q = svhb b q svi5
q = svhd b q get svidn 5
q = svhb b q svi6
q = svhd b q get svidn 6
q = svhb b q svi7
q = svhd b q get svidn 7
q = svhb b q svi8
q = svhd b q get svidn 8
q = svhb b q svi9
q = svhd b q get svidn 9
q = svhb b q svia
q = svhd b q get svidn 14
q = svhb b q svib
q = svhx b q get svidn 10
if eq get svidn 15 0
q = svhb b q svirn
q = svhb b q svicn
else
q = svhb b q svir
q = svhx b q get svidn 15
q = svhb b q svic
end
if eq get svidn 11 1
q = svhb b q svit1
else
q = svhb b q svitb
end
q = svhb b q svif
q = svhd b q get svidn 12
if eq get svidn 11 1
q = svhb b q svig
q = svhx b q get svidn 13
q = svhb b q svih
else
q = svhb b q svinul
end
ret q
end

note ======== requests during a generation

note svwait: wait up to tmo ns for the listener or a pending connection (svpfd); the connection to
note serve now (bytes arrived, or it closed or failed), or -1. A new connection whose first byte
note does not arrive within 20 ms waits in a free pending slot (8; all taken: new connections stay
note in the listen backlog), so a connection that sends nothing costs the caller 20 ms once, not a
note head deadline. A pending connection is closed unanswered 10 s after its accept.
fn svwait sv edit ulong 64 tmo long to long
now = ulong monons
iv = tmo
n = ulong 0
for i ulong 8
f = get svpfd i
if ne f 0
age = sub now get svpat i
if ge age 10000000000
y = fclose int sub f 1
put svpfd i 0
else
rm = long sub 10000000000 age
if or lt iv 0 lt rm iv
iv = rm
end
svprec n sub f 1
put svpix n i
n = add n 1
end
end
end
fr = lt n 8
m = n
if fr
svprec n get sv 36
m = add n 1
end
r = pollfds svpl 0 mul m 8 iv
if le r 0
ret -1
end
for j ulong n
if ne get svpl add mul j 8 6 0
s = get svpix j
cp = long sub get svpfd s 1
put svpfd s 0
ret cp
end
end
if not fr
ret -1
end
c = haccept int get sv 36 0
if lt c 0
ret -1
end
w = waitio int c 1 long 20000000
if ne w 0
ret c
end
for k ulong 8
if eq get svpfd k 0
put svpfd k ulong add c 1
put svpat k ulong monons
ret -1
end
end
y2 = fclose int c
ret -1
end

note svprec: pollfd record j for descriptor fd, events POLLIN
fn svprec j ulong fd ulong to void
b = mul j 8
put svpl b uchar and fd 255
put svpl add b 1 uchar and shr fd 8 255
put svpl add b 2 uchar and shr fd 16 255
put svpl add b 3 uchar and shr fd 24 255
put svpl add b 4 1
put svpl add b 5 0
put svpl add b 6 0
put svpl add b 7 0
end

note svgone: whether the client of the generating request has left: a non-blocking peek (MSG_PEEK |
note MSG_DONTWAIT) of its socket reads end of stream or an error. Request bytes stay unread. A
note client that half-closes its sending side after the request counts as gone.
fn svgone cs edit ulong 320 to bool
r = recv int get cs HFD svpk 0 1 66
if eq r 0
ret true
end
ret and lt r 0 and ne r -11 ne r -4
end

note svside: serve the connections svwait yields (the first wait up to tmo ns, then without waiting;
note at most 9 per call) with svside2
fn svside bd edit uchar 983040 sv edit ulong 64 tmo long to void
c = svwait sv tmo
for k ulong 9
if lt c 0
ret
end
svside2 c bd sv
c = svwait sv 0
end
end

note svside2: one request while a completion generates: health, models, a chat completion into the
note queue (svqput; 503 queue_full when full), else 503 server_busy (logged; a queued one is not
note logged or closed here: its slot owns the descriptor)
fn svside2 c long bd edit uchar 983040 sv edit ulong 64 to void
cs = new ulong 320 0
io = new uchar 131072 0
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret
end
note bytes have arrived (svwait), so a head or body that stalls costs at most 250 ms or 1 s
hsettmo cs 250000000 250000000
hsetbdl cs 1000000000
put cs HBCAP 983040
r = hreqrd cs io
if gt r 0
put cs HKEEP 0
st = svbusy cs io bd
if eq st 0
ret
end
svlogs st
else
if lt r 0
x = hreject cs io r
end
end
x = hclose cs
end

fn svbusy cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 to ulong
if and hispath cs io svphlth hismeth cs io svmget
x = svhlth cs io
ret 200
end
if and hispath cs io svpchat hismeth cs io svmpost
n = hbodyall cs io bd
if lt n 0
put cs HKEEP 0
if eq n HEBIG
x = hrsperr cs io 413
ret 413
end
x = hrsperr cs io 400
ret 400
end
if svqput cs io bd ulong n
ret 0
end
x = svq503 cs io
ret 503
end
if and hispath cs io svpmods hismeth cs io svmget
x = svstat cs io 200 svtmods
ret 200
end
note read the body before answering, so the client sees the 503 rather than a reset
n = hbodyall cs io bd
x = svs503 cs io
ret 503
end

fn svlogs st ulong to void
oputc 67
oputc 32
oputu st
for i ulong 7
oputc 32
oputc 48
end
oputc 10
oflush
end

note ======== serving

note svid: response id chatcmpl-ollm-<request count> into wb[82176 ..), its length into sv15
fn svid wb edit uchar 1073664 sv edit ulong 64 to void
put sv 9 add get sv 9 1
p = svmcat wb 82176 82240 svidp
p = svmdec wb p 82240 get sv 9
put sv 15 sub p 82176
end

fn svlog sv edit ulong 64 to void
oputc 67
oputc 32
oputu get sv 21
oputc 32
oputu get sv 6
oputc 32
oputu get sv 7
oputc 32
oputu get sv 8
oputc 32
oputu div sub ulong monons get sv 11 1000000
oputc 32
oputu get sv 44
oputc 32
oputu get sv 45
oputc 32
oputu get sv 54
oputc 10
oflush
end

note svprep: the prompt tokens (v1: token 0, then the template's encoding; CHAT1: c1conv's tokens
note then 259) and the forced tokens; 0 or 11 (prompt + 1 > T)
fn svprep wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq get sv 40 0
put svpn 0 0
put svpn 1 0
c1put 0
np = svenc view part wb 90624 get sv 5 get sv 5 0
else
put svpn 1 0
c1put 259
end
put sv 6 get svpn 0
if ge get sv 6 get sv 19
ret 11
end
if eq get sv 25 1
c = ulong 0
if gt get sv 26 0
if eq get sv 40 1
c = c1fenc wb get sv 26
else
c = svenc view part wb 8192 get sv 26 get sv 26 1
end
end
if gt c 4096
c = 4096
end
put sv 24 c
end
ret 0
end

note svchat: POST /v1/chat/completions
fn svchat cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to long
note the request's clock and log fields come from svroute (svbeg)
n = hbodyall cs io bd
if lt n 0
put cs HKEEP 0
if eq n HEBIG
put sv 16 13
r = svfail cs io wb sv 413
svlog sv
ret r
end
put sv 21 400
svlog sv
ret hrsperr cs io 400
end
put svqn 2 1
r = svchatb cs io bd ulong n wb sv
put svqn 2 0
ret r
end

note svchatb: a chat completion whose body bd[0, n) has been read (svchat, or svqrun for a queued one)
fn svchatb cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 n ulong wb edit uchar 1073664 sv edit ulong 64 to long
note generation outlasts the 60 s body deadline: only the idle limit applies from here
hsetdl cs 0
e = svparse bd n wb sv
if eq e 0
e = svprep wb sv
end
if eq e 0
svmld sv
end
if ne e 0
put sv 16 e
st = ulong 400
if eq e 25
st = ulong 413
end
r = svfail cs io wb sv st
svlog sv
ret r
end
svid wb sv
put sv 10 ulong div realns 1000000000
ob = new uchar 409600 0
put sv 21 200
if eq get sv 0 1
r = hrspsse cs io
r = hfe r svchunk cs io ob wb sv 0
if lt r 0
svlog sv
ret r
end
r = svgen cs io ob wb sv bd
if lt r 0
svlog sv
ret r
end
r = svchunk cs io ob wb sv 2
if eq get sv 4 1
r = hfe r svchunk cs io ob wb sv 3
end
r = hfe r hssedat cs io svdone
r = hfe r hsseend cs io
r = hfe r hwfin cs io
svlog sv
ret r
end
r = svgen cs io ob wb sv bd
if lt r 0
svlog sv
ret r
end
m = svfull ob wb sv bd
if lt m 0
put sv 16 16
r = svfail cs io wb sv 500
svlog sv
ret r
end
r = svsend cs io ob 200 ulong m
svlog sv
ret r
end

fn svroute cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to long
svbeg sv
if hispath cs io svpchat
if hismeth cs io svmpost
ret svchat cs io bd wb sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svphlth
if hismeth cs io svmget
put sv 21 200
r = svhlth cs io
svlog sv
ret r
end
ret svend cs io wb sv 15 405
end
if hispath cs io svpmods
if hismeth cs io svmget
ret svok cs io sv svtmods
end
ret svend cs io wb sv 15 405
end
ret svend cs io wb sv 14 404
end

note svbeg: a request's log fields cleared, its clock started
fn svbeg sv edit ulong 64 to void
put sv 11 ulong monons
put sv 6 0
put sv 7 0
put sv 8 0
put sv 44 0
put sv 45 0
put sv 54 0
end

note svend: error code e with status st, logged
fn svend cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 e ulong st ulong to long
put sv 16 e
r = svfail cs io wb sv st
svlog sv
ret r
end

note svok: the fixed JSON text t with status 200, logged
fn svok cs edit ulong 320 io edit uchar 131072 sv edit ulong 64 t view uchar * to long
put sv 21 200
r = svstat cs io 200 t
svlog sv
ret r
end

note svconn: one accepted connection c carries one request, answered with Connection: close.
note Connections are served one at a time, so a kept-alive idle connection would hold the listener:
note allen-chat pools its upstream connection, and its next request queued 30 s behind the pooled
note one (the old idle limit) until this change. svwait hands over a connection only once its first
note bytes arrived; the rest of the head must arrive within 10 s.
fn svconn c long cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret
end
hsettmo cs 10000000000 10000000000
hsetbdl cs 60000000000
note the JSON parser takes at most 983040 bytes (jsmaxn); larger Content-Length is 413 at the head
put cs HBCAP 983040
r = hreqrd cs io
if eq r HEBIG
put cs HKEEP 0
svbeg sv
x = svend cs io wb sv 13 413
end
if and lt r 0 ne r HEBIG
x = hreject cs io r
end
if gt r 0
put cs HKEEP 0
x = svroute cs io bd wb sv
end
x = hclose cs
end

note svqrun: serve queued slot s (its clock from its arrival; sv54 the wait in ms), then close it
fn svqrun s ulong cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
ta = get svqat s
n = svqget s cs io bd
hsettmo cs 10000000000 10000000000
svbeg sv
put sv 11 ta
put sv 54 div sub ulong monons ta 1000000
put svqn 2 1
x = svchatb cs io bd n wb sv
put svqn 2 0
y = hclose cs
end

note svpre: whether the argument in oarg (length n) starts with t
fn svpre n ulong t view uchar * to bool
if lt n len t
ret false
end
for i ulong len t
if ne get oarg i get t i
ret false
end
end
ret true
end

note svdig: the decimal oarg[a, n) (1 .. 7 digits), or 0
fn svdig a ulong n ulong to ulong
if or le n a gt sub n a 7
ret 0
end
v = ulong 0
for i ulong sub n a
c = ulong get oarg add a i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub c 48
end
ret v
end

note svcli: the options after MERGES: [MAXCONN] (first only), tplmax=N, test=1; MAXCONN
fn svcli sv edit ulong 64 na ulong to ulong
mx = ulong 1000000
for j ulong sub na 5
i = add j 5
n = oargp i
if svpre n svoptt
v = svdig 7 n
if or lt v 256 gt v 983040
exit 2
end
put sv 23 v
put sv 53 1
else
if and eq n len svopte svpre n svopte
put sv 22 1
else
if ne i 5
exit 2
end
mx = oargu 5
if eq mx 0
exit 2
end
end
end
end
ret mx
end

note serve PORT CK MERGES [MAXCONN] [tplmax=N] [test=1]
fn cmdserve to void
na = oargc
if or lt na 5 gt na 8
exit 2
end
port = oargu 2
if or eq port 0 gt port 65535
exit 2
end
sv = new ulong 64 0
put sv 23 65536
mx = svcli sv na
if eq xpeek 3 XCK3
xload 3
xgd
put xg 47 0
put xg 48 0
put sv 41 4
else
ockload 3
put sv 41 3
end
svidck
v = get og 0
otload 4 v
svidtk
if otison
put sv 40 1
if eq get sv 53 0
put sv 23 983040
end
end
cs = new ulong 320 0
io = new uchar 131072 0
bd = new uchar 983040 0
wb = new uchar 1073664 0
a = new uchar 16 0
put sv 19 get og 1
x = svmcat wb 74752 74763 svtco
x = svmcat wb 74763 74775 svtcc
r = haddr4 a 2130706433 port
lf = hlisten a 16
if lt lf 0
exit 71
end
put sv 36 ulong lf
for i ulong len svport
oputc ulong get svport i
end
oputu port
oputc 10
oflush
svloop cs io bd wb sv mx
y = fclose int lf
end

note svloop: serve until mx requests (queued first, oldest first; then new connections)
fn svloop cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 mx ulong to void
nc = ulong 0
for j ulong 999999999
s = svqold
if ne s jsnone
svqrun s cs io bd wb sv
nc = add nc 1
if ge nc mx
break
end
continue
end
c = svwait sv 60000000000
if ge c 0
svconn c cs io bd wb sv
nc = add nc 1
if ge nc mx
break
end
end
end
end

note ======== chatenc MERGES IN.jsonl OUT.u16 [MASK.u8]

note chatenc: each non-empty line of IN.jsonl, one OpenAI-format JSON object {"messages":[...],
note "tools":[...]} (other members as a chat request's, checked the same way), through svparse's
note CHAT1 path (c1conv: exactly the tokens serve builds before its generation prompt 259), appended
note to OUT.u16 as u16 little-endian; MASK.u8 gets one byte per token, 1 for the assistant tokens
note after each 259 (content, tool calls, the closing 256), else 0. Prints `H lines tokens masked`.
note OUT and MASK are written in place (created, emptied). Exits: 2 usage; 26 MERGES not OLLMTOK1 or
note bad; 21 a line over 983040 bytes or a conversation over 65536 tokens; 22 a line refused
note (stdout `F line code`, the code as serve's error codes); 70 I/O. Mutant c1 (OMUTC1 0) drops
note each conversation's first token in chatenc's writer only (serve's path keeps it), the shift
note the DRA-123 shared-template test must catch.
const OMUTC1 ulong 1
global c1ob uchar 65536
global c1mb uchar 32768
global c1st ulong 8

note c1st: 0 OUT fd, 1 MASK fd (0 none), 2 bytes in c1ob, 3 bytes in c1mb, 4 lines, 5 tokens,
note 6 masked tokens; IN window: opw[0, 7)

note c1open: create/empty the file named by argument ai; its descriptor
fn c1open ai ulong to ulong
pl = oargp ai
if gt pl 2000
exit 2
end
fd = int fopen oarg 0 pl 577 420
if lt fd 0
exit 70
end
ret ulong fd
end

fn c1wall fd ulong n ulong mk ulong to void
p = ulong 0
while lt p n bound 999999
w = long 0
if eq mk 0
w = write int fd c1ob p sub n p
else
w = write int fd c1mb p sub n p
end
if le w 0
exit 70
end
p = add p ulong w
end
end

fn c1flush to void
c1wall get c1st 0 get c1st 2 0
put c1st 2 0
if ne get c1st 1 0
c1wall get c1st 1 get c1st 3 1
end
put c1st 3 0
end

note c1emit: the conversation svpt[0, np) to the outputs
fn c1emit to void
np = get svpn 0
if gt np 65536
exit 21
end
s = ulong 0
if eq OMUTC1 0
s = 1
end
for i ulong sub np s
j = add i s
if ge get c1st 2 65536
c1flush
end
b = get c1st 2
t = get svpt j
put c1ob b uchar and t 255
put c1ob add b 1 uchar shr t 8
put c1st 2 add b 2
m = get c1st 3
k = get svpm j
put c1mb m k
put c1st 3 add m 1
put c1st 6 add get c1st 6 ulong k
end
put c1st 5 add get c1st 5 np
end

note c1line: one line opw[a, a + n) (n > 0); exits 21 or 22 when refused
fn c1line a ulong n ulong bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
if gt n 983040
exit 21
end
for i ulong n
put bd i get opw add a i
end
put c1st 4 add get c1st 4 1
e = svparse bd n wb sv
if ne e 0
oputc 70
oputc 32
oputu get c1st 4
oputc 32
oputu e
oputc 10
oflush
exit 22
end
c1emit
end

note c1fill: move opw[a, have) to the front and read on from file position pos; the new fill
fn c1fill a ulong have ulong pos ulong to ulong
m = sub have a
for i ulong m
put opw i get opw add a i
end
r = oprd 3 add pos m m sub 2097152 m
ret add m r
end

fn cmdchatenc to void
na = oargc
if and ne na 5 ne na 6
exit 2
end
if not otis1 2
exit 26
end
otload 2 tkrdv 2
sv = new ulong 64 0
bd = new uchar 983040 0
wb = new uchar 1073664 0
put sv 40 1
put sv 23 983040
for k ulong 8
put c1st k 0
end
put c1st 0 c1open 4
if eq na 6
put c1st 1 c1open 5
end
c1scan bd wb sv
c1flush
oputc 72
oputc 32
oputu get c1st 4
oputc 32
oputu get c1st 5
oputc 32
oputu get c1st 6
oputc 10
oflush
end

note c1scan: the lines of IN (argument 3) through a 2 MiB window of opw
fn c1scan bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
pos = ulong 0
have = oprd 3 0 0 2097152
a = ulong 0
eof = lt have 2097152
for it ulong 999999999
if ge a have
if eof
ret
end
end
q = a
while and lt q have le sub q a 983040 bound 999999
if eq get opw q 10
break
end
q = add q 1
end
if lt q have
if gt q a
c1line a sub q a bd wb sv
end
a = add q 1
else
if eof
c1line a sub have a bd wb sv
ret
end
if eq a 0
exit 21
end
pos = add pos a
have = c1fill a have pos
a = 0
eof = lt have 2097152
end
end
end

note tkrdv: V of the OLLMTOK1 file argument ai (bytes 8 .. 15), read through opw
fn tkrdv ai ulong to ulong
r = oprd ai 0 0 16
v = ulong 0
for k ulong 8
v = or v shl ulong get opw add 8 k mul k 8
end
ret v
end
