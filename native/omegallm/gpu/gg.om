note SPDX-License-Identifier: AGPL-3.0-only
note gg.om: ollm GPU gradient (aien-train#52, rung 4). The step loss and its gradient for the batch in
note obx/oby, computed on the GB10 by gk.om GEMMs and gr.om row kernels over all R = B T rows at
note once in f32; the gradient lands in ogr[0..P) as f64 and the loss in olos, so oadam and olsum run
note unchanged on the CPU. Arena (gbmem 5) byte offsets in gga: 0 W, 1 G, 2 X, 3 Y, 4 CSR start
note (V + 1), 5 CSR order (R), 6 first layer, 7 layer stride, 8 HF, 9 SF, 10 Z, 11 logits (R V),
note 12 CE stats (R 3), 13 DH, 14 DA, 15 DQ DK DU (contiguous), 16 DO, 17 DF, 18 DP, 19 WS, 20 CS;
note layer fields 24 + f: 0 hin 1 a 2 q 3 k 4 u 5 o 6 hm 7 bn 8 s1 9 s2 10 fp 11 rl 12 P;
note 40 the arena device address, 47 the plan cursor. s1, s2 and SF hold 1/s (the CPU keeps s).
global gga ulong 48
global ggcn ulong 65537
note byte strides: 0 D, 1 T D, 2 E, 3 T, 4 T T, 5 H T T, 6 R D, 7 D D (each times 4)
global ggs uint 8
note OMUTG: 1 in the product; 0 in mutant g (DK = -DS^T Q), which the parity check must catch.
const OMUTG ulong 1

fn ggdie c ulong to void
oputc 71
oputc 88
oputc 32
oputu c
oputc 32
oputl get nverr 0
oputc 32
oputu ulong get nvstage 0
note diagnostics: launches done, mark1, mark2, QMD semaphore
oputc 32
oputl get gkt 0
oputc 32
oputu mapget get gbmem 3 0 4
oputc 32
oputu mapget get gbmem 3 16 4
oputc 32
oputu mapget get gbmem 2 8192 4
oputc 10
oflush
exit 84
end

fn ggcd n ulong k ulong to ulong
ret div add n sub k 1 k
end

fn ggr to ulong
ret mul get og 6 get og 1
end

note P rounded up to the SQN chunk of 512; the gradient buffer is that long and zeroed to it
fn ggp5 to ulong
ret mul ggcd get og 8 512 512
end

fn ggput i ulong n ulong to void
c = get gga 47
put gga i c
b = mul div add mul n 4 255 256 256
put gga 47 add c b
end

note arena plan for the dims in og; returns its size in bytes
fn ggplan to ulong
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
bb = get og 6
r = ggr
rd = mul r d
pp = mul mul bb h mul tt tt
put gga 47 0
for i ulong 8
ggput add 24 i rd
end
ggput 32 r
ggput 33 r
ggput 34 mul r f
ggput 35 mul r f
ggput 36 pp
put gga 7 get gga 47
put gga 47 0
ggput 0 get og 8
ggput 1 ggp5
ggput 2 r
ggput 3 r
ggput 4 add get og 0 1
ggput 5 r
put gga 6 get gga 47
ls = mul get gga 7 get og 5
put gga 47 add get gga 47 ls
ggput 8 rd
ggput 9 r
ggput 10 rd
ggput 11 mul r get og 0
ggput 12 mul r 3
ggput 13 rd
ggput 14 rd
ggput 15 mul rd 3
ggput 16 rd
ggput 17 mul r f
ggput 18 pp
ggput 19 rd
ggput 20 mul bb d
ggput 21 get og 8
ggput 22 get og 8
ggput 23 div ggp5 512
ret get gga 47
end

fn gga1 i ulong to ulong
ret add get gga 40 get gga i
end

fn ggl l ulong f ulong to ulong
o = add get gga 6 mul l get gga 7
ret add add get gga 40 o get gga add 24 f
end

note address of the output of layer l (the next hin, or HF after the last layer)
fn ggout l ulong to ulong
if lt add l 1 get og 5
ret ggl add l 1 0
end
ret gga1 8
end

fn ggw o ulong to ulong
ret add gga1 0 mul o 4
end

fn ggg o ulong to ulong
ret add gga1 1 mul o 4
end

note GEMM tiles need m, n multiples of 32 and k of 16: V T D F E multiples of 32; R = B T
fn ggok to bool
for i ulong 5
v = get og i
if eq i 3
v = get og 7
end
if eq i 1
v = get og 1
end
if or eq v 0 ne rem v 32 0
ret false
end
end
if gt get og 0 65536
ret false
end
ret le mul get og 6 get og 3 65535
end

note open the chip and emit the kernels for the dims in og
fn ggopen to void
if not ggok
ggdie 1
end
asz = ggplan
v = get og 0
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
bb = get og 6
grset v tt d h f bb
if not gropen asz
ggdie 2
end
put gga 40 gkbase
ggstr
end

note pointer j (1-based) into arg slots 2j, 2j + 1
fn ggpt j uint a ulong to void
put gkarg mul j 2 gblo a
put gkarg add mul j 2 1 gbhi a
end

fn ggu s uint v ulong to void
put gkarg s uint v
end

fn ggrun id uint na uint gx ulong gy ulong gz ulong to void
put gkna 0 na
x = uint gx
y = uint gy
z = uint gz
if not gklaunch id x y z
ggdie add 100 ulong id
end
end

fn ggmm m ulong n ulong k ulong nz ulong h2 ulong bt bool to void
a = uint m
b = uint n
c = uint k
e = uint nz
g = uint h2
if not gkmm a b c e g bt
ggdie 99
end
end

note C[R][n] (+)= X[R][k] W[k][n]
fn ggxw x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w 4 n4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm ggr n k 1 1 bt
end

note C[R][n] (+)= X[R][k] W[n][k]^T
fn ggxwt x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w k4 4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm ggr n k 1 1 bt
end

note G[kk][n] += X[R][kk]^T DY[R][n]
fn ggwg x ulong dy ulong g ulong kk ulong n ulong to void
k4 = uint mul kk 4
n4 = uint mul n 4
gkopa 0 x 4 k4 0 0
gkopa 1 dy 4 n4 0 0
gkopc g n4 4 0 0 f32 1.0f64
ggmm kk n ggr 1 1 true
end

note 17 RELUF, 18 RELUB, 19 COPY (x into y), 20 ZERO (x) over n elements
fn ggew id uint n ulong x ulong y ulong to void
ggu 0 n
ggpt 1 x
ggpt 2 y
ggrun id 6 ggcd n 64 1 1
end

fn ggrmsf v ulong g ulong y ulong s ulong to void
r = ggr
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 y
ggpt 4 s
ggrun 10 10 ggcd r 64 1 1
end

note dh += RMS backward of da; the gain terms go to WS
fn ggrmsb v ulong g ulong s ulong to void
r = ggr
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 s
ggpt 4 gga1 14
ggpt 5 gga1 13
ggpt 6 gga1 19
ggrun 11 14 ggcd r 64 1 1
end

note gain gradient at parameter offset go += column sums of WS: per sequence (slot 13), then over B
fn ggain go ulong to void
d = get og 2
tt = get og 1
bb = get og 6
ggu 0 d
ggu 1 tt
ggpt 1 gga1 19
ggu 4 mul d 4
ggu 5 mul mul tt d 4
ggpt 3 gga1 20
ggu 8 mul d 4
ggrun 13 9 ggcd d 64 bb 1
ggu 0 d
ggu 1 bb
ggpt 1 gga1 20
ggu 4 mul d 4
ggu 5 0
ggpt 3 ggg go
ggu 8 0
ggrun 14 9 ggcd d 64 1 1
end

fn ggsoft id uint p ulong dp ulong to void
tt = get og 1
ggu 0 tt
ggpt 1 p
ggpt 2 dp
ggrun id 6 ggcd tt 64 mul get og 6 get og 3 1
end

note attention GEMM over the B H (sequence, head) batch; operands set by gghd/ggpl/ggch/ggcp first
fn ggbh m ulong n ulong k ulong bt bool to void
ggmm m n k mul get og 6 get og 3 get og 3 bt
end

note head-layout operand (rows of E inside D-wide rows, batch b then head); tr: k runs along rows
fn gghd ab uint p ulong tr bool to void
s0 = get ggs 0
s1 = get ggs 1
s2 = get ggs 2
if tr
gkopa ab p 4 s0 s1 s2
else
gkopa ab p s0 4 s1 s2
end
end

note T x T score operand (batch b then head); tr: transposed
fn ggpl ab uint p ulong tr bool to void
s3 = get ggs 3
s4 = get ggs 4
s5 = get ggs 5
if tr
gkopa ab p 4 s3 s5 s4
else
gkopa ab p s3 4 s5 s4
end
end

fn ggch c ulong al f64 to void
s0 = get ggs 0
s1 = get ggs 1
s2 = get ggs 2
gkopc c s0 4 s1 s2 f32 al
end

fn ggcp c ulong al f64 to void
s3 = get ggs 3
s4 = get ggs 4
s5 = get ggs 5
gkopc c s3 4 s5 s4 f32 al
end

note stride table for the dims in og (bytes)
fn ggstr to void
d = get og 2
tt = get og 1
put ggs 0 uint mul d 4
put ggs 1 uint mul tt mul d 4
put ggs 2 uint mul get og 7 4
put ggs 3 uint mul tt 4
put ggs 4 uint mul tt mul tt 4
put ggs 5 uint mul get og 3 mul tt mul tt 4
put ggs 6 uint mul ggr mul d 4
put ggs 7 uint mul d mul d 4
end

note q, k, u = a wq, a wk, a wv as one batched GEMM (wq wk wv and q k u are contiguous)
fn ggqkv l ulong to void
d = get og 2
a = ggl l 1
w = ggw opwq l
c = ggl l 2
s0 = get ggs 0
s6 = get ggs 6
s7 = get ggs 7
gkopa 0 a s0 4 0 0
gkopa 1 w 4 s0 0 s7
gkopc c s0 4 0 s6 f32 1.0f64
ggmm ggr d d 3 3 false
end

note P = softmax(q k^T / sqrt(E)), o = P u
fn ggatt l ulong to void
tt = get og 1
e = get og 7
pp = ggl l 12
q = ggl l 2
k = ggl l 3
gghd 0 q false
gghd 1 k false
isq = div 1.0f64 fsqrt f64 e
ggcp pp isq
ggbh tt tt e false
ggsoft 15 pp pp
u = ggl l 4
o = ggl l 5
ggpl 0 pp false
gghd 1 u true
ggch o 1.0f64
ggbh tt e tt false
end

note hm = hin + o wo; bn = rms(hm) g2; out = hm + relu(bn w1) w2
fn ggffn l ulong to void
d = get og 2
f = get og 4
rd = mul ggr d
hm = ggl l 6
x = ggl l 0
ggew 19 rd x hm
x = ggl l 5
w = ggw opwo l
ggxw x w hm d d true
x = ggl l 7
w = ggw opg2 l
s = ggl l 9
ggrmsf hm w x s
fp = ggl l 10
w = ggw opw1 l
ggxw x w fp f d false
x = ggl l 11
ggew 17 mul ggr f fp x
o = ggout l
ggew 19 rd hm o
w = ggw opw2 l
ggxw x w o d f true
end

fn ggfl l ulong to void
x = ggl l 0
w = ggw opg1 l
a = ggl l 1
s = ggl l 8
ggrmsf x w a s
ggqkv l
ggatt l
ggffn l
end

fn ggfwd to void
d = get og 2
x = ggl 0 0
ggu 0 d
ggpt 1 x
x = ggw 0
ggpt 2 x
x = ggw get og 30
ggpt 3 x
x = gga1 2
ggpt 4 x
tt = get og 1
bb = get og 6
ggrun 9 10 ggcd d 64 tt bb
for l ulong get og 5
ggfl l
end
x = gga1 8
w = ggw get og 33
z = gga1 10
s = gga1 9
ggrmsf x w z s
x = gga1 11
w = ggw 0
v = get og 0
ggxwt z w x v d false
r = ggr
ggu 0 r
ggpt 1 x
x = gga1 3
ggpt 2 x
x = gga1 12
ggpt 3 x
ggrun 21 8 ggcd r 64 1 1
end

note layer l FFN backward: DH holds d out on entry, d hm on exit
fn ggbffn l ulong to void
d = get og 2
f = get og 4
dh = gga1 13
df = gga1 17
da = gga1 14
w = ggw opw2 l
ggxwt dh w df f d false
x = ggl l 10
ggew 18 mul ggr f x df
x = ggl l 11
w = ggg opw2 l
ggwg x dh w f d
x = ggl l 7
w = ggg opw1 l
ggwg x df w d f
w = ggw opw1 l
ggxwt df w da d f false
x = ggl l 6
w = ggw opg2 l
s = ggl l 9
ggrmsb x w s
ggain opg2 l
end

note layer l attention backward: DO, DP, DU, DS (in DP), DQ, DK, then DA
fn ggbatt l ulong to void
d = get og 2
tt = get og 1
e = get og 7
dh = gga1 13
dn = gga1 16
w = ggw opwo l
ggxwt dh w dn d d false
x = ggl l 5
w = ggg opwo l
ggwg x dh w d d
dp = gga1 18
x = ggl l 4
gghd 0 dn false
gghd 1 x false
ggcp dp 1.0f64
ggbh tt tt e false
pp = ggl l 12
dq = gga1 15
dk = add dq ulong get ggs 6
du = add dk ulong get ggs 6
ggpl 0 pp true
gghd 1 dn true
ggch du 1.0f64
ggbh tt e tt false
ggsoft 16 pp dp
x = ggl l 3
ggpl 0 dp false
gghd 1 x true
ggch dq 1.0f64
ggbh tt e tt false
al = 1.0f64
if eq OMUTG 0
al = neg 1.0f64
end
x = ggl l 2
ggpl 0 dp true
gghd 1 x true
ggch dk al
ggbh tt e tt false
end

note DA = DQ wq^T + DK wk^T + DU wv^T; G wq wk wv += a^T (DQ DK DU) batched; then the rms backward
fn ggbqkv l ulong to void
d = get og 2
da = gga1 14
dq = gga1 15
dk = add dq ulong get ggs 6
du = add dk ulong get ggs 6
w = ggw opwq l
ggxwt dq w da d d false
w = ggw opwk l
ggxwt dk w da d d true
w = ggw opwv l
ggxwt du w da d d true
a = ggl l 1
w = ggg opwq l
s0 = get ggs 0
gkopa 0 a 4 s0 0 0
s6 = get ggs 6
gkopa 1 dq 4 s0 0 s6
s7 = get ggs 7
gkopc w s0 4 0 s7 f32 1.0f64
ggmm d d ggr 3 3 true
x = ggl l 0
w = ggw opg1 l
s = ggl l 8
ggrmsb x w s
ggain opg1 l
end

fn ggbl l ulong to void
ggbffn l
ggbatt l
ggbqkv l
end

fn ggbwd to void
d = get og 2
v = get og 0
tt = get og 1
r = ggr
ggew 20 ggp5 gga1 1 gga1 1
ggew 20 mul r d gga1 13 gga1 13
ggxw gga1 11 ggw 0 gga1 14 d v false
ggwg gga1 11 gga1 10 ggg 0 v d
ggrmsb gga1 8 ggw get og 33 gga1 9
ggain get og 33
l = get og 5
while gt l 0 bound 1000
l = sub l 1
ggbl l
end
td = mul tt d
ggu 0 td
ggu 1 get og 6
ggpt 1 gga1 13
ggu 4 mul td 4
ggu 5 0
ggpt 3 ggg get og 30
ggu 8 0
ggrun 14 9 ggcd td 64 1 1
ggu 0 d
ggpt 1 gga1 13
ggpt 2 gga1 4
ggpt 3 gga1 5
ggpt 4 ggg 0
ggrun 22 10 ggcd d 64 v 1
end

note W[i] as f32 for i in chunk q of P (a loop runs at most 999999 passes)
fn ggupc q ulong p ulong to void
h = get gbmem 5
wo = get gga 0
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = bitcast uint f32 get ow i
m = mapset h add wo mul i 4 4 ulong x
end
end

note upload the f32 parameters
fn ggupw to void
p = get og 8
for q ulong ocn p
ggupc q p
end
put gkinv 0 1
end

note upload the batch tokens and the CSR of x (rows sorted by token)
fn ggupb to void
ggupt
ggcsr
put gkinv 0 1
end

note n values omv[s + j] as f32 to arena byte offset o + 4 j, and back (one chunk of an Adam moment)
fn ggupmc s ulong o ulong n ulong to void
h = get gbmem 5
for j ulong n
x = bitcast uint f32 get omv add s j
m = mapset h add o mul j 4 4 ulong x
end
end

fn ggdnmc s ulong o ulong n ulong to void
h = get gbmem 5
for j ulong n
x = uint mapget h add o mul j 4 4
put omv add s j f64 bitcast f32 x
end
end

note chip parameters of chunk q back into ow as f64
fn ggdnwc q ulong p ulong to void
h = get gbmem 5
o = get gga 0
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = uint mapget h add o mul i 4 4
put ow i f64 bitcast f32 x
end
end

note optimizer state (ow, omv) to the chip as f32 (m in gga 21, v in gga 22), and back
fn ggupst to void
ggupw
p = get og 8
for q ulong ocn p
i0 = mul q OCH
n = sub oce q p i0
ggupmc add get og 11 i0 add get gga 21 mul i0 4 n
ggupmc add get og 12 i0 add get gga 22 mul i0 4 n
end
put gkinv 0 1
end

fn ggdnst to void
p = get og 8
for q ulong ocn p
ggdnwc q p
i0 = mul q OCH
n = sub oce q p i0
ggdnmc add get og 11 i0 add get gga 21 mul i0 4 n
ggdnmc add get og 12 i0 add get gga 22 mul i0 4 n
end
end

fn ggupt to void
h = get gbmem 5
xo = get gga 2
yo = get gga 3
for i ulong ggr
tk = get obx i
m = mapset h add xo mul i 4 4 tk
ty = get oby i
m = mapset h add yo mul i 4 4 ty
end
end

note counting sort of the R rows by input token: start (V + 1) and order (R) arrays
fn ggcsr to void
h = get gbmem 5
v = get og 0
for c ulong add v 1
put ggcn c 0
end
for i ulong ggr
c1 = add get obx i 1
n = add get ggcn c1 1
put ggcn c1 n
end
for c ulong v
c1 = add c 1
n = add get ggcn c1 get ggcn c
put ggcn c1 n
end
so = get gga 4
for c ulong add v 1
n = get ggcn c
m = mapset h add so mul c 4 4 n
end
so = get gga 5
for i ulong ggr
c = get obx i
p = get ggcn c
m = mapset h add so mul p 4 4 i
put ggcn c add p 1
end
end

note ogr[i] = G[i] for i in chunk q of P
fn ggdnc q ulong p ulong to void
h = get gbmem 5
go = get gga 1
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = uint mapget h add go mul i 4 4
put ogr i f64 bitcast f32 x
end
end

fn ggdown to void
p = get og 8
for q ulong ocn p
ggdnc q p
end
end

note one f32 at arena byte offset o, as f64
fn ggf o ulong to f64
x = uint mapget get gbmem 5 o 4
ret f64 bitcast f32 x
end

note row loss from the CE stats (m, sum, l_y) of row r: log(sum) + m - l_y
fn ggrl r ulong to f64
o = add get gga 12 mul r 12
m = ggf o
sm = ggf add o 4
ly = ggf add o 8
ret sub add flog sm m ly
end

fn ggloss to f64
tt = get og 1
for b ulong get og 6
s = 0.0f64
for t ulong tt
s = add s ggrl add mul b tt t
end
put olos b div s f64 tt
end
ret olsum
end

note the step loss and gradient for the batch in obx/oby; ggopen first. full: upload the f32
note parameters first and download the gradient into ogr[0..P) after; otherwise both stay on chip.
note phase wall times (ns): 0 upload, 1 forward, 2 backward, 3 download, 4 loss, 5 on-chip Adam
global ggtm long 6
fn ggpass full bool to f64
t = monons
if full
ggupw
end
ggupb
u = monons
put ggtm 0 sub u t
ggfwd
t = monons
put ggtm 1 sub t u
ggbwd
u = monons
put ggtm 2 sub u t
if full
ggdown
end
t = monons
put ggtm 3 sub t u
l = ggloss
u = monons
put ggtm 4 sub u t
ret l
end

fn gggrad to f64
ret ggpass true
end

note clip and Adam on chip at step og[41], the f32 image of oadam: SQN partial sums of g^2, the
note norm, clip factor, schedule and bias corrections on the host in f64, then ADAM over P
fn ggadam to void
p = get og 8
nc = div ggp5 512
ggu 0 nc
ggpt 1 gga1 1
ggpt 2 gga1 23
ggrun 23 6 ggcd nc 64 1 1
h = get gbmem 5
so = get gga 23
ss = 0.0f64
for c ulong nc
x = uint mapget h add so mul c 4 4
ss = add ss f64 bitcast f32 x
end
nr = fsqrt ss
cl = 1.0f64
if gt nr 1.0
cl = div 1.0 nr
end
s = get og 41
lrs = olrs s bitcast f64 get og 43
bc1 = sub 1.0 opowb 0.9 s
bc2 = sub 1.0 opowb 0.99 s
if eq OMUTC 0
bc1 = 1.0f64
bc2 = 1.0f64
end
ggu 0 p
ggpt 1 gga1 0
ggpt 2 gga1 21
ggpt 3 gga1 22
ggpt 4 gga1 1
ggu 10 ulong grf cl
ggu 11 ulong grf div lrs bc1
ggu 12 ulong grf div 1.0f64 bc2
ggrun 24 13 ggcd p 64 1 1
end

fn ggtms to void
oputc 71
oputc 84
for i ulong 6
oputc 32
oputl get ggtm i
end
for i ulong 4
oputc 32
oputl get gkt i
end
oputc 10
end

note keep the CPU gradient: ogr[P + i] = ogr[i] (chunked: a loop runs at most 999999 passes)
fn ggkeep p ulong to void
for q ulong ocn p
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
put ogr add p i get ogr i
end
end
end

note ggcm[0] = max |ogr[i] - ogr[P + i]|, ggcm[1] = max |ogr[P + i]| over i < P
global ggcm f64 2
fn ggmaxd p ulong to void
put ggcm 0 0.0f64
put ggcm 1 0.0f64
for q ulong ocn p
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
rf = get ogr add p i
dd = sub get ogr i rf
if lt dd 0.0f64
dd = neg dd
end
if lt rf 0.0f64
rf = neg rf
end
if gt dd get ggcm 0
put ggcm 0 dd
end
if gt rf get ggcm 1
put ggcm 1 rf
end
end
end
end

note gcmp CK DATA S: CPU ograd and GPU gradient for batch S; prints
note `GC P maxabs_e12 maxref_e12 rel_e9 cpu_loss_micro gpu_loss_micro gpu_ns tol_e9` and GCMP PASS
note (rel < tol, |loss difference| < 1e-5) or GCMP FAIL (exit 45). tol = R 2^-24 is the first-order
note bound gamma_R on the f32 error of a sum of R = B T rows, the longest reduction of the weight
note gradients, relative to the sum of magnitudes; the CPU reference is f64. ReLU units whose f64
note pre-activation lies within f32 resolution of zero can take the other side on the GPU (receipt:
note evidence/OMEGALLM/gpu/README.md), and both sides are valid subgradients.
fn ggcmp to void
if ne oargc 5
exit 2
end
ockload 2
odopen 3
obatch oargu 4
put og 10 0
lc = ograd
p = get og 8
ggkeep p
ggopen
t0 = monons
lg = gggrad
t1 = monons
ggmaxd p
mx = get ggcm 0
mr = get ggcm 1
rel = div mx mr
dl = sub lg lc
if lt dl 0.0f64
dl = neg dl
end
oputc 71
oputc 67
oputc 32
oputu p
oputc 32
oputl rmic mul mx 1000000.0f64
oputc 32
oputl rmic mul mr 1000000.0f64
oputc 32
oputl rmic mul rel 1000.0f64
oputc 32
oputl rmic lc
oputc 32
oputl rmic lg
oputc 32
oputl sub t1 t0
oputc 32
tol = div f64 ggr 16777216.0f64
oputl rmic mul tol 1000.0f64
oputc 10
ggtms
ok = and lt rel tol lt dl 0.00001f64
r = nvstop
oputc 71
oputc 67
oputc 77
oputc 80
oputc 32
if ok
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
exit 45
end

note gtrain CK TRAIN UNTIL EVERY: cmdtrain with the gradient from the GPU (K = 1, no workers); prints
note `T s+1 loss_micro` at save points like train
fn ggtrain to void
if ne oargc 6
exit 2
end
ockload 2
odopen 3
un = oargu 4
ev = oargu 5
if eq ev 0
exit 2
end
en = get og 42
if lt un en
en = un
end
ggopen
while lt get og 41 en bound 999999
s = get og 41
obatch s
put og 10 0
ls = gggrad
oadam
s1 = add s 1
put og 41 s1
if or eq rem s1 ev 0 eq s1 en
ocksave 2
oputc 84
oputc 32
oputu s1
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
r = nvstop
end

note ogr[P + i] = ow[i], the f64 parameter before the step
fn ggkw q ulong p ulong to void
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
put ogr add p i get ow i
end
end

note ogr[i] = chip parameter i as f64
fn ggdw q ulong p ulong to void
h = get gbmem 5
wo = get gga 0
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = uint mapget h add wo mul i 4 4
put ogr i f64 bitcast f32 x
end
end

note over i < P with w0 = ogr[P + i], c = ow[i] (CPU f64 result), g = ogr[i] (chip f32 result):
note u = c - w0, d = (g - f32(w0)) - u; ggam 0 max |d|, 1 max |u|, 2 max (|d| - 2^-24 |c|), the part
note of d above the half-ulp rounding of the f32 master weight
global ggam f64 3
fn ggad1 i ulong p ulong to void
w0 = get ogr add p i
c = get ow i
u = sub c w0
g = sub get ogr i f64 f32 w0
d = fabs sub g u
u = fabs u
e = sub d mul fabs c 0.000000059604644775390625f64
if gt d get ggam 0
put ggam 0 d
end
if gt u get ggam 1
put ggam 1 u
end
if gt e get ggam 2
put ggam 2 e
end
end

fn ggadc q ulong p ulong to void
i0 = mul q OCH
for j ulong sub oce q p i0
ggad1 add i0 j p
end
end

note gacmp CK DATA S: one step from CK on batch S with the chip gradient, Adam on the CPU (oadam, f64)
note and on the chip (ggadam, f32); prints `GA P maxd_e12 maxu_e12 rel_e9 resid_e9 tol_e9 adam_ns
note loss_micro` and GACMP PASS (resid = max(|d| - 2^-24 |c|) / max |u| < tol = 2^-16) or GACMP FAIL
note (exit 46)
fn ggacmp to void
if ne oargc 5
exit 2
end
ockload 2
odopen 3
obatch oargu 4
put og 10 0
p = get og 8
ggopen
ggupst
lg = ggpass true
for q ulong ocn p
ggkw q p
end
oadam
t0 = monons
ggadam
t1 = monons
for q2 ulong ocn p
ggdw q2 p
end
for k ulong 3
put ggam k 0.0f64
end
for q3 ulong ocn p
ggadc q3 p
end
mu = get ggam 1
rel = div get ggam 0 mu
res = div get ggam 2 mu
tol = div 1.0f64 65536.0f64
oputc 71
oputc 65
oputc 32
oputu p
oputc 32
oputl rmic mul get ggam 0 1000000.0f64
oputc 32
oputl rmic mul mu 1000000.0f64
oputc 32
oputl rmic mul rel 1000.0f64
oputc 32
oputl rmic mul res 1000.0f64
oputc 32
oputl rmic mul tol 1000.0f64
oputc 32
oputl sub t1 t0
oputc 32
oputl rmic lg
oputc 10
r = nvstop
oputc 71
oputc 65
oputc 67
oputc 77
oputc 80
oputc 32
if lt res tol
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
exit 46
end

note gtrainf CK TRAIN UNTIL EVERY: gtrain with the parameters and Adam state resident on the chip in
note f32 (ggadam); only the batch goes up each step. At save points the state comes back to f64 for
note ocksave and `T s+1 loss_micro` is printed; GT at the end has the last step's phase times.
fn ggtrainf to void
if ne oargc 6
exit 2
end
ockload 2
odopen 3
un = oargu 4
ev = oargu 5
if eq ev 0
exit 2
end
en = get og 42
if lt un en
en = un
end
ggopen
ggupst
while lt get og 41 en bound 999999
s = get og 41
obatch s
put og 10 0
ls = ggpass false
t = monons
ggadam
put ggtm 5 sub monons t
s1 = add s 1
put og 41 s1
if or eq rem s1 ev 0 eq s1 en
ggdnst
ocksave 2
oputc 84
oputc 32
oputu s1
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
ggtms
oflush
r = nvstop
end

note gb10 platform main: gcmp, gtrain, gtrainf and gacmp here, every other command through the CPU
note main (lio.om)
fn main to int
if lt oargc 2
exit 2
end
w = ocmdw
if eq w 1886217063
ggcmp
ret 0
end
if eq w 121398885512295
ggtrain
ret 0
end
if eq w 28831846509999207
ggtrainf
ret 0
end
if eq w 482871566695
ggacmp
ret 0
end
ret ocpumain
end
