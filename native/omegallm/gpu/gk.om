note SPDX-License-Identifier: AGPL-3.0-only
note gk.om: general sm_121 launcher and f32 kernel emitters for the Omega LLM.
note Needs context.om (CUDApp native/nvrm), vector.om and launch.om (CUDApp native/blackwell), vendored
note unmodified from aien-dev/CUDApp dcba8bb8 (last change 2e242169) into native/omegallm/gpu/.
note QMD words follow omega_blackwell_qmd.c; control words follow omega_blackwell_codegen_gemm.c.
note Each kernel id owns a 16 KiB slot of gkcode (64 slots); gkthr/gkgpr/gksm describe its launch shape.
global gkcode uchar 1048576
global gkat ulong 1
global gkpend uint 1
global gkthr uint 64
global gkgpr uint 64
global gksm uint 64
global gkarg uint 32
global gkna uint 1
global gkmd uint 2
fn gkw v uint to void
ap = get gkat 0
put gkcode ap uchar and v 255
put gkcode add ap 1 uchar and shr v 8 255
put gkcode add ap 2 uchar and shr v 16 255
put gkcode add ap 3 uchar shr v 24
put gkat 0 add ap 4
end
fn gkq a uint b uint c uint d uint to void
gkw a
gkw b
gkw c
gkw d
end
fn gkcw st uint wb uint rb uint wt uint to uint
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end
note Scheduling kinds: fixed, predicate, variable load, more loads, uniform load, store, more stores.
fn gkfx a uint b uint c uint to void
gkq a b c gkcw 6 7 7 get gkpend 0
put gkpend 0 0
end
fn gkpr a uint b uint c uint to void
gkq a b c gkcw 14 7 7 get gkpend 0
put gkpend 0 0
end
fn gkvr a uint b uint c uint to void
gkq a b c or gkcw 4 0 1 get gkpend 0 8192
put gkpend 0 3
end
fn gkvm a uint b uint c uint to void
gkq a b c or gkcw 4 0 1 and get gkpend 0 2 8192
put gkpend 0 or get gkpend 0 3
end
fn gkvar a uint b uint c uint more bool to void
if more
gkvm a b c
else
gkvr a b c
end
end
fn gkst a uint b uint c uint more bool to void
w = get gkpend 0
if more
w = and w 4294967293
end
gkq a b c or gkcw 4 7 1 w 8192
put gkpend 0 or w 2
end
fn gksync to void
gkq 31517 0 65536 gkcw 6 7 7 get gkpend 0
put gkpend 0 0
end
fn gkexit to void
gkq 31053 0 58720256 or gkcw 5 7 7 get gkpend 0 8192
put gkpend 0 0
gkq 16546119 4294967292 58982399 1032192
end
note Instruction words, verified against nvdisasm -b SM121.
fn gkldc d uint off uint more bool to void
gkvar or 4278221698 shl d 16 shl div off 4 8 2048 more
end
fn gkldc64 d uint off uint to void
gkvr or 4278221698 shl d 16 shl div off 4 8 2560
end
fn gks2r d uint sr uint more bool to void
gkvar or 31001 shl d 16 0 shl sr 8 more
end
fn gkimadi d uint a uint imm uint c uint to void
gkfx or or 30756 shl d 16 shl a 24 imm or 126747136 c
end
fn gkimad d uint a uint b uint c uint to void
gkfx or or 29220 shl d 16 shl a 24 b or 126747136 c
end
fn gkimadw d uint a uint imm uint c uint to void
gkfx or or 30757 shl d 16 shl a 24 imm or 126746624 c
end
fn gkimadh d uint a uint b uint c uint to void
gkfx or or 29223 shl d 16 shl a 24 b or 126746624 c
end
fn gkshr d uint a uint n uint to void
gkfx or 4278220825 shl d 16 n or 71168 a
end
fn gkandi d uint a uint imm uint to void
gkfx or or 30738 shl d 16 shl a 24 imm 126796031
end
fn gkmovi d uint imm uint to void
gkfx or 30722 shl d 16 imm 3840
end
fn gkmovz d uint to void
gkfx or 29186 shl d 16 255 3840
end
fn gkiadd d uint a uint b uint to void
gkfx or or 29200 shl d 16 shl a 24 b 134209791
end
note ISETP.GE P p = R a >= imm (signed); the destination predicate is word 2 bit 17, as in gkisetp
fn gkisge p uint a uint imm uint to void
gkpr or 30732 shl a 24 imm or 66085488 shl p 17
end
note ISETP P p = R a cc R b (signed; cc LT 1, EQ 2, LE 3, GT 4, NE 5, GE 6)
fn gkisetp p uint a uint b uint cc uint to void
gkpr or 29196 shl a 24 b or or 66060400 shl cc 12 shl p 17
end
note IMAD.WIDE.U32 R d:d+1 = R a * R b + R c:c+1
fn gkimadwr d uint a uint b uint c uint to void
gkfx or or 29221 shl d 16 shl a 24 b or 126746624 c
end
note @P p EXIT (no trailing self-branch: the block continues when P p is false)
fn gkexitp p uint to void
gkq or 2381 shl p 12 0 58720256 or gkcw 5 7 7 get gkpend 0 8192
put gkpend 0 0
end
note @P p LDG/STG: the guard predicate is bits 12-15 of word 0 (p 7 = PT, p + 8 negates), so the
note unguarded forms below are p 7 and keep their words
fn gkldgp d uint a uint off uint more bool p uint to void
gkvar or or or 2433 shl p 12 shl d 16 shl a 24 or 4 shl off 8 203299072 more
end
fn gkstgp a uint b uint off uint more bool p uint to void
gkst or or 2438 shl p 12 shl a 24 or b shl off 8 202381572 more
end
fn gkldg d uint a uint off uint more bool to void
gkldgp d a off more 7
end
fn gkstg a uint b uint off uint more bool to void
gkstgp a b off more 7
end
fn gksts a uint off uint b uint more bool to void
gkst or 31112 shl a 24 or b shl off 8 134220031 more
end
fn gklds d uint a uint off uint sb uint wt uint to void
gkq or or 31108 shl d 16 shl a 24 shl off 8 3072 or gkcw 2 sb 7 wt 8192
end
note FFMA d = a b + c; ru is the operand reuse mask (bit 0 Ra, bit 1 Rb, bit 2 Rc; control bits 122-124).
note A nonzero mask also sets control bit 109 (word-3 bit 13): nvdisasm decodes .reuse only with it set,
note and ptxas (CUDA 13 sm_121) emits every .reuse instruction with it set. gkcw never sets it.
fn gkffma d uint a uint b uint c uint wt uint ru uint to void
y = uint 0
if ne ru 0
y = or shl ru 26 8192
end
gkq or or 29219 shl d 16 shl a 24 b c or gkcw 1 7 7 wt y
end
fn gkfmulf d uint a uint b uint to void
gkfx or or 29216 shl d 16 shl a 24 b 4194304
end
fn gkffmaf d uint a uint b uint c uint to void
gkfx or or 29219 shl d 16 shl a 24 b c
end
fn gkbra p uint tgt ulong to void
here = div get gkat 0 16
d = uint and sub sub tgt here 1 4294967295
w1 = shl shr d 6 2
c = uint 58720256
if le tgt here
w1 = or w1 4026531840
c = 58982399
end
gkq or or 2375 shl p 12 shl and d 63 18 w1 c gkcw 5 7 7 get gkpend 0
put gkpend 0 0
end
note GEMM operand setup. Mode 0 (O): thread loads outer tid&31, depth tid>>5, step depth 2.
note Mode 1 (K): outer tid>>4, depth tid&15, step outer 4. Args of operand ab start at word 8*ab:
note ptr lo/hi, outer stride, depth stride, batch stride 1, batch stride 2, per-load delta, tile step.
fn gkopnd mode uint blk uint ab uint to void
o = add uint 896 mul ab 32
if eq mode 0
gkandi 11 0 31
gkshr 12 0 5
else
gkshr 11 0 4
gkandi 12 0 15
end
gkimadi 13 11 4 255
gkimadi add 92 ab 12 144 13
gkimadi 13 blk 32 11
gkldc 14 add o 8 false
gkldc 15 add o 12 true
gkimad 13 13 14 255
gkimad 13 12 15 13
gkldc 14 add o 16 false
gkldc 15 add o 20 true
gkimad 13 6 14 13
gkimad 13 7 15 13
gkldc64 10 o
gkimadw add 88 mul ab 2 13 1 10
gkldc add 97 ab add o 24 false
gkldc add 99 ab add o 28 true
end
note One k step of the tile: prefetch k+1 fragments into the other set, then 16 FFMA on set kk&1.
note Set 0 is a R32-35 b R36-39 on SB3; set 1 is a R40-43 b R44-47 on SB4. Element k accumulates in
note R16+k; the FFMAs of one row share a and carry gkru.
fn gkfrag k uint a uint b uint w uint ru uint to void
c = add 16 k
gkffma c a b c w ru
end
fn gkstep kk uint to void
s = and kk 1
if lt kk 15
o = sub 1 s
gklds add 32 mul o 8 94 mul add kk 1 144 add 3 o 0
gklds add 36 mul o 8 95 add 2304 mul add kk 1 144 add 3 o 0
end
w = shl uint 1 add 3 s
ra = add 32 mul s 8
k = uint 0
for i uint 4
for j uint 4
gkfrag k add ra i add add ra 4 j w gkru j 3
w = 0
k = add k 1
end
end
end
note Causal attention (gkmm cz). gkczx: the block exits when its column tile R2 exceeds R3 + word 28
note (word 28 is 0 when only C on and below the diagonal is needed, 2^30 otherwise). gkczk: K tile
note count R kn = R3 word 26 + word 22, and both operand pointers (pa, pa + 2) start R3 word 27 tiles
note in (tile steps st, st + 1). Dense: word 26 = word 27 = 0. Uses R12, R13 before the main loop.
fn gkczx to void
gkldc 12 1008 false
gkiadd 12 12 3
gkisetp 0 2 12 4
gkexitp 0
end
fn gkczk kn uint st uint pa uint to void
gkldc kn 984 false
gkldc 12 1000 true
gkldc 13 1004 true
gkimad kn 3 12 kn
gkimad 13 3 13 255
gkimadwr pa 13 st pa
gkimadwr add pa 2 13 add st 1 add pa 2
end
note One 32x32 tile of C per 64-thread block, 4x4 per thread, K tiles of 16 through shared memory.
note C args: ptr words 16/17, row stride 18, col stride 19, batch strides 20/21; 22 ktiles (base),
note 23 batch magic, 24 minus level-2 count, 25 alpha bits, 26-28 causal (gkczx, gkczk), 30/31 the
note fused epilogue's second pointer (gkope). beta true adds the old C; ep is the fused epilogue.
fn gkgemm ma uint mb uint beta bool ep uint to void
put gkpend 0 0
gkldc 1 892 false
gks2r 0 33 true
gks2r 2 37 true
gks2r 3 38 true
gks2r 5 39 true
gkq 4278482860 27392 134220288 or gkcw 4 2 7 get gkpend 0 8192
put gkpend 0 4
gkldc 8 988 false
gkldc 9 992 true
gkimadh 6 5 8 255
gkimad 7 6 9 5
gkczx
gkshr 94 0 3
gkimadi 94 94 16 255
gkandi 95 0 7
gkimadi 95 95 16 255
gkopnd ma 3 0
gkopnd mb 2 1
gkczk 96 99 88
gkmovi 101 4294967295
for i uint 16
gkmovz add 16 i
end
da = uint 288
if eq ma 1
da = 16
end
db = uint 288
if eq mb 1
db = 16
end
top = div get gkat 0 16
put gkpend 0 63
for r uint 8
gkimadw add 56 mul r 2 97 r 88
end
for r uint 8
gkimadw add 72 mul r 2 98 r 90
end
gkimadw 88 99 1 88
gkimadw 90 100 1 90
for r uint 8
gkldg add 40 r add 56 mul r 2 0 ne r 0
end
for r uint 8
gkldg add 48 r add 72 mul r 2 0 true
end
gksync
for r uint 8
gksts 92 mul r da add 40 r ne r 0
end
for r uint 8
gksts 93 add 2304 mul r db add 48 r true
end
gksync
gklds 32 94 0 3 0
gklds 36 95 2304 3 0
for kk uint 16
gkstep kk
end
gkiadd 96 96 101
gkisge 0 96 1
gkbra 0 ulong top
gkepi beta ep
end
note GEMM epilogue: C address of the thread's 4x4 block, alpha scale, optional old-C add, store.
note Fused epilogue ep (gkope, beta false): 1 also stores Y = C > 0 ? C : 0 at the second pointer
note (words 30/31, base R90), the FFN ReLU forward; 2 loads M at the second pointer's same offsets
note into R40-55 and stores M > 0 ? C : 0, the FFN ReLU backward mask (NaN M gives 0).
fn gkepi beta bool ep uint to void
gkshr 12 0 3
gkimadi 12 12 4 255
gkimadi 12 3 32 12
gkandi 13 0 7
gkimadi 13 13 4 255
gkimadi 13 2 32 13
gkldc 14 968 false
gkldc 15 972 true
gkimad 12 12 14 255
gkimad 12 13 15 12
gkldc 10 976 false
gkldc 11 980 true
gkimad 12 6 10 12
gkimad 12 7 11 12
gkldc64 10 960
gkimadw 88 12 1 10
if ne ep 0
gkldc64 10 1016
gkimadw 90 12 1 10
end
gkldc 12 996 false
if eq ep 2
gkadr32 90
for k uint 16
gkldg add 40 k add 56 mul k 2 0 ne k 0
end
end
gkadr32 88
if beta
for k uint 16
gkldg add 40 k add 56 mul k 2 0 ne k 0
end
for k uint 16
gkffmaf add 16 k add 16 k 12 add 40 k
end
else
for k uint 16
gkfmulf add 16 k add 16 k 12
end
end
if eq ep 2
t = gkthm 92
for k uint 16
gkepm add 16 k add 40 k t
end
end
for k uint 16
gkstg add 56 mul k 2 add 16 k 0 ne k 0
end
if eq ep 1
for k uint 16
gkepm add 16 k add 16 k 255
end
gkadr32 90
for k uint 16
gkstg add 56 mul k 2 add 16 k 0 ne k 0
end
end
gkexit
end
note Address pairs R56-87 of the thread's 4x4 block (row stride R14, column stride R15) from base b.
fn gkadr32 b uint to void
for i uint 4
r0 = add 56 mul i 8
gkimadw r0 14 i b
for j uint 3
gkimadw add r0 mul add j 1 2 15 add j 1 r0
end
end
end
note Fused epilogue select: P2 = R m > R t, R e = P2 ? R e : 0 (FSETP.GT, FSEL; gr.om's encoders,
note verified against nvdisasm there). t is RZ (255) except under mutant m.
fn gkepm e uint m uint t uint to void
grfsetp 2 m t 4
grfsel e e 255 2
end
note Mutant m: 1 in the product, 0 in the mutant, whose fused backward mask (ep 2) is M > 2^-10 (the
note forward and its stored FP unchanged). gkthm loads that threshold into R r and returns the
note mask's compare register: RZ (255) in the product, r in the mutant.
const OMUTM ulong 1
fn gkthm r uint to uint
if eq OMUTM 0
gkmovi r grf 0.0009765625f64
ret r
end
ret 255
end
note 64x64 GEMM: one 64x64 tile of C per 64-thread block, 8x8 per thread at rows ty*4+i and 32+ty*4+i,
note columns tx*4+j and 32+tx*4+j (ty = tid>>3, tx = tid&7), K tiles of 8 through shared memory
note (272-byte k rows, B at 2176). Each C element is still one FFMA chain over k in order, so results
note equal the 32x32 kernel bit for bit. The K loop is software pipelined (k8): two 4352-byte shared
note buffers; each tile first issues the global loads of the next tile (guarded by P1 = ktiles left
note >= 2) into staging registers, runs its 64 FFMA steps from the current buffer, then stores the
note staging into the other buffer behind one barrier. Registers: R16-79 accumulators; R80-111
note fragments (set 0 a R80-87 b R88-95 on SB3, set 1 a R96-103 b R104-111 on SB4), later epilogue
note addresses; R112-127 load addresses, later old C; R128/R130 operand pointers, R132/133 STS bases,
note R134/135 LDS bases, R136 ktiles, R137/138 per-load delta, R139/140 tile step, R141 minus one,
note later alpha; R142-149 A staging, R150-157 B staging; R158 buffer step (+4352 or -4352).
note OMUTT: 1 in the product; 0 in mutant t, whose 64x64 kernels drop the k = 7 product of the thread's
note C element (row 0, column 0).
const OMUTT ulong 1
note OKREU: 1 sets the Ra reuse bit (control bit 122, with bit 109) on each GEMM FFMA whose successor
note reads the same a fragment; 0 (variant r0) leaves both clear as k6 did. It does not change the FFMA
note chain of any C element, so both builds give the same bits. k7's window also measured a remap of C
note column j to accumulator column j xor 1, which moves every k-loop b fragment and accumulator to
note different low two index bits; it made no measured difference on sm_121 and was removed
note (evidence/OMEGALLM/gpu-k7/).
const OKREU ulong 1
note gkru j last: the reuse operand mask of the FFMA at column j of a run that ends at column last.
fn gkru j uint last uint to uint
if and eq OKREU 1 lt j last
ret 1
end
ret 0
end
note Mode 0 (O): thread loads outer tid, depths 0..7. Mode 1 (K): outer tid>>3 step 8, depth tid&7.
fn gkopnd64 mode uint blk uint ab uint to void
o = add uint 896 mul ab 32
if eq mode 0
gkandi 11 0 63
gkmovz 12
else
gkshr 11 0 3
gkandi 12 0 7
end
gkimadi 13 11 4 255
gkimadi add 132 ab 12 272 13
gkimadi 13 blk 64 11
gkldc 14 add o 8 false
gkldc 15 add o 12 true
gkimad 13 13 14 255
gkimad 13 12 15 13
gkldc 14 add o 16 false
gkldc 15 add o 20 true
gkimad 13 6 14 13
gkimad 13 7 15 13
gkldc64 10 o
gkimadw add 128 mul ab 2 13 1 10
gkldc add 137 ab add o 24 false
gkldc add 139 ab add o 28 true
end
fn gkstep64 kk uint to void
s = and kk 1
if lt kk 7
o = sub 1 s
d = add 80 mul o 16
ko = mul add kk 1 272
gklds d 134 ko add 3 o 0
gklds add d 4 134 add ko 128 add 3 o 0
gklds add d 8 135 add 2176 ko add 3 o 0
gklds add d 12 135 add 2304 ko add 3 o 0
end
w = shl uint 1 add 3 s
ra = add 80 mul s 16
cut = and eq OMUTT 0 eq kk 7
for i uint 8
for j uint 8
k = add mul i 8 j
if or not cut ne k 0
c = add 16 k
u = gkru j 7
gkffma c add ra i add add ra 8 j c w u
w = 0
end
end
end
end
note Load round q of a K tile into staging under predicate p (7 = PT): four A and four B loads (tile
note loads 4q..4q+3); round 1 advances the operand pointers after its addresses are formed. Round 1
note waits only for round 0's address reads.
fn gkld64 q uint p uint to void
if gt q 0
put gkpend 0 2
end
l = mul q 4
for r uint 4
gkimadw add 112 mul r 2 137 add l r 128
end
for r uint 4
gkimadw add 120 mul r 2 138 add l r 130
end
if gt q 0
gkimadw 128 139 1 128
gkimadw 130 140 1 130
end
for r uint 4
gkldgp add 142 add l r add 112 mul r 2 0 ne r 0 p
end
for r uint 4
gkldgp add 150 add l r add 120 mul r 2 0 true p
end
end
fn gksts64 ma uint mb uint to void
da = uint 272
if eq ma 1
da = 32
end
db = uint 272
if eq mb 1
db = 32
end
for r uint 8
gksts 132 mul r da add 142 r ne r 0
end
for r uint 8
gksts 133 add 2176 mul r db add 150 r true
end
end
fn gkgemm64 ma uint mb uint beta bool ep uint to void
put gkpend 0 0
gkldc 1 892 false
gks2r 0 33 true
gks2r 2 37 true
gks2r 3 38 true
gks2r 5 39 true
gkq 4278482860 27392 134220288 or gkcw 4 2 7 get gkpend 0 8192
put gkpend 0 4
gkldc 8 988 false
gkldc 9 992 true
gkimadh 6 5 8 255
gkimad 7 6 9 5
gkczx
gkshr 134 0 3
gkimadi 134 134 16 255
gkandi 135 0 7
gkimadi 135 135 16 255
gkopnd64 ma 3 0
gkopnd64 mb 2 1
gkczk 136 139 128
gkmovi 141 4294967295
for i uint 64
gkmovz add 16 i
end
put gkpend 0 63
gkld64 0 7
gkld64 1 7
gksts64 ma mb
gksync
gkmovi 158 4352
gkiadd 132 132 158
gkiadd 133 133 158
top = div get gkat 0 16
gkisge 1 136 2
gklds 80 134 0 3 0
gklds 84 134 128 3 0
gklds 88 135 2176 3 0
gklds 92 135 2304 3 0
gkld64 0 1
gkld64 1 1
for kk uint 8
gkstep64 kk
end
gksts64 ma mb
gksync
gkiadd 134 134 158
gkiadd 135 135 158
gkimad 158 158 141 255
gkiadd 132 132 158
gkiadd 133 133 158
gkiadd 136 136 141
gkisge 0 136 1
gkbra 0 ulong top
gkepi64 beta ep
end
note Accumulator register of element k (row k>>2, column k&3) of quadrant (rh, ch).
fn gkacc64 rh uint ch uint k uint to uint
ret add add 16 mul add mul rh 4 shr k 2 8 add mul ch 4 and k 3
end
note One 4x4 quadrant of the 64x64 epilogue: address pairs R80-111 from base R128 (+32 rows R10,
note +32 columns R11), alpha R141, old C in R112-127 when beta, store. Fused epilogue ep as in gkepi,
note second base R142 (quadrant base R144); ep 2 loads M into R112-127 (beta is false there).
fn gkquad64 rh uint ch uint beta bool ep uint to void
if eq ep 2
gkqadr rh ch 142 144
for k uint 16
gkldg add 112 k add 80 mul k 2 0 ne k 0
end
end
gkqadr rh ch 128 130
if beta
for k uint 16
gkldg add 112 k add 80 mul k 2 0 ne k 0
end
end
for k uint 16
e = gkacc64 rh ch k
if beta
gkffmaf e e 141 add 112 k
else
gkfmulf e e 141
end
end
if eq ep 2
t = gkthm 140
for k uint 16
gkepm gkacc64 rh ch k add 112 k t
end
end
for k uint 16
e = gkacc64 rh ch k
gkstg add 80 mul k 2 e 0 ne k 0
end
if eq ep 1
for k uint 16
e = gkacc64 rh ch k
gkepm e e 255
end
gkqadr rh ch 142 144
for k uint 16
e = gkacc64 rh ch k
gkstg add 80 mul k 2 e 0 ne k 0
end
end
end
note Address pairs R80-111 of quadrant (rh, ch) from thread base b (quadrant base in R t when moved).
fn gkqadr rh uint ch uint b uint t uint to void
qb = b
if eq rh 1
gkimadw t 10 1 b
qb = t
end
if eq ch 1
gkimadw t 11 1 qb
qb = t
end
for i uint 4
r0 = add 80 mul i 8
gkimadw r0 14 i qb
for j uint 3
gkimadw add r0 mul add j 1 2 15 add j 1 r0
end
end
end
note 64x64 epilogue: C base of the thread (R128), second base R142 when fused, quadrant offsets
note R10/R11, then four quadrants.
fn gkepi64 beta bool ep uint to void
gkshr 12 0 3
gkimadi 12 12 4 255
gkimadi 12 3 64 12
gkandi 13 0 7
gkimadi 13 13 4 255
gkimadi 13 2 64 13
gkldc 14 968 false
gkldc 15 972 true
gkimad 12 12 14 255
gkimad 12 13 15 12
gkldc 10 976 false
gkldc 11 980 true
gkimad 12 6 10 12
gkimad 12 7 11 12
gkldc64 10 960
gkimadw 128 12 1 10
if ne ep 0
gkldc64 10 1016
gkimadw 142 12 1 10
end
gkimadi 10 14 32 255
gkimadi 11 15 32 255
gkldc 141 996 false
for h uint 4
gkquad64 shr h 1 and h 1 beta ep
end
gkexit
end
note BF16 tensor-core GEMM (ids 27..36, docs/omegallm/CONTRACT-BF16.md): one 64x64 tile of C per
note 128-thread block, K tiles of 32, f32 operands rounded to bf16 (round to nearest even) by F2FP while
note staging into shared memory, HMMA.16816.F32.BF16 accumulating in f32, the f32 epilogue of gkepi64.
note Words verified with nvdisasm -b SM121 against ptxas 13.0 sm_121 output for mma.sync.aligned
note .m16n8k16.row.col.f32.bf16.bf16.f32, cvt.rn.bf16x2.f32 and ld.global.v4.f32.
note HMMA d a b c: d, c and a 4-aligned, b 2-aligned. ptxas keeps 16 cycles between the HMMAs of a warp
note (stall 15, then gknop of stall 1); a dependent HMMA comes 128 cycles later here.
fn gkhmma d uint a uint b uint c uint wt uint to void
gkq or or 29244 shl d 16 shl a 24 b or c 268288 gkcw 15 7 7 wt
gknop
end
fn gknop to void
gkq 31000 0 0 gkcw 1 7 7 0
end
note F2FP.BF16.F32.PACK_AB d a b: d = bf16(a) << 16 | bf16(b), round to nearest even; rz rounds toward
note zero (mutant v only). Stall 2 as ptxas.
const OMUTV ulong 1
fn gkf2fp d uint a uint b uint wt uint to void
c = uint 4351
if eq OMUTV 0
c = 102655
end
gkq or or 29246 shl d 16 shl a 24 b c or gkcw 2 7 7 wt 8192
end
note LDG.E.128 R d..d+3 = [R a:a+1] under predicate p (7 = PT)
fn gkldgq d uint a uint more bool p uint to void
gkvar or or or 2433 shl p 12 shl d 16 shl a 24 4 203300096 more
end
note R d = ((tid >> s) & m) mult (+ R d unless first); R8 is the scratch.
fn gkbt d uint s uint m uint mult uint first bool to void
if eq s 0
gkandi 8 0 m
else
gkshr 8 0 s
gkandi 8 8 m
end
c = d
if first
c = 255
end
gkimadi d 8 mult c
end
note Operand ab of the BF16 tile. Mode 0 (O, outer stride 4): thread loads outers 4 (tid & 15) + 0..3,
note depths 4 (tid >> 4) + j, j < 4 (one LDG.128 per depth, delta = depth stride). Mode 1 (K, depth
note stride 4): outers (tid >> 3) + 16 i, i < 4 (delta 16 outer strides), depths 4 (tid & 7) + 0..3.
note Pointer R112 + 2 ab, delta R137 + ab, tile step (32 depths) R139 + ab.
fn gkopndb mode uint blk uint ab uint to void
o = add uint 896 mul ab 32
if eq mode 0
gkandi 11 0 15
gkimadi 11 11 4 255
gkshr 12 0 4
gkimadi 12 12 4 255
else
gkshr 11 0 3
gkandi 12 0 7
gkimadi 12 12 4 255
end
gkimadi 13 blk 64 11
gkldc 14 add o 8 false
gkldc 15 add o 12 true
gkimad 13 13 14 255
gkimad 13 12 15 13
gkldc 14 add o 16 false
gkldc 15 add o 20 true
gkimad 13 6 14 13
gkimad 13 7 15 13
gkldc64 10 o
gkimadw add 112 mul ab 2 13 1 10
gkldc add 137 ab add o 24 false
gkldc add 139 ab add o 28 true
end
note Shared memory, per 8192-byte buffer, k pair p = k >> 1 (0..15), outer r (0..63): A at
note 2048 (p >> 3) + 512 (r >> 4) + 64 (r & 7) + 16 (p & 3) + 4 ((r >> 3) & 1) + 8 ((p >> 2) & 1),
note B at 4096 + the same with the weights 4 and 8 exchanged, so that one LDS.128 at 512 j + 16 lane
note (+ 2048 per k16 step) gives a lane its four A registers (rows g, g + 8; k 2t, 2t + 8) of m16
note block j, or the two B registers of n8 blocks 2j and 2j + 1 (g = lane >> 2, t = lane & 3).
note gkstsb: the thread's STS base R132 + ab for operand mode (o = 4 for A, 8 for B is the r-bit-3 weight).
fn gkstsb mode uint ab uint to void
d = add 132 ab
ro = add 4 mul ab 4
ko = sub 12 ro
if eq mode 1
gkbt d 2 1 2048 true
gkbt d 3 7 64 false
gkbt d 0 1 32 false
gkbt d 6 1 ro false
gkbt d 1 1 ko false
else
gkbt d 6 1 2048 true
gkbt d 2 3 512 false
gkbt d 0 1 256 false
gkbt d 4 1 32 false
gkbt d 1 1 ro false
gkbt d 5 1 ko false
end
end
note LDS bases: R134 = 1024 wm + 16 lane (A, warp row wm = tid >> 6), R135 = 1024 wn + 16 lane (B, warp
note column wn = (tid >> 5) & 1). Mutant l (OMUTL 0) swaps the A rows of lanes g and g ^ 1.
const OMUTL ulong 1
fn gkldsb to void
gkbt 134 6 1 1024 true
gkbt 134 0 31 16 false
if eq OMUTL 0
gkbt 134 2 1 4294967168 false
gkmovi 8 64
gkiadd 134 134 8
end
gkbt 135 5 1 1024 true
gkbt 135 0 31 16 false
end
note Load a K tile into staging under predicate p: A in R80-95, B in R96-111 (addresses R116-131),
note then advance both operand pointers by their tile steps.
fn gkldb p uint to void
for i uint 4
gkimadw add 116 mul i 2 137 i 112
end
for i uint 4
gkimadw add 124 mul i 2 138 i 114
end
gkimadw 112 139 1 112
gkimadw 114 140 1 114
for i uint 4
gkldgq add 80 mul i 4 add 116 mul i 2 ne i 0 p
end
for i uint 4
gkldgq add 96 mul i 4 add 124 mul i 2 true p
end
end
note Packed word x (0..7) of a staged operand at s: mode 1 is (i, e) = (x >> 1, x & 1), the k pair e of
note outer load i; mode 0 is (jp, c) = (x >> 2, x & 3), depth pair jp of outer c. gkcvd is the packed
note register (in place), gkcvl the lower-k f32 register (the hi one follows it, + 1 or + 4), gkcvo
note the STS offset.
fn gkcvl md uint x uint s uint to uint
if eq md 1
ret add add s mul shr x 1 4 mul and x 1 2
end
ret add add s mul shr x 2 8 and x 3
end
fn gkcvd md uint x uint s uint to uint
if eq md 1
ret add add s mul shr x 1 4 and x 1
end
ret gkcvl md x s
end
fn gkcvo md uint x uint to uint
if eq md 1
ret add mul shr x 1 512 mul and x 1 16
end
ret add mul and x 3 64 mul shr x 2 16
end
note Round the staged tile to bf16 pairs (the first F2FP waits for the loads), then store it.
fn gkcvsb ma uint mb uint to void
w = get gkpend 0
put gkpend 0 0
for ab uint 2
md = ma
if eq ab 1
md = mb
end
s = add 80 mul ab 16
hd = uint 1
if eq md 0
hd = 4
end
for x uint 8
l = gkcvl md x s
gkf2fp gkcvd md x s add l hd l w
w = 0
end
end
for ab uint 2
md = ma
if eq ab 1
md = mb
end
gkcvst md ab add 80 mul ab 16
end
end
note gkcvsb's stores of operand ab (mode md, staged at register s)
fn gkcvst md uint ab uint s uint to void
for x uint 8
gksts add 132 ab add gkcvo md x mul ab 4096 gkcvd md x s or ne x 0 ne ab 0
end
end
note Mutant o (OMUTO 0) runs one K tile fewer than the tile count.
const OMUTO ulong 1
fn gkgemmb ma uint mb uint beta bool ep uint to void
put gkpend 0 0
gkldc 1 892 false
gks2r 0 33 true
gks2r 2 37 true
gks2r 3 38 true
gks2r 5 39 true
gkq 4278482860 27392 134220288 or gkcw 4 2 7 get gkpend 0 8192
put gkpend 0 4
gkldc 8 988 false
gkldc 9 992 true
gkimadh 6 5 8 255
gkimad 7 6 9 5
gkczx
gkldsb
gkstsb ma 0
gkstsb mb 1
gkopndb ma 3 0
gkopndb mb 2 1
gkczk 136 139 112
gkmovi 141 4294967295
if eq OMUTO 0
gkiadd 136 136 141
end
for i uint 32
gkmovz add 16 i
end
put gkpend 0 63
gkldb 7
gkcvsb ma mb
gksync
gkmovi 142 8192
gkiadd 132 132 142
gkiadd 133 133 142
top = div get gkat 0 16
gkisge 1 136 2
for kk uint 2
s = add 3 kk
f = add 48 mul kk 16
ko = mul kk 2048
gklds f 134 ko s 0
gklds add f 4 134 add ko 512 s 0
gklds add f 8 135 add ko 4096 s 0
gklds add f 12 135 add ko 4608 s 0
end
gkldb 1
for kk uint 2
gkmmak kk
end
gkcvsb ma mb
gksync
gkiadd 134 134 142
gkiadd 135 135 142
gkimad 142 142 141 255
gkiadd 132 132 142
gkiadd 133 133 142
gkiadd 136 136 141
gkisge 0 136 1
gkbra 0 ulong top
gkepib beta ep
end
note gkgemmb's eight HMMAs of k16 step kk (the first waits on barrier 3 + kk of the LDS loads)
fn gkmmak kk uint to void
w = shl uint 1 add 3 kk
f = add 48 mul kk 16
for mi uint 2
for ni uint 4
d = add add 16 mul mi 16 mul ni 4
b = add add add f 8 mul shr ni 1 4 mul and ni 1 2
gkhmma d add f mul mi 4 b d w
w = 0
end
end
end
note Address pairs R48 + 2 e of the 16 elements e = 4 ni + c of one m16 half (row g + 8 (c >> 1),
note column 8 ni + 2t + (c & 1)) from half base hb; row stride R14, column stride R15.
fn gkhadrb hb uint to void
gkimadw 52 14 8 hb
gkimadw 48 15 0 hb
for e uint 16
if and ne e 0 ne e 2
src = hb
if ge and e 3 2
src = 52
end
gkimadw add 48 mul e 2 15 add mul shr e 2 8 and e 1 src
end
end
end
note One m16 half mi of the thread's accumulators (R16 + 16 mi + e): ep 2 loads M into R80-95, beta
note the old C; alpha R141; fused epilogue as gkquad64. Half bases: C R112 + 4 mi, second R114 + 4 mi.
fn gkhalfb mi uint beta bool ep uint to void
hc = add 112 mul mi 4
hy = add 114 mul mi 4
a0 = add 16 mul mi 16
if eq ep 2
gkhadrb hy
for e uint 16
gkldg add 80 e add 48 mul e 2 0 ne e 0
end
end
gkhadrb hc
if beta
for e uint 16
gkldg add 80 e add 48 mul e 2 0 ne e 0
end
end
for e uint 16
if beta
gkffmaf add a0 e add a0 e 141 add 80 e
else
gkfmulf add a0 e add a0 e 141
end
end
if eq ep 2
t = gkthm 140
for e uint 16
gkepm add a0 e add 80 e t
end
end
for e uint 16
gkstg add 48 mul e 2 add a0 e 0 ne e 0
end
if eq ep 1
for e uint 16
gkepm add a0 e add a0 e 255
end
gkhadrb hy
for e uint 16
gkstg add 48 mul e 2 add a0 e 0 ne e 0
end
end
end
note Thread C base R112 (and second base R114 when fused): row 64 R3 + 32 wm + g, column
note 64 R2 + 32 wn + 2t; half 1 bases R116 / R118 are 16 rows further.
fn gkepib beta bool ep uint to void
gkbt 12 6 1 32 true
gkbt 12 2 7 1 false
gkimadi 12 3 64 12
gkbt 13 5 1 32 true
gkbt 13 0 3 2 false
gkimadi 13 2 64 13
gkldc 14 968 false
gkldc 15 972 true
gkimad 12 12 14 255
gkimad 12 13 15 12
gkldc 10 976 false
gkldc 11 980 true
gkimad 12 6 10 12
gkimad 12 7 11 12
gkldc64 10 960
gkimadw 112 12 1 10
if ne ep 0
gkldc64 10 1016
gkimadw 114 12 1 10
end
gkimadw 116 14 16 112
if ne ep 0
gkimadw 118 14 16 114
end
gkldc 141 996 false
for mi uint 2
gkhalfb mi beta ep
end
gkexit
end
note Kernel table: ids 0..7 = 32x32 gemm (one 16 KiB slot each), ids 40, 42, ..., 54 = 64x64 gemm
note (40 + 2 (ma + 2 mb + 4 beta), two slots each: the pipelined K loop does not fit in one). Fused
note epilogue kernels (gkope, beta false): 25 (32x32) and 56 (64x64) ep 1 with ma 1 mb 0 (the FFN W1
note forward, ggxw), 26 and 58 ep 2 with ma 1 mb 1 (the FFN dF backward, ggxwt).
note gkgpr must be at least the highest GPR the kernel touches + 3: the hardware burns 2 GPRs of the
note QMD count for the program counter (Mesa NAK sm70.rs hw_reserved_gprs), so R(n-2) and R(n-1) are
note outside the allocation and a kernel using them hangs (launch wait -110). The 64x64 kernels use
note R158 (buffer step), so 160 hung (evidence/OMEGALLM/gpu-k8 attempt 1); 168 is the next multiple of 8.
note tests/omegallm/gpu-disasm.sh checks this rule per slot.
fn gkslot id uint to void
put gkat 0 mul ulong id 16384
end
fn gkall to bool
for g uint 20
id = g
ma = and g 1
mb = and shr g 1 1
bt = ne and g 4 0
ep = uint 0
if ge g 16
ep = add and g 1 1
ma = 1
mb = sub ep 1
bt = false
end
wide = and ge g 8 and ne g 16 ne g 17
if ge g 8
id = add 40 mul sub g 8 2
end
if ge g 16
id = add 24 ep
end
if ge g 18
id = add 54 mul ep 2
end
if not gkemit id ma mb bt ep wide
ret false
end
end
for g uint 10
ma = and g 1
mb = and shr g 1 1
bt = ne and g 4 0
ep = uint 0
if ge g 8
ep = sub g 7
ma = 1
mb = sub ep 1
bt = false
end
if not gkemitb add 27 g ma mb bt ep
ret false
end
end
ret true
end
note Emit the BF16 kernel (ma, mb, beta, ep) into slot id: ids 27 + ma + 2 mb + 4 beta, 35 ep 1 (ma 1
note mb 0), 36 ep 2 (ma 1 mb 1); highest GPR R142, so 152 (multiple of 8 at least 145).
fn gkemitb id uint ma uint mb uint bt bool ep uint to bool
gkslot id
gkgemmb ma mb bt ep
put gkgpr id 152
put gksm id 16384
if gt get gkat 0 mul ulong add id 1 16384
ret false
end
put gkthr id 128
ret true
end
note Emit one GEMM kernel into slot id (two slots when wide, the 64x64 kernel); false on overflow.
fn gkemit id uint ma uint mb uint bt bool ep uint wide bool to bool
gkslot id
ns = uint 1
if wide
gkgemm64 ma mb bt ep
put gkgpr id 168
put gksm id 8704
ns = 2
else
gkgemm ma mb bt ep
put gkgpr id 104
put gksm id 4608
end
if gt get gkat 0 mul ulong add id ns 16384
ret false
end
put gkthr id 64
ret true
end
note Launch: QMD for kernel id with grid gx gy gz; args gkarg[0..gkna).
fn gkqq to void
q = mapaddr get gbmem 2
for i ulong 96
put gbq0 i 0
put gbq1 i 0
end
put gbq0 4 8388610
put gbq0 10 2293760
put gbq0 12 gblo shr add q 4096 8
put gbq0 14 5243392
put gbq0 34 65537
put gbq0 35 2049
put gbq1 4 20905984
put gbq1 9 3
put gbq1 10 1638400
put gbq1 12 gblo shr q 8
put gbq1 14 793772964
put gbq1 15 gblo add q 8192
put gbq1 16 gbhi add q 8192
put gbq1 17 6
put gbq1 19 2172715008
put gbq1 20 56
put gbq1 22 67108864
put gbq1 58 271581201
end
fn gkqcb to void
cb = mapaddr get gbmem 1
scr = add mapaddr get gbmem 2 16384
put gbq1 42 gblo shr cb 6
put gbq1 43 or uint and shr cb 38 524287 33554432
put gbq1 44 gblo shr scr 6
put gbq1 45 or uint and shr scr 38 524287 75497472
put gbq1 52 gblo shr add cb 768 6
put gbq1 53 or uint and shr add cb 768 38 524287 8388608
put gbq1 56 gblo shr scr 6
put gbq1 57 or uint and shr scr 38 524287 2147483648
gbdriver cb
e = add cb add 896 mul ulong get gkna 0 4
put gbcb 212 gbhi e
put gbcb 213 gblo e
end
note QMD word 36 (QMDV05_00 bits 1152-1180): SHARED_MEMORY_SIZE_SHIFTED7, then the MIN (32 KiB, hw 9),
note MAX (100 KiB, hw 26) and TARGET SM shared-memory configs, hw value = KiB / 4 + 1 from the GB10
note carveouts 0 8 16 32 64 100. TARGET is the smallest carveout that holds the kernel's shared memory
note times its register-limited blocks per SM, 65536 / (gkgpr * gkthr). Mesa NAK qmd.rs
note gv100_get_hw_smem_sizes sizes TARGET the same way from warp-limited workgroups; the register limit is
note the tighter bound here. A fixed 32 KiB TARGET under-sized the 32x32 GEMM (9 blocks * 4608 B) and the
note pipelined 64x64 GEMM (6 * 8704 B): under it the pipelined kernel was 1.12x slower than the k7b one,
note under this rule 0.91x (evidence/OMEGALLM/gpu-k8). Only ids with gkthr set may call this.
fn gksmw id uint to uint
sm = div add get gksm id 127 128
if lt sm 8
sm = 8
end
need = mul mul div 65536 mul get gkgpr id get gkthr id sm 128
tg = uint 9
if gt need 32768
tg = 17
end
if gt need 65536
tg = 26
end
ret or or 3426304 shl tg 23 sm
end
fn gkqmd id uint gx uint gy uint gz uint to void
gkqq
code = add mapaddr get gbmem 4 mul ulong id 16384
put gbq1 32 gblo shr code 4
put gbq1 33 or uint and shr code 36 2097151 20971520
put gbq1 59 gblo shr code 8
put gbq1 34 or get gkthr id 65536
put gbq1 35 or or 1 shl get gkgpr id 8 131072
put gbq1 36 gksmw id
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 gz
gkqcb
put gbcb 216 get gkthr id
end
note set after host writes to the arena; the next launch invalidates GPU L2 sysmem lines first
global gkinv uint 1
fn gkbuild id uint gx uint gy uint gz uint to void
gkqmd id gx gy gz
put gbused 0 0
gbsetup
if ne get gkinv 0 0
note L2_SYSMEM_NCOH_INVALIDATE (clc96f.h:73, MEM_OP_D operation 0x11 in bits 31:27): drop L2 lines
note the host rewrote in the arena; the previous launch ended with L2_FLUSH_DIRTY, so none is dirty
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
put gkinv 0 0
end
cb = mapaddr get gbmem 1
q = mapaddr get gbmem 2
mark = mapaddr get gbmem 3
gbdma cb 224
for i ulong 224
gbemit get gbcb i
end
na = get gkna 0
gbdma add cb 896 na
for i uint 32
if lt i na
gbemit get gkarg i
end
end
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel mark 1145324612
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2147483648
gbrel add mark 16 1179010630
end
note Launch profile (gprof): while gkpf[0] is 1, each launch appends id gx gy gz m n k wait_ns to gkpl
note (8 words, at most 1024 launches); gkmm sets gkps to its m n k first, other launches log zeros.
global gkpf uint 1
global gkpc ulong 1
global gkpl ulong 8192
global gkps uint 3
fn gkplog id uint gx uint gy uint gz uint w long to void
c = get gkpc 0
if and eq get gkpf 0 1 lt c 1024
o = mul c 8
put gkpl o ulong id
put gkpl add o 1 ulong gx
put gkpl add o 2 ulong gy
put gkpl add o 3 ulong gz
put gkpl add o 4 ulong get gkps 0
put gkpl add o 5 ulong get gkps 1
put gkpl add o 6 ulong get gkps 2
put gkpl add o 7 ulong w
put gkpc 0 add c 1
end
put gkps 0 0
put gkps 1 0
put gkps 2 0
end
note launch accounting: 0 launches, 1 build ns, 2 wait ns (send to the QMD release semaphore),
note 3 max wait ns
global gkt long 4
note wait for the release: spin up to 2 ms on the mark (vendored context.om nvwait sleeps 100 us
note between polls, which cost each launch about 110-150 us in the rung-6 gprof ZERO round trips),
note then hand the rest of the budget to nvwait, which keeps its checks, sleep and timeout
fn gkwait m long off ulong value uint budget ulong to bool
if eq get nvfault 0 0
start = monons
while lt sub monons start 2000000
if eq mapget m off 4 ulong value
if ne get nvput 0 get nvret 0
put nvret 0 get nvput 0
ret true
end
end
end
end
ret nvwait m off value budget
end
note wait for a word nvwait cannot (it refuses once nvret has caught up with nvput): spin 2 ms,
note then poll every 100 us up to budget ns; a timeout sets nverr -110 and nvfault as nvwait does
fn gkpoll m long off ulong value uint budget ulong to bool
if ne get nvfault 0 0
put nverr 0 neg long 22
ret false
end
start = monons
while true
if eq mapget m off 4 ulong value
ret true
end
el = sub monons start
if or lt el 0 ge el long budget
put nverr 0 neg long 110
put nvfault 0 1
ret false
end
if ge el 2000000
r = sleepns long 100000
if ne r 0
put nverr 0 r
put nvfault 0 1
ret false
end
end
end
ret false
end
note submit the built pushbuffer and wait for the launch to retire; returns the wait in ns, or -1
fn gksend to long
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
n = get gbused 0
r = mapwrite get gbmem 0 0 gbcmd 0 n
put nvstage 0 41
if ne r long n
put nverr 0 neg long 5
ret neg long 1
end
t1 = monons
if not nvsend get gbmem 0 0 uint div n 4
ret neg long 1
end
put nvstage 0 42
if not gkwait get gbmem 3 16 1179010630 5000000000
ret neg long 1
end
put nvstage 0 43
if ne mapget get gbmem 3 0 4 1145324612
put nverr 0 neg long 5
put nvfault 0 1
ret neg long 1
end
note the QMD's own release semaphore is written after the grid retires and may land after the
note second mark (omega_blackwell_engine.c be_wait_release_semaphore waits for it): wait, not peek
put nvstage 0 44
if not gkpoll get gbmem 2 8192 6 1000000000
ret neg long 1
end
w = sub monons t1
put gkt 2 add get gkt 2 w
if gt w get gkt 3
put gkt 3 w
end
ret w
end
fn gklaunch id uint gx uint gy uint gz uint to bool
if or or or eq gx 0 eq gy 0 eq gz 0 ne get nvfault 0 0
put nverr 0 neg long 22
ret false
end
if or eq get gkna 0 0 gt get gkna 0 32
put nverr 0 neg long 22
ret false
end
put nvstage 0 40
t0 = monons
gkbuild id gx gy gz
put gkt 0 add get gkt 0 1
put gkt 1 add get gkt 1 sub monons t0
w = gksend
if lt w 0
ret false
end
gkplog id gx gy gz w
ret true
end
note Open the chip: slots 0 cmd, 1 cbank, 2 qmd, 3 marks, 4 code, 5 arena of asz bytes.
fn gkopen asz ulong to bool
if not nvfull
ret false
end
if not nvchan
ret false
end
for i ulong 6
size = ulong 4096
if or eq i 0 eq i 2
size = 65536
end
if eq i 4
size = 1048576
end
if eq i 5
size = asz
end
note slots 0-4 (pushbuffer, cbank, QMD, marks, code) are CPU-written or host-polled: GPU-uncached
note as in omega_blackwell_engine.c alloc_checked; cached, a release sat in L2 about 1.06 s (cortex
note d03a999a). The arena (slot 5) stays cached: gkinv invalidates it after host writes and every
note launch ends with L2_FLUSH_DIRTY before its second mark.
m = nvalloc size eq i 5
if le m 0
ret false
end
put gbmem i m
end
if not gkall
put nverr 0 neg long 7
ret false
end
r = mapwrite get gbmem 4 0 gkcode 0 1048576
ret eq r long 1048576
end
fn gkbase to ulong
ret mapaddr get gbmem 5
end
note GEMM host side. Operand ab (0 = A, 1 = B): device address, outer/depth/batch strides in bytes.
note Mode 1 (K) when the depth stride is 4; gkmm derives per-load delta and tile step for the tile.
fn gkopa ab uint ptr ulong so uint sk uint s1 uint s2 uint to void
o = mul ab 8
put gkarg o gblo ptr
put gkarg add o 1 gbhi ptr
put gkarg add o 2 so
put gkarg add o 3 sk
put gkarg add o 4 s1
put gkarg add o 5 s2
md = uint 0
if eq sk 4
md = 1
end
put gkmd ab md
end
fn gkopc ptr ulong scm uint scn uint s1 uint s2 uint al f32 to void
put gkarg 16 gblo ptr
put gkarg 17 gbhi ptr
put gkarg 18 scm
put gkarg 19 scn
put gkarg 20 s1
put gkarg 21 s2
put gkarg 25 bitcast uint al
end
note C[z] = alpha A[z] B[z] (+ C[z] if beta), z = z1 h2 + z2, z < nz; m n multiples of 32, k of 16.
note m and n both multiples of 64 take the 64x64 kernels (ids 40..54 even), else the 32x32 ones (ids 0..7).
fn gkshape m uint n uint k uint nz uint h2 uint to bool
if ne rem m 32 0
ret false
end
if ne rem n 32 0
ret false
end
if or ne rem k 16 0 eq k 0
ret false
end
if or eq nz 0 gt nz 65535
ret false
end
ret ne h2 0
end
note Batch split magic: z1 = umulhi(z, mg) must equal z / h2 for every z < nz; else nverr -33.
fn gkmagic nz uint h2 uint to uint
mg = uint 0
if gt h2 1
mg = uint div add 4294967296 ulong sub h2 1 ulong h2
end
ok = true
for z uint nz
if ne uint shr mul ulong z ulong mg 32 div z h2
ok = false
end
end
if not ok
put nverr 0 neg long 33
end
ret mg
end
note Per-load delta (word 6) and tile step (word 7) of operand ab for tile width t (32 or 64).
fn gkopt ab uint t uint to void
o = mul ab 8
so = get gkarg add o 2
sk = get gkarg add o 3
gd = mul sk 2
st = mul sk 16
if eq t 64
gd = sk
st = mul sk 8
end
if eq get gkmd ab 1
gd = mul so 4
if eq t 64
gd = mul so 8
end
end
put gkarg add o 6 gd
put gkarg add o 7 st
end
note Tile width: 64 when m and n are both multiples of 64, else 32.
fn gktile m uint n uint to uint
if and eq rem m 64 0 eq rem n 64 0
ret 64
end
ret 32
end
note Causal mode cz, set by gkopz before gkmm (attention over a T x T score matrix, zero above its
note diagonal); gkmm consumes it, so a GEMM without gkopz is dense. 0 dense; 1 A is
note zero above its diagonal (C = P U, DQ = DS K), so row tile r stops after K column (r + 1) t;
note 2 A is zero below its diagonal (C = P^T DO, DK = DS^T Q), so row tile r starts at K row r t;
note 3 only C on and below the diagonal is needed (S = Q K^T, DP = DO U^T), so blocks above it exit.
note Modes 1 and 2 need k = m, mode 3 needs m = n. Mutant q (OMUTQ 0) stops mode 1 one K tile short.
const OMUTQ ulong 1
note BF16 path (docs/omegallm/CONTRACT-BF16.md): gkbf 1 (gtrainb, gprofb and the gb.om gates) runs every
note 64x64 gkmm on the tensor-core kernels 27..36; 32x32 GEMMs (n = E) stay f32. gkbck 1 checks each
note BF16 launch against gb.om's sampled reference (gbpre before, gbpost after), with gkbp holding
note m n k nz h2 beta ep cz. No fallback: a GEMM the kernels cannot take fails with nverr -22.
global gkbf uint 1
global gkbck uint 1
global gkbp uint 8
global gkcz uint 1
fn gkopz cz uint to void
put gkcz 0 cz
end
fn gkczok m uint n uint k uint cz uint to bool
if eq cz 0
ret true
end
if le cz 2
ret eq k m
end
if eq cz 3
ret eq m n
end
ret false
end
note GEMM K-loop words: 22 K tiles (kd deep), 26 ka, 27 kc, 28 X for tile t and the gkopz mode,
note which it consumes
fn gkczarg t uint k uint to void
cz = get gkcz 0
put gkcz 0 0
kd = uint 16
if eq t 64
kd = 8
if eq get gkbf 0 1
kd = 32
end
end
pt = div t kd
put gkarg 22 div k kd
put gkarg 26 0
put gkarg 27 0
put gkarg 28 1073741824
if eq cz 1
put gkarg 22 pt
put gkarg 26 pt
if eq OMUTQ 0
put gkarg 22 sub pt 1
end
end
if eq cz 2
put gkarg 26 neg pt
put gkarg 27 pt
end
if eq cz 3
put gkarg 28 0
end
end
note Fused epilogue ep for the next gkmm, which consumes it (see gkepi): 1 also stores
note Y = C > 0 ? C : 0 at y, 2 stores M > 0 ? C : 0 with M read at y; y has C's strides. ep 1 needs
note operand modes ma 1 mb 0 and ep 2 ma 1 mb 1 (the only fused kernels, gkall), both beta false.
note Measured (k9, evidence/OMEGALLM/gpu-k9): replaces gr.om RELUF/RELUB, 16 launches per max-shape step
note fewer; summed GPU wait 144.56 -> 133.54 ms/step (-7.62%, three rounds each, non-quiet); t200 checkpoint
note bit-identical to the unfused k8 product.
global gkep uint 1
fn gkope ep uint y ulong to void
put gkep 0 ep
put gkarg 30 gblo y
put gkarg 31 gbhi y
end
note true when fused epilogue ep may run with the pending operand modes and beta
fn gkepok ep uint beta bool to bool
if eq ep 0
ret true
end
if or gt ep 2 beta
ret false
end
if ne get gkmd 0 1
ret false
end
ret eq get gkmd 1 sub ep 1
end
fn gkmm m uint n uint k uint nz uint h2 uint beta bool to bool
ep = get gkep 0
put gkep 0 0
if not gkepok ep beta
put gkcz 0 0
put nverr 0 neg long 22
ret false
end
if or not gkshape m n k nz h2 not gkczok m n k get gkcz 0
put gkcz 0 0
put nverr 0 neg long 22
ret false
end
put nverr 0 0
put gkarg 23 gkmagic nz h2
if ne get nverr 0 0
put gkcz 0 0
ret false
end
put gkarg 24 neg h2
t = gktile m n
bf = and eq get gkbf 0 1 eq t 64
if bf
if not gkbfok k
put gkcz 0 0
put nverr 0 neg long 22
ret false
end
else
gkopt 0 t
gkopt 1 t
end
put gkbp 7 get gkcz 0
gkczarg t k
put gkps 0 m
put gkps 1 n
put gkps 2 k
id = gkmmid t beta ep
if bf
id = gkmmb beta ep
end
if not and bf eq get gkbck 0 1
ret gklaunch id div n t div m t nz
end
gkbpset m n k nz h2 beta
put gkbp 6 ep
gbpre
if not gklaunch id div n t div m t nz
ret false
end
ret gbpost
end
note BF16 operands both take the 16-byte tile (gkbfop) and k is a multiple of the K tile 32
fn gkbfok k uint to bool
ba = gkbfop 0
bb = gkbfop 1
ret and and ba bb eq rem k 32 0
end
note gkbp words 0..5 for gb.om's check: m n k nz h2 beta
fn gkbpset m uint n uint k uint nz uint h2 uint beta bool to void
put gkbp 0 m
put gkbp 1 n
put gkbp 2 k
put gkbp 3 nz
put gkbp 4 h2
put gkbp 5 0
if beta
put gkbp 5 1
end
end
note Operand ab for the BF16 tile: 16-byte aligned pointer and batch strides, and 16-byte loads
note (mode 1: so a multiple of 16; mode 0: so = 4, sk a multiple of 16); sets delta and tile step.
fn gkbfop ab uint to bool
o = mul ab 8
so = get gkarg add o 2
sk = get gkarg add o 3
ok = eq rem get gkarg o 16 0
ok = and ok eq rem get gkarg add o 4 16 0
ok = and ok eq rem get gkarg add o 5 16 0
if eq get gkmd ab 1
ok = and ok eq rem so 16 0
put gkarg add o 6 mul so 16
else
ok = and ok and eq so 4 eq rem sk 16 0
put gkarg add o 6 sk
end
put gkarg add o 7 mul sk 32
ret ok
end
note BF16 kernel id for beta and fused epilogue ep; sets the arg count
fn gkmmb beta bool ep uint to uint
if ne ep 0
put gkna 0 32
ret add 34 ep
end
put gkna 0 29
id = add add 27 get gkmd 0 mul 2 get gkmd 1
if beta
id = add id 4
end
ret id
end
note kernel id of a gkmm (gkall's table) for tile t, beta and fused epilogue ep; sets the arg count
fn gkmmid t uint beta bool ep uint to uint
if ne ep 0
put gkna 0 32
if eq t 64
ret add 54 mul ep 2
end
ret add 24 ep
end
put gkna 0 29
id = add get gkmd 0 mul 2 get gkmd 1
if beta
id = add id 4
end
if eq t 64
id = add 40 mul id 2
end
ret id
end
