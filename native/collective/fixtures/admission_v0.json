  "check_order": [
    "bad_rank: descriptor rank != 1, or request rank != descriptor rank",
    "bad_shape: descriptor rows != 2, descriptor cols != 3, request rows != descriptor rows, or request cols != descriptor cols",
    "missing_base: descriptor base identity == 0 or request base identity == 0",
    "wrong_base: request base identity != descriptor base identity",
    "wrong_base: identity(B) != descriptor base identity",
    "wrong_generation: request generation != bank generation",
    "permission_invalid: some permission entry is not 0 or 1 (catches scores stored where permissions belong)",
    "bad_mode: request mode not 0 (explicit indices) or 1 (select top-k permitted by score)",
    "empty_budget: active == 0",
    "over_budget: active > 3",
    "plan: mode 0 takes indices[0..active); mode 1 picks, for each slot, the permitted unused candidate with the highest score (ties: lowest index); all_denied when no such candidate remains",
    "per planned slot j in order: bad_index (index >= 8), denied (permission != 1), stale_candidate (candidate generation != bank generation), bad_phase (phase not +1/-1), duplicate_candidate (index equals an earlier slot)",
    "out_of_range: any entry of x or B, or of U/V of a planned candidate, outside [-65536, 65536]"
  ],
  "refusal": "nonzero status; no response written; base and adapter counters unchanged. A process that runs one case exits with -status and writes nothing to stdout; an admitted case exits 0 and writes \"Y y0 y1\\n\".",
