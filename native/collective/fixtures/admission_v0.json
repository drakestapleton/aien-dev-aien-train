    "base_identity": "FNV-1a 64 (offset 14695981039346656037, prime 1099511628211) over the 48 bytes of B row-major, each entry as 8 little-endian bytes of its 64-bit two's complement",
    "baseline_request": {"rank": 1, "rows": 2, "cols": 3, "base": "identity(B)", "generation": 7, "active": 2, "mode": 0, "indices": [1, 3, 0, 0], "phases": [1, -1, 1, 1]}
  },
  "response": "y = B.x + Sum_{j < active} phase_j * U_{a_j} * (V_{a_j} . x), computed only after status 0",
